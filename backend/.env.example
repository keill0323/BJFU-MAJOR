# ============================================================
# 北林 CS2 Major 后端配置模板
# 使用方式：复制为 .env 后按环境修改
#   cp .env.example .env
# ============================================================

# ---------- 数据库 ----------
# 本地开发（SQLite，默认，无需安装）
# DATABASE_URL=sqlite:///./cs2_competition.db
# 生产（MySQL，需先在服务器建库）
# 建库：CREATE DATABASE cs2_competition CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL=mysql+pymysql://cs2_user:你的数据库密码@127.0.0.1:3306/cs2_competition?charset=utf8mb4

# ---------- 安全（生产必须修改）----------
# 生成随机密钥：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=请替换为随机长字符串
ADMIN_PASSWORD=请替换为强密码
DB_ECHO=False

# ---------- CORS ----------
# 生产填小程序/管理后台来源域名，逗号分隔；开发默认 * 全放行
CORS_ORIGINS=*

# ---------- 微信小程序登录 ----------
WX_APPID=你的小程序AppID
WX_SECRET=你的小程序AppSecret
# 开发用 mock 登录（任意 code 都行）；上线设 false 走真实微信登录
WX_MOCK_LOGIN=false

# ---------- 微信订阅提醒（模板由微信公众平台选用，字段必须与实际模板一致）----------
WX_SUBSCRIBE_ENABLED=false
WX_SUBSCRIBE_TEMPLATES='{}'
WX_SUBSCRIBE_ENV=formal
# 结构示例见 deploy.md。不要把 AppSecret 或 access_token 写入前端。

# ---------- 一对一文字聊天（验收通过后开放）----------
CHAT_ENABLED=false
CHAT_WRITE_ENABLED=false
CHAT_ALLOW_USERS=
CHAT_MODERATION_ENABLED=true
# 非 Docker 运行需显式指定独立持久目录，清理/撤回/隐藏前同步写入无正文清单。
CHAT_DELETION_LEDGER=

# 赛事助手独立开关：先完成文本模型tools协议/出站授权验收，再由维护者启用。
# 不复用识图API Key，不调用用户私聊，不上传图片/学号。
ASSISTANT_ENABLED=false
ASSISTANT_EXTERNAL_ENABLED=false
ASSISTANT_TOOL_MODEL_VERIFIED=false
ASSISTANT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ASSISTANT_MODEL=glm-5.3-flash
ASSISTANT_ENGINE=langchain
ASSISTANT_API_KEY=
ASSISTANT_TIMEOUT_SECONDS=60
ASSISTANT_MAX_STEPS=6
ASSISTANT_MAX_TOOL_CALLS=8

# 可选滚动语义摘要：每轮最多一次无工具调用，额外消耗同一文本模型额度。
# 当前为UTF-8字节预算，不是精确token计数；仍受总请求60秒/100000字节限制。
ASSISTANT_SUMMARY_ENABLED=false
ASSISTANT_SUMMARY_TRIGGER_BYTES=20000
ASSISTANT_SUMMARY_KEEP_TURNS=6
ASSISTANT_HISTORY_BUDGET_BYTES=50000
ASSISTANT_SUMMARY_MAX_BYTES=4000
ASSISTANT_SUMMARY_INPUT_MAX_BYTES=50000
ASSISTANT_SUMMARY_TIMEOUT_SECONDS=8
