<!-- 赛事详情页：赛事队伍 / 挑战者组 / 传奇组 / 淘汰赛 -->
<event-return />
<view class="page">
  <view wx:if="{{!match}}" class="empty">加载中...</view>

  <block wx:else>
    <!-- 赛事信息 -->
    <view class="card admin-hero">
      <text class="admin-kicker">BJFU / TOURNAMENT MANAGEMENT</text>
      <view class="detail-header">
        <text class="section-title">{{match.name}}</text>
        <view class="header-actions">
          <view class="btn-primary small-btn" bindtap="openRegistrationPanel">报名时间</view>
          <view class="btn-outline small-btn" bindtap="openWindowPanel">比赛排期范围</view>
          <view class="btn-outline small-btn" bindtap="exportAll">导出对阵</view>
        </view>
      </view>
      <text class="team-meta">{{match.statusText}} · {{teams.length}} / {{match.max_teams || '不限'}} 支队伍</text>
      <text class="team-meta registration-summary">报名时间（北京时间）<text class="registration-summary-value">{{registrationSummary}}</text></text>
      <view wx:if="{{rosterLocked}}" class="roster-lock-note">已分组，参赛名单已锁定</view>
    </view>

    <!-- 阶段 tab -->
    <view class="tabs">
      <view class="tab {{tab === 'teams' ? 'active' : ''}}" data-tab="teams" bindtap="switchTab">赛事队伍</view>
      <view class="tab {{tab === 'challenger' ? 'active' : ''}}" data-tab="challenger" bindtap="switchTab">挑战者组</view>
      <view class="tab {{tab === 'legend' ? 'active' : ''}}" data-tab="legend" bindtap="switchTab">传奇组</view>
      <view class="tab {{tab === 'knockout' ? 'active' : ''}}" data-tab="knockout" bindtap="switchTab">淘汰赛</view>
    </view>

    <!-- ===== 队伍 tab：统一赛事排名 ===== -->
    <view wx:if="{{tab === 'teams'}}" class="card standings-card">
      <text class="section-title">赛事队伍</text>
      <text class="section-caption">按阶段与名次展示，同名次并列。点击队伍查看分阶段战绩。</text>
      <view wx:if="{{rankingTeams.length === 0}}" class="empty">暂无队伍</view>
      <view wx:for="{{rankingTeams}}" wx:key="team_id" class="standing-row" bindtap="showTeam" data-id="{{item.team_id}}">
        <view class="standing-main">
          <text class="standing-rank {{item.rank_weight < 2 ? 'standing-medal' : ''}}">{{item.rank_badge}}</text>
          <view class="standing-copy">
            <text class="team-name">{{item.team_name}}</text>
            <text class="standing-group">{{item.group_text}}</text>
            <view class="standing-tags">
              <text class="tag {{item.rank_weight < 2 ? 'tag-orange' : item.rank_weight >= 8 ? 'tag-gray' : 'tag-blue'}}">{{item.stage_text}}</text>
              <text wx:if="{{item.progress_text}}" class="standing-progress">{{item.progress_text}}</text>
            </view>
          </view>
          <image class="standing-arrow" src="/images/icons/chevron-right.svg"/>
        </view>
          <view wx:if="{{item.registration_status === 'pending' && !rosterLocked}}" class="btn-primary small-btn ranking-approve" catchtap="approveTeamReg" data-id="{{item.team_id}}" data-name="{{item.team_name}}">通过报名</view>
      </view>
        <view wx:if="{{waitingTeams.length && !rosterLocked}}" class="btn-outline grouping-entry" bindtap="promptGroup">{{groupingBusy ? '正在分组…' : '分配种子并分组'}}</view>
    </view>

    <!-- ===== 挑战者组 tab ===== -->
    <view wx:if="{{tab === 'challenger'}}">
      <view class="card">
        <text class="section-title">挑战者组队伍</text>
        <view class="hint-bar">{{challengerFormatHint}}</view>
        <view wx:if="{{challengerTeams.length === 0}}" class="empty">暂无挑战者队伍</view>
        <view class="chip-wrap">
          <view wx:for="{{challengerTeams}}" wx:key="team_id" class="team-chip" bindtap="showTeam" data-id="{{item.team_id}}">
            <text class="chip-name">{{item.team_name}}</text>
            <text wx:if="{{item.group_name}}" class="tag tag-blue">{{item.group_name}}组</text>

          </view>
        </view>
        <view class="op-btns">
          <view class="btn-outline small-btn" bindtap="promptGroup">{{groupingBusy ? '正在分组…' : '②分组(含种子)'}}</view>
          <view class="btn-outline small-btn" bindtap="generateAllMatches">③生成对阵</view>
          <view class="btn-primary small-btn" bindtap="finishGroup">④结束小组赛</view>
          <view wx:if="{{canFinishPlayoff}}" class="btn-primary small-btn" bindtap="finishPlayoff">⑤结束附加赛</view>
        </view>
      </view>

      <view class="card">
        <text class="section-title">挑战者组对阵</text>
        <view class="stage-tabs">
          <view wx:for="{{challengerSwiper}}" wx:key="title" class="stage-tab {{challengerStage === index ? 'active' : ''}}" data-idx="{{index}}" bindtap="switchChallengerStage">{{item.title}}</view>
        </view>
        <swiper class="stage-swiper" current="{{challengerStage}}" bindchange="onChallengerSwiper">
          <swiper-item wx:for="{{challengerSwiper}}" wx:key="title">
            <!-- 小组赛：按 A/B/C 组分区 -->
            <block wx:if="{{item.type === 'group'}}">
              <scroll-view scroll-y class="stage-scroll">
                <view wx:if="{{item.count === 0}}" class="empty">暂无对阵</view>
                <view wx:for="{{item.groups}}" wx:for-item="gr" wx:for-index="gname" wx:key="gname">
                  <text class="group-title">{{gname}}组</text>
                  <view wx:for="{{gr}}" wx:key="id" wx:for-item="r" class="round-row">
                    <view class="versus">
                      <view class="vteam {{r.winner_id === r.team1_id ? 'vteam-win' : ''}}">
                        <text class="vteam-name" bindtap="showTeam" data-id="{{r.team1_id}}">{{r.team1_name || '轮空'}}</text>
                        <text class="vteam-score {{r.winner_id === r.team1_id ? 'score-win' : ''}}">{{r.team1_score == null ? '-' : r.team1_score}}</text>
                      </view>
                      <text class="vs-text">VS</text>
                      <view class="vteam {{r.winner_id === r.team2_id ? 'vteam-win' : ''}}">
                        <text class="vteam-name" bindtap="showTeam" data-id="{{r.team2_id}}">{{r.team2_name || '轮空'}}</text>
                        <text class="vteam-score {{r.winner_id === r.team2_id ? 'score-win' : ''}}">{{r.team2_score == null ? '-' : r.team2_score}}</text>
                      </view>
                    </view>
                    <view class="detail-tags">
                      <text class="tag tag-blue">{{r.group_name}}组</text>
                      <view class="btn-outline small-btn" bindtap="openScore" data-id="{{r.id}}">录比分</view>
                    </view>
                  </view>
                </view>
              </scroll-view>
            </block>
            <!-- 附加赛：普通列表 -->
            <block wx:else>
              <scroll-view scroll-y class="stage-scroll">
                <view wx:if="{{item.historyOnly}}" class="hint-bar">历史附加赛对阵，仅保留查看；当前赛制没有附加赛晋级操作。</view>
                <view wx:if="{{item.rounds.length === 0}}" class="empty">暂无对阵</view>
                <view wx:for="{{item.rounds}}" wx:key="id" wx:for-item="r" class="round-row">
                  <view class="versus">
                    <view class="vteam {{r.winner_id === r.team1_id ? 'vteam-win' : ''}}">
                      <text class="vteam-name" bindtap="showTeam" data-id="{{r.team1_id}}">{{r.team1_name || '轮空'}}</text>
                      <text class="vteam-score {{r.winner_id === r.team1_id ? 'score-win' : ''}}">{{r.team1_score == null ? '-' : r.team1_score}}</text>
                    </view>
                    <text class="vs-text">VS</text>
                    <view class="vteam {{r.winner_id === r.team2_id ? 'vteam-win' : ''}}">
                      <text class="vteam-name" bindtap="showTeam" data-id="{{r.team2_id}}">{{r.team2_name || '轮空'}}</text>
                      <text class="vteam-score {{r.winner_id === r.team2_id ? 'score-win' : ''}}">{{r.team2_score == null ? '-' : r.team2_score}}</text>
                    </view>
                  </view>
                  <view class="detail-tags">
                    <text class="tag tag-blue">{{r.group_name}}</text>
                    <view wx:if="{{!item.historyOnly}}" class="btn-outline small-btn" bindtap="openScore" data-id="{{r.id}}">录比分</view>
                  </view>
                </view>
              </scroll-view>
            </block>
          </swiper-item>
        </swiper>
      </view>
    </view>

    <!-- ===== 传奇组 tab ===== -->
    <view wx:if="{{tab === 'legend'}}">
      <view class="card">
        <text class="section-title">传奇组队伍（上区/下区）</text>
        <view wx:if="{{legendTeams.length === 0}}" class="empty">暂无传奇组队伍</view>
        <view class="chip-wrap">
          <view wx:for="{{legendTeams}}" wx:key="team_id" class="team-chip" bindtap="showTeam" data-id="{{item.team_id}}">
            <text class="chip-name">{{item.team_name}}</text>
            <text class="tag {{item.seed <= 4 ? 'tag-orange' : 'tag-green'}}">{{item.seed <= 4 ? '直升' : '晋级'}}</text>
            <text wx:if="{{item.group_name}}" class="tag tag-blue">{{item.group_name}}</text>

          </view>
        </view>
        <view class="op-btns">
          <view class="btn-primary small-btn" bindtap="divideLegend">⑥传奇组分区</view>
          <view class="btn-primary small-btn" bindtap="finishLegend">⑦结束传奇组</view>
        </view>
      </view>

      <view class="card">
        <text class="section-title">传奇组循环赛对阵</text>
        <view class="stage-tabs">
          <view wx:for="{{legendSwiper}}" wx:key="title" class="stage-tab {{legendStage === index ? 'active' : ''}}" data-idx="{{index}}" bindtap="switchLegendStage">{{item.title}}</view>
        </view>
        <swiper class="stage-swiper" current="{{legendStage}}" bindchange="onLegendSwiper">
          <swiper-item wx:for="{{legendSwiper}}" wx:key="title">
            <scroll-view scroll-y class="stage-scroll">
              <view wx:if="{{item.rounds.length === 0}}" class="empty">暂无对阵</view>
              <view wx:for="{{item.rounds}}" wx:key="id" wx:for-item="r" class="round-row">
                <view class="versus">
                  <view class="vteam {{r.winner_id === r.team1_id ? 'vteam-win' : ''}}">
                    <text class="vteam-name" bindtap="showTeam" data-id="{{r.team1_id}}">{{r.team1_name || '轮空'}}</text>
                    <text class="vteam-score {{r.winner_id === r.team1_id ? 'score-win' : ''}}">{{r.team1_score == null ? '-' : r.team1_score}}</text>
                  </view>
                  <text class="vs-text">VS</text>
                  <view class="vteam {{r.winner_id === r.team2_id ? 'vteam-win' : ''}}">
                    <text class="vteam-name" bindtap="showTeam" data-id="{{r.team2_id}}">{{r.team2_name || '轮空'}}</text>
                    <text class="vteam-score {{r.winner_id === r.team2_id ? 'score-win' : ''}}">{{r.team2_score == null ? '-' : r.team2_score}}</text>
                  </view>
                </view>
                <view class="detail-tags">
                  <text class="tag tag-blue">{{r.group_name}}</text>
                  <view class="btn-outline small-btn" bindtap="openScore" data-id="{{r.id}}">录比分</view>
                </view>
              </view>
            </scroll-view>
          </swiper-item>
        </swiper>
      </view>
    </view>

    <!-- ===== 淘汰赛 tab ===== -->
    <view wx:if="{{tab === 'knockout'}}">
      <view class="card">
        <text class="section-title">淘汰赛队伍（6强 · 上下区）</text>
        <view wx:if="{{knockoutHint}}" class="hint-bar">{{knockoutHint}}</view>
        <view wx:if="{{playoffTeams.length === 0}}" class="empty">暂无淘汰赛队伍</view>
        <view class="chip-wrap">
          <view wx:for="{{playoffTeams}}" wx:key="team_id" class="team-chip" bindtap="showTeam" data-id="{{item.team_id}}">
            <text class="chip-name">{{item.team_name}}</text>
            <text wx:if="{{item.stage === 'playoff' && item.seed <= 2}}" class="tag tag-orange">轮空·直进半决赛</text>
            <text wx:elif="{{item.stage === 'playoff' && item.seed <= 4}}" class="tag tag-green">1/4决赛·第2</text>
            <text wx:elif="{{item.stage === 'playoff'}}" class="tag tag-blue">1/4决赛·第3</text>
            <text wx:else class="tag tag-gray">已淘汰</text>
            <text wx:if="{{item.group_name}}" class="tag tag-blue">{{item.group_name}}</text>

          </view>
        </view>
        <view class="op-btns">
          <view class="btn-primary small-btn" bindtap="genKnockout">⑧生成淘汰赛</view>
          <view class="btn-primary small-btn" bindtap="advanceKnockout">⑨推进淘汰赛</view>
        </view>
      </view>

      <view class="card">
        <text class="section-title">淘汰赛对阵（BO3 三局两胜）</text>
        <view wx:if="{{knockoutGroups.length === 0}}" class="empty">暂无对阵，请先「生成淘汰赛」</view>
        <view wx:for="{{knockoutGroups}}" wx:key="title" wx:for-item="grp" class="ko-section">
          <text class="group-title ko-title">{{grp.title}}</text>
          <view wx:for="{{grp.rounds}}" wx:key="id" wx:for-item="item" class="round-row ko-row">
            <view class="versus">
              <view class="vteam {{item.winner_id === item.team1_id ? 'vteam-win' : ''}}">
                <text class="vteam-name" bindtap="showTeam" data-id="{{item.team1_id}}">{{item.team1_name || '轮空'}}</text>
              </view>
              <view class="big-score big-score-tap" bindtap="openScore" data-id="{{item.id}}">
                <text class="big-score-text {{item.status === 'finished' ? 'score-win' : 'score-tbd'}}">{{item.team1_score}} : {{item.team2_score}}</text>
                <text class="big-score-label">{{item.ko_label}}</text>
              </view>
              <view class="vteam {{item.winner_id === item.team2_id ? 'vteam-win' : ''}}">
                <text class="vteam-name" bindtap="showTeam" data-id="{{item.team2_id}}">{{item.team2_name || '轮空'}}</text>
              </view>
            </view>
            <view class="detail-tags">
              <text class="bo3-more" bindtap="showBo3" data-id="{{item.id}}">小局</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- BO3 小局详情弹层 -->
  <view wx:if="{{showBo3 && bo3Detail}}" class="mask" bindtap="closeBo3">
    <view class="bo3-panel" catchtap="noop">
      <view class="detail-header">
        <text class="section-title">{{bo3Detail.team1_name}} vs {{bo3Detail.team2_name}}</text>
        <image class="detail-close" src="/images/icons/x.svg" bindtap="closeBo3"/>
      </view>
      <view class="bo3-big">
        <text class="bo3-big-score">{{bo3Detail.score1}} : {{bo3Detail.score2}}</text>
        <text class="bo3-big-label">{{bo3Detail.ko_label}}</text>
      </view>
      <view wx:if="{{bo3Detail.games.length === 0}}" class="empty">暂无小局比分</view>
      <view wx:for="{{bo3Detail.games}}" wx:key="index" class="bo3-game">
        <text class="bo3-game-title">第{{index + 1}}局</text>
        <text class="bo3-game-score">{{item.t1}} : {{item.t2}}</text>
        <text class="tag {{item.t1 > item.t2 ? 'tag-green' : item.t2 > item.t1 ? 'tag-blue' : 'tag-gray'}}">{{item.t1 > item.t2 ? bo3Detail.team1_name : item.t2 > item.t1 ? bo3Detail.team2_name : '平局'}}</text>
      </view>
    </view>
  </view>

  <!-- 队伍分阶段战绩 -->
  <view wx:if="{{showHistory && historyTeam}}" class="mask" bindtap="closeHistory">
    <view class="team-history-panel" catchtap="noop">
      <view class="detail-header">
        <view class="standing-copy"><text class="section-title">{{historyTeam.team_name}}</text><text class="team-meta">分阶段对局 · 比分以本队为先</text></view>
        <image class="detail-close" src="/images/icons/x.svg" bindtap="closeHistory"/>
      </view>
      <scroll-view scroll-y class="team-history-scroll">
        <view wx:if="{{historySections.length === 0}}" class="empty">暂无对阵，生成赛程后可查看各阶段战绩</view>
        <view wx:for="{{historySections}}" wx:key="key" wx:for-item="section" class="record-section">
          <view class="record-heading"><text class="record-title">{{section.title}}</text><text class="record-stats">{{section.record_text}}</text></view>
          <text wx:if="{{section.extra_text}}" class="team-meta">{{section.extra_text}}</text>
          <view wx:for="{{section.rounds}}" wx:key="id" wx:for-item="game" class="record-game">
            <view class="record-match"><text class="record-opponent">vs {{game.opponent}}</text><text class="record-result {{game.result_class}}">{{game.outcome}}</text></view>
            <view class="record-score"><text>{{game.score_text}}</text><text class="team-meta">{{game.format_text}} · 第 {{game.round_number}} 场</text></view>
            <text wx:if="{{game.maps_text}}" class="record-maps">{{game.maps_text}}</text>
          </view>
        </view>
        <view class="btn-outline small-btn" bindtap="exportTeamCsv" data-id="{{historyTeam.team_id}}">导出该队</view>
      </scroll-view>
    </view>
  </view>

  <!-- 比分输入面板（淘汰赛为 BO3，其余单局） -->
  <view wx:if="{{showScoreInput}}" class="mask" catchtap="closeScoreInput">
    <view class="score-panel" catchtap="noop">
      <text class="section-title">{{isBo3 ? '录入比分（BO3 三局两胜）' : '录入比分'}}</text>
      <block wx:if="{{isBo3}}">
        <text class="team-meta">每局格式 13-9，第3局留空即 2-0；总比分自动判定</text>
        <view wx:for="{{bo3Games}}" wx:key="index" class="bo3-row">
          <text class="bo3-label">第{{index + 1}}局</text>
          <input class="input score-input bo3-input" type="text" placeholder="{{index === 2 ? '第3局（2-1时填）' : '如 13-9'}}" value="{{item}}" data-index="{{index}}" bindinput="onBo3Input"/>
        </view>
      </block>
      <block wx:else>
        <text class="team-meta">格式: 13-9（主队-客队）</text>
        <input class="input score-input" type="text" placeholder="如: 13-9" value="{{scoreInput}}" bindinput="onScoreInput"/>
      </block>
      <view class="score-btns">
        <view class="btn-outline" bindtap="closeScoreInput">取消</view>
        <view class="btn-primary" bindtap="submitScore">确认</view>
      </view>
    </view>
  </view>

  <!-- 报名时间管理，与比赛排期范围独立 -->
  <view wx:if="{{showRegistrationPanel}}" class="mask" bindtap="closeRegistrationPanel">
    <view class="history-panel registration-panel" catchtap="noop">
      <view class="detail-header">
        <text class="section-title">报名时间</text>
        <image class="detail-close" src="/images/icons/x.svg" bindtap="closeRegistrationPanel"/>
      </view>
      <text class="team-meta">所有时间均为北京时间。留空表示该端不限制，可只设置开始或截止时间。</text>
      <view class="registration-notice">此设置不会自动修改赛事状态。赛事处于「报名中」且满足时间范围时，用户才可报名。</view>
      <text class="registration-label">开始报名</text>
      <view class="registration-pickers">
        <picker mode="date" disabled="{{registrationSaving}}" value="{{registrationStartDate}}" data-field="registrationStartDate" bindchange="onRegistrationInput"><view class="win-picker">{{registrationStartDate || '选择日期'}}</view></picker>
        <picker mode="time" disabled="{{registrationSaving}}" value="{{registrationStartTime}}" data-field="registrationStartTime" bindchange="onRegistrationInput"><view class="win-picker">{{registrationStartTime || '选择时间'}}</view></picker>
        <text class="registration-clear" bindtap="clearRegistrationLimit" data-side="start">清除</text>
      </view>
      <text class="registration-label">截止报名</text>
      <view class="registration-pickers">
        <picker mode="date" disabled="{{registrationSaving}}" value="{{registrationEndDate}}" data-field="registrationEndDate" bindchange="onRegistrationInput"><view class="win-picker">{{registrationEndDate || '选择日期'}}</view></picker>
        <picker mode="time" disabled="{{registrationSaving}}" value="{{registrationEndTime}}" data-field="registrationEndTime" bindchange="onRegistrationInput"><view class="win-picker">{{registrationEndTime || '选择时间'}}</view></picker>
        <text class="registration-clear" bindtap="clearRegistrationLimit" data-side="end">清除</text>
      </view>
      <text class="registration-clear clear-all" bindtap="clearRegistrationLimit" data-side="all">清除全部时间限制</text>
      <view class="score-btns">
        <button class="btn-outline" disabled="{{registrationSaving}}" bindtap="closeRegistrationPanel">取消</button>
        <button class="btn-primary" loading="{{registrationSaving}}" disabled="{{registrationSaving}}" bindtap="saveRegistrationWindow">{{registrationSaving ? '保存中' : '保存报名时间'}}</button>
      </view>
    </view>
  </view>

  <!-- 比赛排期范围管理面板 -->
  <view wx:if="{{showWindowPanel}}" class="mask" bindtap="closeWindowPanel">
    <view class="history-panel" catchtap="noop">
      <view class="detail-header">
        <text class="section-title">比赛排期范围</text>
        <image class="detail-close" src="/images/icons/x.svg" bindtap="closeWindowPanel"/>
      </view>
      <text class="team-meta">限定双方队长可协商的比赛时间范围（北京时间），与报名开始、截止时间分别设置。</text>

      <view wx:if="{{stageWindows.length === 0}}" class="empty">暂无分组或已保存的排期范围，请先完成分组或生成对阵。</view>
      <view wx:for="{{windowSections}}" wx:for-item="section" wx:key="key" class="window-section">
        <text class="group-title">{{section.title}}</text>
        <text class="team-meta">{{section.hint}}</text>
        <view wx:for="{{section.windows}}" wx:key="group_name" class="history-row">
          <view class="detail-header">
            <text class="team-name">{{item.label}}</text>
            <view wx:if="{{!item.history_only}}" class="btn-outline small-btn" bindtap="openWindowEdit" data-group="{{item.group_name}}">{{item.has_window ? '修改' : '设置'}}</view>
          </view>
          <text wx:if="{{item.source_hint}}" class="window-source">{{item.source_hint}}</text>
          <text class="team-meta">{{item.window_text}}</text>
        </view>
      </view>

      <block wx:if="{{windowEditGroup}}">
        <text class="group-title">设置「{{windowEditLabel}}」排期范围</text>
        <view class="win-row">
          <text class="win-label">开始日期</text>
          <picker mode="date" value="{{windowStartDate}}" bindchange="onStartDateChange">
            <view class="win-picker">{{windowStartDate || '选择日期'}}</view>
          </picker>
        </view>
        <view class="win-row">
          <text class="win-label">开始时间</text>
          <picker mode="time" value="{{windowStartTime}}" bindchange="onStartTimeChange">
            <view class="win-picker">{{windowStartTime || '选择时间'}}</view>
          </picker>
        </view>
        <view class="win-row">
          <text class="win-label">结束日期</text>
          <picker mode="date" value="{{windowEndDate}}" bindchange="onEndDateChange">
            <view class="win-picker">{{windowEndDate || '选择日期'}}</view>
          </picker>
        </view>
        <view class="win-row">
          <text class="win-label">结束时间</text>
          <picker mode="time" value="{{windowEndTime}}" bindchange="onEndTimeChange">
            <view class="win-picker">{{windowEndTime || '选择时间'}}</view>
          </picker>
        </view>
        <view class="score-btns">
          <button class="btn-outline" disabled="{{windowSaving}}" bindtap="cancelWindowEdit">取消</button>
          <button class="btn-primary" disabled="{{windowSaving}}" loading="{{windowSaving}}" bindtap="saveWindow">{{windowSaving ? '保存中' : '保存'}}</button>
        </view>
      </block>
    </view>
  </view>
</view>
