.archive-page { padding: 20rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); }
.historical-links { margin-top: 18rpx; padding: 0 3rpx; }.historical-links .text-button { display: inline-block; margin-top: 5rpx; padding: 10rpx 0; text-align: left; font-size: 22rpx; }
.archive-heading { margin: 0 2rpx 30rpx; }.eyebrow { display: block; color: #087f8c; font-size: 18rpx; font-weight: 700; letter-spacing: 2rpx; }.page-title { display: block; margin-top: 10rpx; color: #102a43; font-size: 39rpx; line-height: 1.4; font-weight: 800; }.page-caption { margin-top: 10rpx; color: #62798c; font-size: 23rpx; line-height: 1.6; }
.event-card { display: flex; align-items: center; gap: 18rpx; padding: 24rpx; background: #133a4e; border-radius: 22rpx; margin-bottom: 24rpx; }.event-icon { flex-shrink: 0; width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; border-radius: 17rpx; background: rgba(255,255,255,.08); }.event-icon image { width: 40rpx; height: 40rpx; }.event-copy { min-width: 0; flex: 1; }.event-copy .field-caption { color: #a4bdca; }.event-name { display: block; color: #fff; font-size: 29rpx; font-weight: 650; line-height: 1.5; word-break: break-all; }.event-state { color: #c7e5dd; font-size: 20rpx; flex-shrink: 0; padding: 5rpx 10rpx; background: rgba(188,228,218,.1); border-radius: 8rpx; }
.form-card,.state-card { padding: 28rpx; margin-bottom: 22rpx; border: 1rpx solid #e0e9ef; border-radius: 24rpx; background: #fff; }.section-heading { display: flex; align-items: center; gap: 18rpx; margin-bottom: 24rpx; }.section-number { color: #0c7d88; font-size: 22rpx; width: 51rpx; height: 51rpx; border-radius: 15rpx; display: flex; align-items: center; justify-content: center; background: #e9f5f5; font-weight: 750; }.section-title { display: block; color: #17374f; font-size: 29rpx; font-weight: 750; }.section-caption { display: block; color: #7a8e9f; font-size: 20rpx; margin-top: 3rpx; }
.field { margin-top: 27rpx; }.field-label { display: block; font-size: 25rpx; color: #304d64; font-weight: 650; margin-bottom: 12rpx; }.required { color: #b57335; }.optional { color: #8899a7; font-size: 20rpx; margin-left: 10rpx; font-weight: 400; }.field-caption { display: block; font-size: 20rpx; color: #8193a3; font-weight: 400; }.form-input { box-sizing: border-box; width: 100%; padding: 18rpx 20rpx; height: 84rpx; border: 1rpx solid #dfe8ed; border-radius: 14rpx; background: #f8fafb; font-size: 26rpx; line-height: 1.6; color: #18364e; }.form-input[disabled] { opacity: .72; }.picker-input { display: flex; justify-content: space-between; align-items: center; }.placeholder { color: #8796a2; }.helper { display: block; margin-top: 10rpx; font-size: 21rpx; color: #718698; line-height: 1.7; word-break: break-all; }
.team-import { display: flex; align-items: center; gap: 16rpx; background: #f0f7f8; border-radius: 17rpx; padding: 19rpx; }.team-import-copy { flex: 1; min-width: 0; color: #406476; font-size: 24rpx; }.team-import-copy .helper { margin-top: 5rpx; font-size: 19rpx; }.import-button { flex-shrink: 0; margin: 0; display: flex; align-items: center; gap: 8rpx; padding: 13rpx 15rpx; color: #087f8c; background: #fff; border-radius: 12rpx; border: 1rpx solid #cbe3e7; font-size: 22rpx; line-height: 1.5; white-space: nowrap; }.import-button::after { border: 0; }.inline-note { display: block; color: #a3622c; font-size: 21rpx; margin-top: 12rpx; line-height: 1.6; }.source-warning { display: block; background: #fff8ea; color: #946a2c; border-radius: 12rpx; font-size: 22rpx; line-height: 1.7; padding: 16rpx; margin-top: 20rpx; }
.score-fields { display: flex; align-items: flex-end; gap: 24rpx; }.score-field { flex: 1; min-width: 0; }.score-field > text { display: block; color: #8193a3; font-size: 21rpx; margin-bottom: 9rpx; text-align: center; }.score-input { text-align: center; font-size: 30rpx; font-weight: 650; }.score-divider { font-size: 32rpx; color: #9cabb7; line-height: 84rpx; }.roster-label { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }.roster-input { min-height: 190rpx; }.note-input { min-height: 160rpx; }
.publish-area { margin-top: 28rpx; }.publish-note { display: block; font-size: 21rpx; line-height: 1.7; color: #7b8e9e; padding: 0 3rpx; margin-bottom: 20rpx; }.primary-button,.secondary-button,.text-button { box-sizing: border-box; font-size: 27rpx; line-height: 1.5; border-radius: 16rpx; font-weight: 650; }.primary-button { padding: 24rpx 18rpx; background: #087f8c; color: #fff; }.primary-button[disabled] { background: #87b3b7; color: #effafa; }.secondary-button { padding: 20rpx; background: #edf6f7; color: #087f8c; margin-top: 22rpx; }.text-button { background: transparent; color: #087f8c; font-size: 23rpx; margin: 12rpx 0 0; padding: 13rpx 8rpx; }.primary-button::after,.secondary-button::after,.text-button::after { border: 0; }.form-error { padding: 23rpx; border-radius: 16rpx; color: #ad4141; background: #fff0ee; border: 1rpx solid #f1d4cf; font-size: 24rpx; line-height: 1.7; }.state-card { padding: 34rpx 28rpx; color: #718698; font-size: 25rpx; }.state-title { display: block; color: #244b61; font-size: 28rpx; font-weight: 700; }.readonly-name { display: block; color: #967338; font-size: 35rpx; font-weight: 750; margin-top: 18rpx; word-break: break-all; }.state-card .primary-button { margin-top: 26rpx; }.success-card { padding: 26rpx; background: #eaf7f1; border: 1rpx solid #cfe8db; border-radius: 22rpx; margin-bottom: 24rpx; }.success-card .state-title { color: #247852; }.success-actions { display: flex; gap: 25rpx; flex-wrap: wrap; }.success-actions .text-button { color: #247852; }
@media (max-width: 350px) { .archive-page { padding-left: 22rpx; padding-right: 22rpx; }.page-title { font-size: 35rpx; }.form-card { padding: 23rpx; }.team-import { padding: 15rpx; gap: 10rpx; }.event-name { font-size: 27rpx; } }
