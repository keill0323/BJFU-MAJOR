/* 管理工作台：待办在前，内容与操作分层。 */
.page { padding: 8rpx 0 calc(40rpx + env(safe-area-inset-bottom)); }
.workbench-head { display: flex; align-items: center; gap: 24rpx; margin: 16rpx 24rpx 24rpx; padding: 32rpx; border-radius: 26rpx; background: #102a43; color: #fff; }
.workbench-copy { flex: 1; min-width: 0; }
.workbench-kicker { display: block; font-size: 18rpx; letter-spacing: 2rpx; color: #9fc6d2; }
.workbench-title { display: block; font-size: 40rpx; font-weight: 750; margin: 8rpx 0; }
.workbench-caption { display: block; font-size: 23rpx; line-height: 1.6; color: #c2d9e3; }
.workbench-total { flex-shrink: 0; min-width: 110rpx; padding-left: 24rpx; border-left: 1rpx solid #476073; text-align: center; font-size: 21rpx; color: #f6d6a5; }
.workbench-number { display: block; font-size: 52rpx; font-weight: 750; line-height: 1.15; margin-bottom: 8rpx; color: #fff; }
.admin-tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 0 24rpx 22rpx; padding: 8rpx; gap: 8rpx; border: 1rpx solid #e2ebf0; background: #fff; border-radius: 22rpx; }
.admin-tab { display: flex; align-items: center; justify-content: center; gap: 6rpx; min-height: 80rpx; padding: 4rpx; font-size: 24rpx; color: #4c657a; border-radius: 14rpx; }
.admin-tab.active { background: #e7f5f5; color: #087782; font-weight: 700; }
.tab-badge { display: inline-block; min-width: 28rpx; padding: 2rpx 6rpx; border-radius: 12rpx; background: #b74532; color: #fff; font-size: 19rpx; line-height: 1.4; text-align: center; }
.section-heading { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; margin: 30rpx 28rpx 18rpx; }
.section-title { display: block; color: #102a43; font-size: 30rpx; font-weight: 700; }
.section-caption { display: block; color: #62798c; font-size: 23rpx; line-height: 1.5; }
.section-heading .section-caption { margin-top: 4rpx; }
.todo-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 0 24rpx; gap: 16rpx; }
.todo-card { padding: 24rpx; border: 1rpx solid #e2ebf0; border-radius: 22rpx; background: #fff; }
.todo-card.has-pending { border-color: #ead7bd; background: #fffdf8; }
.todo-card-top { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; margin-bottom: 20rpx; }
.todo-icon { display: block; width: 48rpx; height: 48rpx; }
.todo-number { font-size: 44rpx; font-weight: 750; line-height: 1; color: #62798c; }
.has-pending .todo-number { color: #a15819; }
.todo-title { display: block; color: #102a43; font-size: 29rpx; font-weight: 650; }
.todo-footer { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; margin-top: 8rpx; color: #62798c; font-size: 22rpx; }
.todo-arrow { font-size: 30rpx; color: #087f8c; }
.notice { display: flex; align-items: center; gap: 20rpx; margin: 16rpx 24rpx; padding: 20rpx 24rpx; border-radius: 16rpx; font-size: 24rpx; line-height: 1.6; }
.notice > view:first-child { flex: 1; min-width: 0; }
.notice-title { display: block; font-weight: 650; }
.notice-copy { display: block; font-size: 23rpx; }
.error-notice { background: #fff1ec; color: #963c2c; border: 1rpx solid #f1d5c9; }
.clear-notice { background: #eaf6f0; color: #287154; }
.sync-state { margin: 12rpx 28rpx; color: #62798c; font-size: 22rpx; }
.load-state { padding: 32rpx 24rpx; color: #62798c; font-size: 25rpx; text-align: center; }
.text-action { flex-shrink: 0; display: flex; align-items: center; min-height: 80rpx; color: #087f8c; font-size: 24rpx; font-weight: 650; }
.error-notice .text-action { color: #963c2c; }
.card { margin: 20rpx 24rpx; padding: 26rpx; border-radius: 22rpx; box-shadow: none; }
.queue-heading { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10rpx; margin-bottom: 8rpx; }
.queue-row { display: flex; align-items: center; gap: 16rpx; padding: 24rpx 0; border-top: 1rpx solid #edf2f5; }
.queue-row:last-child { padding-bottom: 0; }
.queue-copy { flex: 1; min-width: 0; }
.queue-name { display: block; font-size: 27rpx; color: #102a43; word-break: break-all; font-weight: 600; }
.queue-caption { display: block; font-size: 22rpx; margin-top: 6rpx; color: #62798c; }
.queue-count { flex-shrink: 0; color: #a15819; background: #fbf1e4; border-radius: 10rpx; padding: 6rpx 12rpx; font-size: 23rpx; }
.queue-arrow { color: #62798c; font-size: 32rpx; }
.management-links { padding-top: 0; padding-bottom: 0; }
.management-link { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 26rpx 0; border-bottom: 1rpx solid #edf2f5; color: #087f8c; font-size: 30rpx; }
.management-link:last-child { border-bottom: 0; }
.link-title { display: block; font-size: 28rpx; font-weight: 600; color: #102a43; }
.link-caption { display: block; font-size: 23rpx; margin-top: 6rpx; color: #62798c; }
.search-row { display: flex; align-items: center; gap: 16rpx; }
.search-row input { flex: 1; min-width: 0; padding: 18rpx 16rpx; background: #f3f7fa; border-radius: 12rpx; font-size: 25rpx; }
.user-top, .verify-top, .team-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 14rpx; margin-bottom: 14rpx; }
.user-id { color: #62798c; font-size: 23rpx; }
.user-name, .team-name { display: block; min-width: 0; font-size: 31rpx; color: #102a43; font-weight: 650; line-height: 1.5; word-break: break-all; }
.team-top .team-name { flex: 1; }
.tag { flex-shrink: 0; }
.user-meta, .team-meta { display: block; color: #62798c; font-size: 24rpx; margin: 10rpx 0 18rpx; line-height: 1.7; word-break: break-all; }
.user-actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.small-btn { display: flex; align-items: center; justify-content: center; min-height: 80rpx; padding: 14rpx 22rpx; border-radius: 12rpx; font-size: 25rpx; }
.btn-primary { box-shadow: none; }
.verify-card .user-actions .small-btn { flex: 1; }
.verify-shot { display: block; width: 100%; height: 330rpx; background: #f3f7fa; border: 1rpx solid #e2ebf0; border-radius: 16rpx; margin: 18rpx 0; }
.ai-suggest { border-radius: 14rpx; padding: 18rpx; margin: 16rpx 0; border: 1rpx solid #e2ebf0; background: #f3f7fa; }
.ai-pass { background: #edf8f3; border-color: #cee7d9; }
.ai-reject { background: #fff3f1; border-color: #efd7d0; }
.ai-pending { background: #fff9ed; border-color: #ecdfc6; }
.ai-suggest-top { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8rpx; margin-bottom: 6rpx; }
.ai-suggest-label { font-size: 25rpx; font-weight: 600; }
.ai-suggest-conf, .ai-suggest-reason { color: #62798c; font-size: 23rpx; line-height: 1.7; }
.ai-suggest-reason { display: block; }
.field-label { display: block; color: #304d64; font-size: 25rpx; margin: 18rpx 0 10rpx; font-weight: 550; }
.input { box-sizing: border-box; width: 100%; background: #f7fafb; border-radius: 14rpx; padding: 20rpx; font-size: 28rpx; }
.input-row { display: flex; gap: 20rpx; }
.input-group { flex: 1; min-width: 0; }
.type-row { display: flex; gap: 16rpx; }
.type-option { flex: 1; padding: 18rpx 0; color: #4c657a; font-size: 27rpx; text-align: center; background: #f7fafb; border: 1rpx solid #dce7ed; border-radius: 14rpx; }
.type-option.active { color: #087f8c; background: #e7f5f5; border-color: #91c8cd; font-weight: 650; }
.registration-fields { margin: 24rpx 0 28rpx; padding: 20rpx; border: 1rpx solid #e2ebf0; border-radius: 16rpx; background: #f5f9fa; }
.registration-title { display: block; color: #102a43; font-size: 27rpx; font-weight: 650; }
.registration-optional { font-size: 22rpx; color: #62798c; font-weight: 400; }
.registration-label { display: block; margin: 20rpx 0 10rpx; color: #4c657a; font-size: 24rpx; }
.registration-pickers { display: flex; align-items: center; gap: 10rpx; }
.registration-pickers picker { flex: 1; min-width: 0; }
.registration-picker { padding: 18rpx 8rpx; text-align: center; background: #fff; border: 1rpx solid #dbe6ec; border-radius: 12rpx; color: #102a43; font-size: 23rpx; }
.registration-clear { flex-shrink: 0; color: #087f8c; padding: 18rpx 4rpx; font-size: 23rpx; }
.registration-hint { display: block; color: #62798c; line-height: 1.7; font-size: 23rpx; margin-top: 20rpx; }
.mask { position: fixed; inset: 0; background: rgba(16,42,67,.45); z-index: 100; display: flex; align-items: center; justify-content: center; }
.detail-panel { box-sizing: border-box; width: 90%; max-height: 82vh; overflow-y: auto; background: #fff; border-radius: 26rpx; padding: 28rpx; }
.detail-header { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; margin-bottom: 18rpx; }
.detail-close { padding: 14rpx; font-size: 34rpx; color: #62798c; }
.detail-avatar { display: block; width: 120rpx; height: 120rpx; border-radius: 50%; margin: 20rpx 0; background: #f3f7fa; }
.member-row { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; padding: 20rpx 0; border-bottom: 1rpx solid #e2ebf0; }
.member-name { flex: 1; min-width: 0; font-size: 26rpx; word-break: break-all; }
.member-rank { flex-shrink: 0; font-size: 23rpx; color: #62798c; }
@media (max-width: 350px) {
  .workbench-head { padding: 26rpx; gap: 14rpx; }
  .workbench-title { font-size: 36rpx; }
  .workbench-total { padding-left: 16rpx; min-width: 96rpx; }
  .admin-tab { font-size: 23rpx; }
  .todo-card { padding: 20rpx; }
  .small-btn { padding-left: 18rpx; padding-right: 18rpx; }
  .registration-fields { padding: 16rpx; }
}
