<nav-drawer title="聊天举报与禁言"></nav-drawer>
<view class="moderation-page">
  <text class="page-kicker">聊天管理</text><text class="page-title">让交流保持友善</text>
  <text class="page-copy">核查被举报的消息，并记录处理原因。</text>
  <view wx:if="{{checking}}" class="card state">正在确认管理员权限…</view>
  <view wx:elif="{{error}}" class="card"><text class="error-text">{{error}}</text><button class="secondary" bindtap="initialize">重新检查</button></view>
  <block wx:elif="{{allowed}}">
    <view class="section-head"><text class="section-title">举报记录</text><text class="count">{{pending}} 条待处理</text><button class="refresh" bindtap="loadReports" disabled="{{loading || processing !== null || sanctionBusy}}">刷新</button></view>
    <text class="page-copy">只显示举报关联的消息。已经按保留规则删除的正文无法恢复。</text>
    <view wx:if="{{listError}}" class="card error-text" bindtap="loadReports">{{listError}} · 点击重试</view>
    <view wx:for="{{reports}}" wx:key="id" class="card report-card">
      <view class="report-head"><text class="report-id">举报 #{{item.id}}</text><text class="status {{item.status}}">{{item.statusText}}</text></view>
      <text class="meta">{{item.timeText}} · {{item.sender_id ? '发送者 ID ' + item.sender_id : '发送者记录不可用'}}</text>
      <text class="field-label">被举报的消息</text><text class="message-content" selectable>{{item.contentText}}</text>
      <text class="field-label">举报原因</text><text class="report-reason" selectable>{{item.reason}}</text>
      <block wx:if="{{item.status === 'pending'}}">
        <textarea class="reason-input" value="{{reasons[item.id] || ''}}" data-id="{{item.id}}" bindinput="onReason" maxlength="300" placeholder="填写核查结论和处理原因" disabled="{{processing !== null || sanctionBusy}}"/>
        <view class="actions"><button class="secondary" bindtap="resolve" data-id="{{item.id}}" data-action="dismiss" disabled="{{processing !== null || sanctionBusy}}">驳回举报</button><button class="danger" bindtap="resolve" data-id="{{item.id}}" data-action="hide" loading="{{processing === item.id}}" disabled="{{processing !== null || sanctionBusy}}">隐藏消息</button></view>
      </block>
      <text wx:elif="{{item.resolution}}" class="resolution">处理记录：{{item.resolution}}</text>
      <button wx:if="{{item.sender_id}}" class="sender-action" bindtap="targetSender" data-id="{{item.sender_id}}" disabled="{{processing !== null || sanctionBusy}}">对发送者设置禁言 ›</button>
    </view>
    <text wx:if="{{actionError}}" class="error-text">{{actionError}}</text>
    <view wx:if="{{loading}}" class="state">正在加载举报…</view>
    <view wx:elif="{{!reports.length && !listError}}" class="state">暂时没有聊天举报</view>
    <button wx:if="{{more}}" class="secondary more-button" bindtap="loadMore" disabled="{{loading || processing !== null || sanctionBusy}}">查看更多举报</button>
    <view id="sanctions" class="card sanction-card">
      <text class="section-title">禁言设置</text><text class="page-copy">禁言期间用户可以查看聊天，暂时无法发送消息。选择「解除禁言」恢复发送。</text>
      <text class="field-label">用户 ID</text><input class="text-input" type="number" maxlength="12" value="{{sanctionUser}}" bindinput="onSanctionUser" placeholder="填写需要处理的用户 ID" disabled="{{processing !== null || sanctionBusy}}"/>
      <text class="field-label">处理方式</text><picker mode="selector" range="{{sanctionOptions}}" range-key="label" value="{{sanctionIndex}}" bindchange="onSanctionIndex" disabled="{{processing !== null || sanctionBusy}}"><view class="picker">{{sanctionOptions[sanctionIndex].label}}<text>⌄</text></view></picker>
      <text class="field-label">处理原因</text><textarea class="reason-input" maxlength="300" value="{{sanctionReason}}" bindinput="onSanctionReason" placeholder="说明禁言或解除禁言的原因" disabled="{{processing !== null || sanctionBusy}}"/>
      <text wx:if="{{sanctionMessage}}" class="result-message">{{sanctionMessage}}</text>
      <button class="primary" bindtap="sanction" loading="{{sanctionBusy}}" disabled="{{processing !== null || sanctionBusy}}">确认{{sanctionOptions[sanctionIndex].hours === 0 ? '解除禁言' : '设置禁言'}}</button>
    </view>
  </block>
</view>
