.hall-page { padding: 28rpx 28rpx calc(32rpx + env(safe-area-inset-bottom)); }
.archive-source { display: inline-block; margin: 9rpx 28rpx 0; padding: 3rpx 10rpx; color: #8b7957; background: #f2eddf; border-radius: 6rpx; font-size: 19rpx; }
.page-heading { margin: 8rpx 2rpx 30rpx; }.eyebrow { display: block; color: #087f8c; font-size: 18rpx; font-weight: 700; letter-spacing: 2.8rpx; }.page-title { display: block; margin-top: 10rpx; color: #102a43; font-size: 39rpx; font-weight: 800; line-height: 1.4; }.page-caption { display: block; margin-top: 8rpx; color: #62798c; font-size: 24rpx; }
.hall-tabs { display: flex; gap: 8rpx; padding: 8rpx; background: #e7eef3; border-radius: 20rpx; }.hall-tab { flex: 1; text-align: center; padding: 19rpx 10rpx; color: #62798c; font-size: 28rpx; border-radius: 15rpx; }.hall-tab.active { background: #102a43; color: #fff; font-weight: 650; box-shadow: 0 5rpx 10rpx rgba(16,42,67,.1); }
.board-heading { display: flex; justify-content: space-between; align-items: center; margin: 32rpx 2rpx 20rpx; gap: 10rpx; }.board-title { display: block; font-size: 29rpx; color: #18364e; font-weight: 750; }.board-subtitle { display: block; color: #62798c; font-size: 20rpx; margin-top: 5rpx; }.total-count { flex-shrink: 0; color: #62798c; font-size: 22rpx; }
.champion-card { overflow: hidden; border: 1rpx solid #e1d6bd; border-radius: 26rpx; background: linear-gradient(140deg,#fffcf3,#fff 65%); margin-bottom: 24rpx; box-shadow: 0 8rpx 20rpx rgba(112,89,40,.035); }
.champion-ribbon { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; padding: 18rpx 26rpx; background: #13354b; }.ribbon-label { display: flex; align-items: center; gap: 10rpx; color: #f0d598; font-size: 18rpx; font-weight: 700; letter-spacing: 2.5rpx; }.ribbon-label image { width: 27rpx; height: 31rpx; }.event-date { font-size: 20rpx; color: #bfd2da; }
.champion-main { display: flex; align-items: center; gap: 24rpx; padding: 30rpx 28rpx 20rpx; }.champion-emblem { width: 108rpx; height: 108rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border: 2rpx solid #cfb776; border-radius: 27rpx; background: #f3ebd8; color: #967338; font-size: 48rpx; font-weight: 750; overflow: hidden; }.champion-emblem image { width: 100%; height: 100%; }.champion-identity { flex: 1; min-width: 0; }.honor-label { display: block; color: #99722d; font-size: 20rpx; letter-spacing: 3rpx; }.champion-name { display: block; color: #102a43; font-size: 36rpx; font-weight: 800; margin-top: 3rpx; word-break: break-all; line-height: 1.35; }.event-type { display: block; margin-top: 7rpx; color: #7f795f; font-size: 20rpx; }
.event-name { display: block; padding: 0 28rpx; color: #4c657a; font-size: 24rpx; line-height: 1.6; word-break: break-all; }.final-result { margin: 22rpx 28rpx; padding: 16rpx 18rpx; display: flex; align-items: center; gap: 16rpx; background: rgba(240,236,223,.58); border-radius: 14rpx; }.final-label { color: #8f7751; font-size: 20rpx; flex-shrink: 0; }.final-score { flex-shrink: 0; font-size: 32rpx; font-weight: 750; color: #163f52; line-height: 1.1; }.final-score text { margin: 0 11rpx; color: #ae9c7e; }.runner-name { min-width: 0; font-size: 22rpx; color: #62798c; word-break: break-all; }.score-pending { color: #8f7751; font-size: 21rpx; }
.champion-actions { display: flex; align-items: center; border-top: 1rpx solid #eee7d8; margin: 0 28rpx; }.roster-toggle { flex: 1; padding: 23rpx 0; color: #62798c; font-size: 23rpx; }.roster-toggle text { color: #a08957; margin-left: 12rpx; font-size: 26rpx; }.event-link { padding: 23rpx 0 23rpx 20rpx; color: #087f8c; font-size: 23rpx; font-weight: 650; }.event-link text { margin-left: 12rpx; }
.champion-roster { margin: 0 28rpx; padding: 2rpx 0 16rpx; border-top: 1rpx solid #eee7d8; }.archive-note { display: block; font-size: 21rpx; color: #887657; margin: 18rpx 0 10rpx; }.member-row { display: flex; align-items: center; gap: 12rpx; padding: 15rpx 0; }.member-avatar,.rank-avatar { display: flex; align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden; width: 58rpx; height: 58rpx; border-radius: 17rpx; background: #e7f0f1; color: #356577; font-size: 25rpx; font-weight: 700; }.member-avatar image,.rank-avatar image { width: 100%; height: 100%; }.member-name { min-width: 0; flex: 1; color: #304d64; font-size: 23rpx; word-break: break-all; }.member-badge { flex-shrink: 0; width: 42rpx; height: 50rpx; }.member-rank { color: #62798c; font-size: 20rpx; max-width: 145rpx; word-break: break-all; }
.rank-spotlight { margin-top: 26rpx; background: linear-gradient(120deg,#102a43,#124d5c); border-radius: 26rpx; padding: 28rpx; display: flex; align-items: center; gap: 14rpx; overflow: hidden; }.spotlight-copy { flex: 1; min-width: 0; }.spotlight-kicker { display: block; color: #9dcdd0; font-size: 16rpx; letter-spacing: 2rpx; }.spotlight-title { display: block; margin-top: 13rpx; color: #f4d598; font-size: 38rpx; font-weight: 800; line-height: 1.3; word-break: break-all; }.spotlight-caption { display: block; font-size: 22rpx; color: #c3dce2; margin-top: 8rpx; }.spotlight-player { display: flex; flex-wrap: wrap; align-items: center; gap: 6rpx 12rpx; margin-top: 22rpx; font-size: 19rpx; color: #a1c5cf; }.spotlight-name { color: #fff; font-size: 22rpx; word-break: break-all; }.spotlight-tied { padding: 2rpx 8rpx; background: rgba(201,232,229,.12); border-radius: 5rpx; color: #bce4dd; }.spotlight-badge { width: 164rpx; height: 188rpx; flex-shrink: 0; }
.ranking-card { border: 1rpx solid #dfe8ed; border-radius: 24rpx; overflow: hidden; background: #fff; }.ranking-head { display: flex; align-items: center; justify-content: space-between; padding: 19rpx 24rpx; color: #8193a3; font-size: 20rpx; border-bottom: 1rpx solid #edf2f5; }.rank-row { display: flex; align-items: center; gap: 14rpx; padding: 20rpx 20rpx; border-bottom: 1rpx solid #edf2f5; }.rank-row:last-child { border-bottom: 0; }.rank-leading { background: linear-gradient(100deg,#fff8e6,#fff); }.position-cell { width: 43rpx; flex-shrink: 0; text-align: center; }.position-number { display: block; font-size: 29rpx; font-weight: 750; color: #62798c; line-height: 1.2; }.position-tied { display: block; font-size: 16rpx; color: #8193a3; margin-top: 5rpx; }.rank-leading .position-number { color: #a67c2f; }.rank-avatar { width: 62rpx; height: 62rpx; }.rank-identity { flex: 1; min-width: 0; }.rank-name { display: block; color: #18364e; font-size: 26rpx; font-weight: 650; word-break: break-all; }.rank-value { width: 164rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: flex-end; gap: 8rpx; }.rank-value image { width: 45rpx; height: 55rpx; flex-shrink: 0; }.rank-value text { color: #4c657a; font-size: 21rpx; word-break: break-all; }
.board-notice { text-align: center; font-size: 24rpx; color: #62798c; padding: 46rpx 20rpx; }.empty-card,.error-card { text-align: center; padding: 48rpx 28rpx; border: 1rpx solid #e2ebf0; border-radius: 24rpx; background: #fff; margin: 20rpx 0; }.empty-emblem { width: 94rpx; height: 94rpx; margin: 0 auto 26rpx; display: flex; align-items: center; justify-content: center; background: #173b51; border-radius: 26rpx; }.empty-emblem image { width: 60rpx; height: 60rpx; }.notice-title { display: block; font-size: 28rpx; color: #304d64; font-weight: 650; }.notice-detail { display: block; margin-top: 12rpx; color: #62798c; font-size: 23rpx; line-height: 1.7; word-break: break-all; }.retry-button { display: inline-block; font-size: 25rpx; color: #087f8c; background: #edf7f7; padding: 15rpx 30rpx; border-radius: 14rpx; margin-top: 24rpx; }.load-more { text-align: center; font-size: 25rpx; color: #087f8c; border: 1rpx solid #d5e6e9; border-radius: 18rpx; padding: 22rpx; background: #f8fcfc; margin-top: 22rpx; }.load-more text { margin-left: 18rpx; }.board-end { display: block; color: #8193a3; font-size: 20rpx; text-align: center; margin-top: 28rpx; }.hall-footer { display: block; text-align: center; font-size: 18rpx; color: #8b9eac; letter-spacing: 1rpx; margin-top: 42rpx; }
@media (max-width: 350px) { .hall-page { padding-left: 22rpx; padding-right: 22rpx; }.page-title { font-size: 36rpx; }.spotlight-badge { width: 140rpx; }.rank-row { gap: 10rpx; padding-left: 14rpx; padding-right: 14rpx; }.rank-value { width: 152rpx; }.rank-avatar { width: 54rpx; height: 54rpx; } }
