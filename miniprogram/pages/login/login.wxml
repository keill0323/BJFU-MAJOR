<view class="page">
  <image class="banner" src="/images/banner_dark.png" mode="aspectFill"/>

  <view class="content">
    <view class="brand">
      <text class="title">北林 CS2 Major</text>
      <text class="subtitle">北京林业大学 · 校内电竞赛事</text>
    </view>

    <view class="login-btn" bindtap="handleLogin">
      <text class="login-btn-text">微信一键登录</text>
    </view>

    <view class="agree-row">
      <view class="agree-checkbox {{agreed ? 'checked' : ''}}" bindtap="toggleAgree">
        <text wx:if="{{agreed}}" class="agree-check-icon">✓</text>
      </view>
      <view class="agree-text-wrap">
        <text class="agree-plain">我已阅读并同意</text>
        <text class="agree-link" catchtap="showRules">《用户服务协议》</text>
        <text class="agree-plain">和</text>
        <text class="agree-link" catchtap="showRules">《隐私政策》</text>
      </view>
    </view>
  </view>
</view>
