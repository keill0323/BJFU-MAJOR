/* 页面根背景也设深绿：即使内容区有亚像素缝隙，露出的也是同色，不会出现竖线 */
page {
  background: #133a35;
}

.page {
  width: 100%;
  height: 100vh;
  box-sizing: border-box;
  /* 纯色背景（不用渐变：WebView 渲染渐变时左边缘可能出现插值竖线） */
  background: #133a35;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
}

.banner {
  width: 100%;
  height: 240rpx;
  display: block;
  margin: 0;
  border-radius: 0;
}

.content {
  width: 100%;
  box-sizing: border-box;
  padding: 48rpx 48rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand {
  text-align: center;
  margin-bottom: 80rpx;
}

.title {
  display: block;
  color: #fff;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.subtitle {
  display: block;
  color: rgba(255, 255, 255, 0.6);
  font-size: 26rpx;
  margin-top: 14rpx;
}

.login-btn {
  width: 100%;
  background: linear-gradient(135deg, #186958, #026234);
  color: #fff;
  border-radius: 999rpx;
  padding: 30rpx;
  text-align: center;
  box-shadow: 0 12rpx 30rpx rgba(2, 98, 52, 0.4);
}
.login-btn:active {
  opacity: 0.88;
}

.login-btn-text {
  font-size: 32rpx;
  font-weight: 600;
}

.login-agree {
  display: block;
  text-align: center;
  color: rgba(255, 255, 255, 0.4);
  font-size: 22rpx;
  margin-top: 28rpx;
}

/* 协议勾选行 */
.agree-row {
  display: flex;
  align-items: flex-start;
  margin-top: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.agree-checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
  box-sizing: border-box;
}

.agree-checkbox.checked {
  background: #2fce7a;
  border-color: #2fce7a;
}

.agree-check-icon {
  color: #06281c;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.agree-text-wrap {
  flex: 1;
  line-height: 1.6;
}

.agree-plain {
  color: rgba(255, 255, 255, 0.6);
  font-size: 22rpx;
}

.agree-link {
  color: #2fce7a;
  font-size: 22rpx;
}
