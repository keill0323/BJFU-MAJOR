page { background: #f3f7fa; }
.page { min-height: 100vh; box-sizing: border-box; padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); background: #f3f7fa; color: #102a43; display: flex; flex-direction: column; }
.brand-bar { display: flex; align-items: center; gap: 14rpx; padding: 8rpx 0 30rpx; }
.brand-symbol { display: flex; align-items: center; justify-content: center; width: 46rpx; height: 50rpx; border-radius: 10rpx 10rpx 18rpx 18rpx; background: #087f8c; color: #fff; font-size: 28rpx; font-weight: 800; font-style: italic; }
.brand-symbol image { width: 34rpx; height: 38rpx; }
.brand-name { font-size: 25rpx; font-weight: 750; letter-spacing: 2rpx; }
.brand-tag { margin-left: auto; color: #748895; font-size: 15rpx; letter-spacing: 1rpx; }
.login-visual { position: relative; overflow: hidden; min-height: 380rpx; box-sizing: border-box; padding: 34rpx; border-radius: 32rpx; background: #102f42; color: #fff; }
.visual-frame { position: absolute; width: 290rpx; height: 420rpx; border: 2rpx solid rgba(97,226,214,.18); transform: rotate(32deg); right: -55rpx; top: -70rpx; border-radius: 48rpx; }
.frame-two { right: -110rpx; top: -105rpx; border-width: 36rpx; border-color: rgba(9,180,176,.11); }
.visual-top { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.visual-kicker { font-size: 20rpx; color: #b2d0d7; letter-spacing: 1rpx; }
.visual-dot { width: 9rpx; height: 9rpx; border-radius: 50%; background: #7be2d8; }
.visual-title { position: relative; display: block; font-size: 63rpx; font-weight: 800; line-height: 1.3; letter-spacing: -2rpx; margin-top: 32rpx; }
.visual-bottom { position: relative; display: flex; align-items: flex-end; justify-content: space-between; margin-top: 30rpx; gap: 12rpx; }
.visual-word { color: #7de3d6; font-weight: 800; font-size: 38rpx; letter-spacing: 4rpx; font-style: italic; }
.visual-caption { color: #a4c2cc; font-size: 15rpx; line-height: 1.65; letter-spacing: 1rpx; text-align: right; }
.visual-title text, .visual-caption text { display: block; }
.content { padding: 36rpx 4rpx 0; }
.welcome-title { display: block; font-size: 38rpx; line-height: 1.4; font-weight: 750; }
.welcome-copy { display: block; font-size: 24rpx; line-height: 1.7; color: #637b8e; margin-top: 12rpx; }
.journey { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; margin: 28rpx 0 36rpx; }
.journey view { display: flex; align-items: center; gap: 8rpx; font-size: 22rpx; color: #526e80; flex-shrink: 0; }
.journey-number { color: #087f8c; font-size: 17rpx; font-weight: 750; }
.journey-divider { flex: 1; height: 1rpx; background: #d5e3e8; }
.login-btn { width: 100%; box-sizing: border-box; background: #087f8c; color: #fff; border-radius: 20rpx; padding: 23rpx 28rpx; font-size: 30rpx; font-weight: 650; line-height: 1.5; text-align: center; box-shadow: 0 8rpx 22rpx rgba(8,127,140,.13); }
.login-btn::after { border: 0; }
.login-btn[disabled] { background: #5da3a9; color: #fff; }
.login-btn:active { opacity: .88; }
.agree-row { display: flex; align-items: flex-start; margin-top: 22rpx; gap: 6rpx; }
.agree-checkbox { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; flex-shrink: 0; position: relative; margin-left: -8rpx; }
.agree-checkbox::before { content: ''; position: absolute; width: 27rpx; height: 27rpx; border: 2rpx solid #96aab5; border-radius: 8rpx; }
.agree-checkbox.checked::before { background: #087f8c; border-color: #087f8c; }
.agree-check-icon { width: 12rpx; height: 7rpx; border-bottom: 3rpx solid #fff; border-left: 3rpx solid #fff; transform: rotate(-45deg); margin-bottom: 4rpx; z-index: 1; }
.agree-text-wrap { flex: 1; min-width: 0; line-height: 1.8; padding-top: 5rpx; }
.agree-plain { color: #637b8e; font-size: 21rpx; }
.agree-link { color: #087f8c; font-size: 21rpx; }
.browse-link { display: flex; align-items: center; justify-content: center; padding: 27rpx 10rpx; gap: 8rpx; color: #637b8e; font-size: 24rpx; }
.browse-link image { width: 26rpx; height: 26rpx; }
.login-footer { display: block; margin-top: auto; padding-top: 20rpx; text-align: center; font-size: 20rpx; letter-spacing: 1rpx; color: #8096a3; }
@media (max-width: 340px) { .brand-tag { font-size: 13rpx; letter-spacing: 0; } }
