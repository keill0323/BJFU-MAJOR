.page {
  padding: 0 0 40rpx;
}

/* ===== 顶部：搜索框 ===== */
.search-bar {
  display: flex;
  align-items: center;
  margin: 20rpx 40rpx 24rpx;
  background: #ffffff;
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
  padding: 6rpx 8rpx 6rpx 22rpx;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.04);
}
.search-ic { width: 32rpx; height: 32rpx; margin-right: 10rpx; }
.search-input {
  flex: 1;
  background: transparent;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: var(--color-gray-800);
}

/* ===== 统计概览 ===== */
.stat-bar {
  display: flex;
  gap: 16rpx;
  margin: 0 40rpx 28rpx;
}
.stat {
  flex: 1;
  background: #ffffff;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
}
.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-primary);
  line-height: 1.2;
}
.stat-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-gray-500);
  margin-top: 6rpx;
}

/* ===== 分组标题 ===== */
.group-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 8rpx 40rpx 16rpx;
}
.group-dot { width: 14rpx; height: 14rpx; border-radius: 50%; }
.group-dot.registering { background: #16a34a; }
.group-dot.in_progress { background: #0891b2; }
.group-dot.draft { background: #f59e0b; }
.group-dot.finished { background: #94a3b8; }
.group-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-gray-800);
}
.group-count {
  font-size: 22rpx;
  color: var(--color-gray-400);
}

/* ===== 赛事卡片（发光边框 + 横向信息卡） ===== */
.match-card {
  position: relative;
  border-radius: var(--radius-lg);
  padding: 28rpx 30rpx;
  margin: 0 40rpx 20rpx;
  border: 1rpx solid transparent;
  background: linear-gradient(var(--color-card), var(--color-card)) padding-box,
              linear-gradient(135deg, rgba(8, 145, 178, 0.55), rgba(20, 184, 166, 0.18), rgba(8, 145, 178, 0.55)) border-box;
  animation: card-glow 3s ease-in-out infinite alternate;
  transition: transform 0.2s ease;
}
.match-card:active {
  transform: scale(0.98);
}
@keyframes card-glow {
  from { box-shadow: 0 0 18rpx rgba(8, 145, 178, 0.10); }
  to   { box-shadow: 0 0 42rpx rgba(8, 145, 178, 0.28); }
}

.mc-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.mc-name-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.mc-type {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.08);
  color: var(--color-gray-600);
  flex-shrink: 0;
}
.mc-type.major { background: rgba(52, 211, 153, 0.15); color: #34d399; }
.mc-type.freshman { background: rgba(8, 145, 178, 0.15); color: #0891b2; }

.mc-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-gray-900);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mc-badge {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.08);
  color: var(--color-gray-600);
  flex-shrink: 0;
}
.mc-badge.st-registering { background: rgba(52, 211, 153, 0.15); color: #16a34a; }
.mc-badge.st-in_progress { background: rgba(8, 145, 178, 0.15); color: #0891b2; }
.mc-badge.st-finished   { background: rgba(15, 23, 42, 0.08); color: var(--color-gray-500); }
.mc-badge.st-draft      { background: rgba(245, 158, 11, 0.15); color: #b45309; }

.mc-desc {
  display: block;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--color-gray-500);
  margin-bottom: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mc-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.mc-progress {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.mc-track {
  height: 10rpx;
  background: var(--color-gray-100);
  border-radius: 999rpx;
  overflow: hidden;
}

.mc-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #0891b2, #0e7490);
}

.mc-progress-text {
  font-size: 22rpx;
  color: var(--color-gray-500);
}

.mc-team-size {
  font-size: 24rpx;
  color: var(--color-gray-500);
  flex-shrink: 0;
}

/* 空状态 */
.empty {
  padding: 140rpx 40rpx;
}
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.empty-ic {
  width: 96rpx;
  height: 96rpx;
  opacity: 0.5;
}
.empty-title {
  font-size: 30rpx;
  color: var(--color-gray-500);
  font-weight: 600;
}
.empty-sub {
  font-size: 24rpx;
  color: var(--color-gray-400);
}
