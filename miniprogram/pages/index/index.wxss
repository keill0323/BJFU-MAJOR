.page { padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.home-content { padding: 28rpx 28rpx 0; }
.player-card { position: relative; overflow: hidden; padding: 32rpx; border-radius: 30rpx; background: linear-gradient(115deg,#102a43,#124d5c); color: #fff; }
.hero-mark { position: absolute; width: 328rpx; height: 328rpx; right: -24rpx; top: 14rpx; opacity: .11; transform: rotate(-12deg); }
.hero-topline, .hero-bottom, .player-bottom { position: relative; display: flex; justify-content: space-between; align-items: center; }
.hero-eyebrow { font-size: 18rpx; letter-spacing: 2.2rpx; color: #a4d6d8; font-weight: 600; }
.hero-live-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #61ded1; }
.guest-copy { position: relative; margin: 34rpx 0 36rpx; }
.hero-title { display: block; font-size: 48rpx; font-weight: 800; letter-spacing: 1rpx; }
.hero-sub { display: block; margin-top: 10rpx; font-size: 26rpx; color: #c0d5df; }
.hero-bottom { flex-wrap: wrap; gap: 16rpx; }
.hero-join { font-size: 23rpx; font-weight: 600; padding: 14rpx 18rpx; border-radius: 14rpx; background: #dcf8f2; color: #123f4b; }
.hero-join text { margin-left: 16rpx; }.hero-note { font-size: 19rpx; color: #acced7; }
.player-identity { display: flex; align-items: center; gap: 20rpx; position: relative; margin: 30rpx 0; }
.player-avatar { width: 100rpx; height: 100rpx; flex-shrink: 0; border: 2rpx solid #82c6c7; border-radius: 26rpx; background: #235768; }
.avatar-fallback { display: flex; align-items: center; justify-content: center; }.avatar-fallback image { width: 68rpx; height: 68rpx; }
.player-copy { flex: 1; min-width: 0; }.player-name { display: block; font-size: 38rpx; font-weight: 750; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.player-state { display: block; font-size: 22rpx; color: #b9d5df; margin-top: 7rpx; }.player-arrow { font-size: 40rpx; color: #8fc5ce; }
.player-bottom { border-top: 1rpx solid rgba(208,239,241,.18); padding-top: 22rpx; align-items: flex-end; }
.hero-metric-label { display: block; font-size: 20rpx; color: #b1cdd7; }.hero-rank { display: block; font-size: 30rpx; color: #f3d59b; font-weight: 700; margin-top: 6rpx; }
.hero-rating { text-align: right; }.hero-number { display: block; font-size: 44rpx; line-height: 1.2; font-weight: 750; color: #fff; }
.hero-rank-detail { display: flex; align-items: center; gap: 16rpx; flex: 1; min-width: 0; margin-right: 20rpx; }
.hero-rank-icon { display: block; width: 86rpx; height: 100rpx; flex-shrink: 0; }
.hero-rank-copy { min-width: 0; }.hero-rank { word-break: break-all; }.hero-rating { flex-shrink: 0; }
.shortcut-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 28rpx; background: #fff; border: 1rpx solid #e2ebf0; border-radius: 26rpx; padding: 26rpx 8rpx; margin-top: 24rpx; }
.shortcut { flex: 1; min-width: 0; display: flex; align-items: center; flex-direction: column; font-size: 23rpx; font-weight: 600; color: #304d64; white-space: nowrap; }
.shortcut-icon { width: 78rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; background: #edf7f7; border-radius: 20rpx; margin-bottom: 12rpx; }
.shortcut-icon image { width: 42rpx; height: 42rpx; }.shortcut:active .shortcut-icon { background: #d5eeed; }
.personal-notice { margin-top: 24rpx; padding: 24rpx; border: 1rpx solid #bcdde1; border-radius: 24rpx; background: #eff9f8; }
.personal-notice-head { display: flex; justify-content: space-between; align-items: center; color: #125965; font-size: 28rpx; font-weight: 700; }
.personal-badge { padding: 4rpx 14rpx; background: #087f8c; color: #fff; font-size: 22rpx; border-radius: 99rpx; }
.personal-task { display: flex; justify-content: space-between; align-items: center; padding-top: 20rpx; font-size: 26rpx; color: #234c60; }
.personal-count { margin-left: 8rpx; font-weight: 800; color: #b44935; }.personal-link,.personal-retry { color: #087f8c; font-size: 24rpx; }.personal-retry { margin-top: 16rpx; }
.section-heading { display: flex; justify-content: space-between; align-items: flex-end; margin: 42rpx 2rpx 22rpx; }
.section-kicker { display: block; font-size: 18rpx; color: #62798c; letter-spacing: 2rpx; font-weight: 600; }.section-title { display: block; font-size: 38rpx; color: #102a43; font-weight: 800; margin-top: 4rpx; }
.rules-link { font-size: 23rpx; color: #527187; padding: 12rpx 0 8rpx 16rpx; }.rules-link text { color: #087f8c; margin-left: 8rpx; }
.search-bar { display: flex; align-items: center; gap: 14rpx; background: #fff; border: 1rpx solid #dce7ed; border-radius: 18rpx; padding: 8rpx 10rpx 8rpx 22rpx; }
.search-ic { width: 32rpx; height: 32rpx; flex-shrink: 0; }.search-input { flex: 1; min-width: 0; height: 64rpx; font-size: 25rpx; }.search-placeholder { color: #8193a3; }
.search-submit { padding: 12rpx 18rpx; color: #087f8c; background: #edf7f7; border-radius: 12rpx; font-size: 23rpx; font-weight: 600; }.clear-search { padding: 8rpx; color: #62798c; font-size: 30rpx; }
.filter-row { display: flex; gap: 12rpx; margin: 22rpx 0 30rpx; }.filter { flex: 1; text-align: center; border-radius: 14rpx; padding: 14rpx 4rpx; color: #62798c; font-size: 25rpx; }.filter.active { background: #102a43; color: #fff; font-weight: 600; }
.group-title { display: flex; align-items: center; gap: 12rpx; margin: 28rpx 2rpx 16rpx; font-size: 23rpx; color: #4c657a; }
.group-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #8193a3; }.group-dot.registering { background: #18825e; }.group-dot.in_progress { background: #09b4b0; }.group-dot.draft { background: #b88837; }
.group-count { font-size: 20rpx; color: #8193a3; }.group-line { flex: 1; height: 1rpx; background: #dfe8ed; margin-left: 8rpx; }
.match-card { padding: 26rpx; margin-bottom: 22rpx; border-radius: 26rpx; border: 1rpx solid #e2ebf0; background: #fff; box-shadow: 0 6rpx 18rpx rgba(16,42,67,.025); }.match-card:active { background: #faffff; }
.mc-main { display: flex; gap: 22rpx; align-items: flex-start; }.event-emblem { flex-shrink: 0; width: 112rpx; height: 140rpx; border-radius: 20rpx; background: #173b51; display: flex; flex-direction: column; align-items: center; justify-content: center; }.event-emblem.freshman { background: #0c5963; }
.event-emblem image { width: 76rpx; height: 78rpx; }.event-emblem text { color: #c1e3e3; font-size: 15rpx; letter-spacing: 2rpx; margin-top: 6rpx; font-weight: 600; }
.mc-copy { flex: 1; min-width: 0; }.mc-labels { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; margin-bottom: 10rpx; }.mc-type { font-size: 20rpx; color: #62798c; }
.mc-badge { padding: 3rpx 12rpx; font-size: 19rpx; border-radius: 7rpx; background: #edf2f5; color: #62798c; }.st-registering { background: #e8f5ed; color: #18734f; }.st-in_progress { background: #e7f5f5; color: #087782; }.st-draft { background: #fbf1e4; color: #985b15; }
.mc-name { display: block; font-size: 31rpx; line-height: 1.45; font-weight: 750; color: #102a43; word-break: break-all; }.mc-timing { display: block; margin-top: 12rpx; font-size: 21rpx; color: #62798c; }
.mc-desc { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; font-size: 24rpx; line-height: 1.7; color: #62798c; margin: 20rpx 0 0; word-break: break-all; }
.mc-foot { display: flex; align-items: center; gap: 28rpx; border-top: 1rpx solid #edf2f5; padding-top: 22rpx; margin-top: 22rpx; }.mc-capacity { flex: 1; min-width: 0; }
.mc-count { font-size: 29rpx; font-weight: 750; color: #18364e; }.mc-limit { font-size: 21rpx; color: #62798c; }.mc-size { font-size: 20rpx; color: #62798c; margin-left: 14rpx; }
.mc-track { background: #edf3f6; height: 6rpx; border-radius: 6rpx; margin-top: 10rpx; overflow: hidden; }.mc-fill { height: 100%; background: #09b4b0; border-radius: 6rpx; }
.mc-action { flex-shrink: 0; font-size: 23rpx; font-weight: 600; color: #087f8c; padding: 17rpx 18rpx; border-radius: 14rpx; background: #edf7f7; }.mc-action.open { background: #087f8c; color: #fff; }.mc-action text { font-size: 28rpx; margin-left: 8rpx; }
.empty { padding: 54rpx 24rpx; background: #fff; border: 1rpx solid #e2ebf0; border-radius: 26rpx; }.empty-symbol { width: 86rpx; height: 86rpx; background: #163f52; border-radius: 24rpx; display: flex; align-items: center; justify-content: center; margin: 0 auto 24rpx; }.empty-symbol image { width: 58rpx; height: 58rpx; }
.empty-title { display: block; font-size: 29rpx; font-weight: 600; color: #304d64; }.empty-sub { display: block; font-size: 23rpx; color: #62798c; margin-top: 10rpx; }.empty-reset { display: inline-block; font-size: 25rpx; color: #087f8c; padding: 20rpx; margin-top: 14rpx; }
.list-notice, .list-loading { padding: 50rpx 20rpx; text-align: center; font-size: 26rpx; color: #62798c; }.list-notice view { padding: 18rpx; color: #087f8c; }
.home-footer { display: flex; align-items: center; gap: 18rpx; margin: 40rpx 24rpx 12rpx; font-size: 19rpx; letter-spacing: 1rpx; color: #8193a3; }.home-footer view { flex: 1; height: 1rpx; background: #dce7ed; }
@media (max-width: 350px) { .home-content { padding-left: 22rpx; padding-right: 22rpx; }.mc-foot { gap: 16rpx; }.mc-size { display: block; margin-left: 0; }.hero-note { display: none; }.hero-title { font-size: 46rpx; } }

.admin-inbox-task { background: #fff5df; border-radius: 14rpx; padding: 20rpx; margin-top: 18rpx; color: #865d19; gap: 16rpx; }
.admin-inbox-task > view { flex: 1; min-width: 0; }
.admin-inbox-task .personal-link { flex-shrink: 0; }
.admin-notice-preview { display: block; font-size: 24rpx; font-weight: 400; margin-top: 10rpx; color: #957638; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
