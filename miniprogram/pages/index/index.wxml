<view class="page">
  <nav-drawer title="赛事"></nav-drawer>
  <view class="search-bar">
    <image class="search-ic" src="/images/icons/search.svg"/>
    <input class="search-input" placeholder="搜索赛事..." value="{{keyword}}" bindinput="onSearchInput" bindconfirm="onSearch"/>
  </view>

  <!-- 统计概览 -->
  <view class="stat-bar">
    <view class="stat">
      <text class="stat-num">{{total}}</text>
      <text class="stat-label">全部赛事</text>
    </view>
    <view class="stat">
      <text class="stat-num">{{registeringCount}}</text>
      <text class="stat-label">报名中</text>
    </view>
    <view class="stat">
      <text class="stat-num">{{inProgressCount}}</text>
      <text class="stat-label">进行中</text>
    </view>
  </view>

  <!-- 分组赛事列表 -->
  <block wx:for="{{groups}}" wx:key="status">
    <block wx:if="{{item.matches.length > 0}}">
      <view class="group-title">
        <view class="group-dot {{item.status}}"></view>
        <text class="group-name">{{item.title}}</text>
        <text class="group-count">{{item.matches.length}}</text>
      </view>
      <view wx:for="{{item.matches}}" wx:key="id" wx:for-item="m" class="match-card" bindtap="goMatch" data-id="{{m.id}}">
        <view class="mc-top">
          <view class="mc-name-wrap">
            <text wx:if="{{m.typeLabel}}" class="mc-type {{m.match_type}}">{{m.typeLabel}}</text>
            <text class="mc-name">{{m.name}}</text>
          </view>
          <view class="mc-badge st-{{m.status}}">{{m.statusText}}</view>
        </view>
        <text wx:if="{{m.description}}" class="mc-desc">{{m.description}}</text>
        <view class="mc-foot">
          <view class="mc-progress">
            <view class="mc-track">
              <view class="mc-fill" style="width: {{m.progress}}%"></view>
            </view>
            <text class="mc-progress-text">{{m.registered_count || 0}}/{{m.max_teams || 16}} 队伍</text>
          </view>
          <text class="mc-team-size">每队 {{m.team_size || 5}} 人</text>
        </view>
      </view>
    </block>
  </block>

  <view wx:if="{{matches.length === 0}}" class="empty">
    <view class="empty-box">
      <image class="empty-ic" src="/images/icons/search.svg"/>
      <text class="empty-title">暂无赛事</text>
      <text class="empty-sub">下拉刷新，或换个关键词搜索</text>
    </view>
  </view>
</view>
