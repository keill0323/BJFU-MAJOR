.page {
  padding: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 20rpx;
}

.input {
  background: var(--color-gray-100);
  border-radius: var(--radius-md);
  padding: 20rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

/* 信息卡片：两栏网格 */
.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.info-cell {
  background: var(--color-row);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
}

.info-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-gray-500);
  margin-bottom: 8rpx;
}

.info-value {
  display: block;
  font-size: 28rpx;
  color: var(--color-gray-800);
  font-weight: 600;
}

.text-green { color: var(--color-success); }
.text-red { color: var(--color-danger); }

.edit-btn {
  margin-top: 24rpx;
}

/* 原生 button 默认样式重置（open-type=chooseAvatar 用） */
button.edit-btn {
  line-height: 1.6;
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 30rpx;
  margin-left: 0;
  margin-right: 0;
}
button.edit-btn::after {
  border: none;
}

/* 在校认证上传区 */
.verify-box {
  margin-top: 24rpx;
  background: var(--color-row);
  border: 1rpx dashed var(--color-border);
  border-radius: var(--radius-md);
  padding: 24rpx;
}

.verify-tip {
  display: block;
  font-size: 24rpx;
  color: var(--color-gray-500);
  margin-bottom: 16rpx;
}

.verify-img-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.verify-thumb {
  width: 160rpx;
  height: 220rpx;
  border-radius: var(--radius-md);
  background: var(--color-gray-100);
}

/* AI 审核结果 */
.ai-review {
  margin-top: 24rpx;
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--color-border);
}

.ai-pass {
  background: rgba(47, 206, 122, 0.08);
  border-color: rgba(47, 206, 122, 0.35);
}

.ai-reject {
  background: rgba(239, 68, 68, 0.08);
  border-color: rgba(239, 68, 68, 0.35);
}

.ai-pending {
  background: rgba(245, 158, 11, 0.08);
  border-color: rgba(245, 158, 11, 0.35);
}

.ai-review-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.ai-review-status {
  font-size: 28rpx;
  font-weight: 600;
}

.ai-pass .ai-review-status { color: var(--color-success); }
.ai-reject .ai-review-status { color: var(--color-danger); }
.ai-pending .ai-review-status { color: #d97706; }

.ai-review-conf {
  font-size: 24rpx;
  color: var(--color-gray-500);
}

.ai-review-reason {
  display: block;
  font-size: 24rpx;
  color: var(--color-gray-600);
  line-height: 1.5;
}

/* 顶部用户卡（深绿渐变 + 亮绿描边，电竞感） */
.profile-hero {
  margin: 20rpx;
  background: linear-gradient(135deg, #1a4a41 0%, #133a35 60%, #102f2a 100%);
  border: 1rpx solid rgba(47, 206, 122, 0.25);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
  box-shadow: var(--shadow-card);
}

.avatar {
  position: relative;
  z-index: 1;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(47, 206, 122, 0.14);
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.hero-info {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
}

.hero-name {
  color: var(--color-gray-900);
  font-size: 40rpx;
  font-weight: 700;
}

.hero-id {
  color: var(--color-gray-500);
  font-size: 26rpx;
}

.hero-badges {
  display: flex;
  gap: 12rpx;
  margin-top: 6rpx;
}

.hero-badge {
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
  font-size: 20rpx;
}
.hero-badge-ok { background: var(--color-primary-light); color: var(--color-primary); }
.hero-badge-no { background: var(--color-gray-100); color: var(--color-gray-500); }
.hero-badge-role { background: var(--color-gray-100); color: var(--color-gray-700); }

/* 功能菜单项 */
.menu-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 24rpx;
}

.menu-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--color-gray-800);
  font-weight: 500;
}

.menu-arrow {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.info-hint {
  color: var(--color-primary);
  font-size: 26rpx;
}

.about-text {
  font-size: 26rpx;
  color: var(--color-gray-500);
}

.logout-btn {
  margin: 40rpx 20rpx;
}

.empty-text {
  display: block;
  text-align: center;
  color: var(--color-gray-500);
  font-size: 28rpx;
}

/* 邀请入口 */
.invite-entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
}

.invite-badge {
  background: var(--color-danger);
  color: #fff;
  border-radius: 20rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
}

/* 邀请弹层 */
.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.invite-panel {
  background: var(--color-card);
  border-radius: 20rpx 20rpx 0 0;
  width: 100%;
  max-height: 70vh;
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.invite-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.invite-close {
  width: 40rpx;
  height: 40rpx;
  padding: 10rpx;
}

.invite-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.invite-info {
  flex: 1;
}

.invite-team {
  font-size: 28rpx;
  font-weight: bold;
  display: block;
}

.invite-msg {
  font-size: 24rpx;
  color: var(--color-gray-500);
  display: block;
  margin-top: 4rpx;
}

.invite-actions {
  display: flex;
  gap: 12rpx;
}

.small-btn {
  font-size: 24rpx;
  padding: 10rpx 24rpx;
}
