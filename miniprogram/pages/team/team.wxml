<nav-drawer title="我的队伍"></nav-drawer>

<view class="page">
<view wx:if="{{myTeam}}">
  <!-- 队伍信息卡片 -->
  <view class="card">
    <view class="team-head">
      <view class="team-logo-box" bindtap="uploadLogo">
        <image wx:if="{{myTeam.logo_full}}" class="team-logo" src="{{myTeam.logo_full}}" mode="aspectFill"/>
        <text wx:else class="team-logo-initial">{{myTeam.logo_initial}}</text>
        <view wx:if="{{isCaptain}}" class="team-logo-edit"><text>更换</text></view>
      </view>
      <view class="team-head-info">
        <view class="team-top">
          <text class="team-name">{{myTeam.name}}</text>
          <text class="tag tag-green">状态: {{myTeam.status}}</text>
        </view>
        <text class="team-desc">{{myTeam.description || '暂无简介'}}</text>
      </view>
    </view>
  </view>

  <!-- 成员列表 -->
  <view class="card">
    <text class="section-title">成员 ({{members.length}}/{{myTeam.member_count || members.length}})</text>
    <view wx:for="{{members}}" wx:key="id" class="member-row">
      <image class="member-avatar" src="{{item.avatar_full || '/images/icons/gamepad.svg'}}"/>
      <view class="member-info">
        <view class="member-name-col">
          <view class="member-name-row">
            <text class="member-name">{{item.nickname || '玩家' + item.user_id}}</text>
            <text class="tag {{item.role === 'captain' ? 'tag-orange' : 'tag-gray'}}">{{item.role === 'captain' ? '队长' : '队员'}}</text>
          </view>
          <text class="member-meta">游戏ID: {{item.game_id || '未设置'}} · 段位: {{item.display_rank || '未设置'}}</text>
        </view>
      </view>
      <view wx:if="{{isCaptain && item.role !== 'captain'}}" class="btn-danger small-btn"
            bindtap="kickMember" data-uid="{{item.user_id}}" data-name="{{item.nickname || '该成员'}}">移除</view>
    </view>
  </view>

  <!-- 队长：待审核申请 -->
  <view wx:if="{{isCaptain && applications.length > 0}}" class="card">
    <text class="section-title">入队申请 ({{applications.length}})</text>
    <view wx:for="{{applications}}" wx:key="id" class="app-row">
      <view class="app-info">
        <text class="app-name">{{item.nickname || '玩家' + item.user_id}}</text>
        <text class="app-meta">游戏ID: {{item.game_id || '未设置'}} · ID: {{item.user_id}}</text>
        <text wx:if="{{item.message}}" class="app-msg">留言: {{item.message}}</text>
      </view>
      <view class="app-actions">
        <view class="btn-primary small-btn" bindtap="approveApp" data-id="{{item.id}}">同意</view>
        <view class="btn-danger small-btn" bindtap="rejectApp" data-id="{{item.id}}">拒绝</view>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions">
    <view wx:if="{{isCaptain}}" class="btn-outline" bindtap="openMarket">人才市场</view>
    <view wx:if="{{isCaptain}}" class="btn-outline" bindtap="openRecruit">邀请</view>
    <button class="btn-outline share-btn" open-type="share">分享队伍</button>
    <view class="btn-danger" bindtap="leaveTeam">退出队伍</view>
    <view wx:if="{{isCaptain}}" class="btn-danger" bindtap="disbandTeam">解散队伍</view>
  </view>

  <!-- 人才市场弹层 -->
  <view wx:if="{{showMarket}}" class="mask" bindtap="closeMarket">
    <view class="market-panel" catchtap="">
      <view class="market-header">
        <text class="section-title">人才市场</text>
        <image class="market-close" src="/images/icons/x.svg" bindtap="closeMarket"/>
      </view>
      <scroll-view scroll-x class="match-tabs">
        <view wx:for="{{marketMatches}}" wx:key="id"
              class="match-tab {{selectedMatchId === item.id ? 'active' : ''}}"
              bindtap="onMatchChange" data-id="{{item.id}}">{{item.name}}</view>
      </scroll-view>
      <view wx:if="{{freePlayers.length === 0}}" class="empty">该赛事暂无自由人</view>
      <view wx:for="{{freePlayers}}" wx:key="id" class="player-row">
        <view class="player-info">
          <view class="player-name-row">
            <text class="player-name">{{item.nickname || '玩家' + item.id}}</text>
            <text wx:if="{{item.display_rank}}" class="tag tag-green">{{item.display_rank}}</text>
          </view>
          <text class="player-meta">游戏ID: {{item.game_id || '未设置'}}</text>
        </view>
        <view class="btn-primary small-btn" bindtap="pullPlayer"
              data-uid="{{item.id}}" data-name="{{item.nickname || '该玩家'}}">邀请</view>
      </view>
    </view>
  </view>
</view>

<view wx:else>
  <view class="card">
    <text class="section-title">创建队伍</text>
    <input class="team-input" placeholder="输入队名（最多20字）" value="{{teamName}}" bindinput="onNameInput" maxlength="20"/>
    <view class="btn-primary" bindtap="createTeam">创建队伍</view>
  </view>
</view>
</view>
