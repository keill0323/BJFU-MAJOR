<nav-drawer title="招募大厅"></nav-drawer>
<view class="recruitment-page">
  <view class="hero"><text class="headline">招募大厅</text><text class="hero-copy">找队伍、找队友，无需先报名赛事。</text></view>
  <view class="directory-tabs"><view class="directory-tab {{tab === 'players' ? 'selected' : ''}}" bindtap="switchTab" data-tab="players">全部选手</view><view class="directory-tab {{tab === 'posts' ? 'selected' : ''}}" bindtap="switchTab" data-tab="posts">队伍招募</view></view>
  <view wx:if="{{tab === 'players'}}" class="player-search"><input value="{{keyword}}" bindinput="onKeyword" bindconfirm="searchPlayers" placeholder="搜索昵称或游戏 ID" maxlength="64" confirm-type="search"/><button class="secondary" bindtap="searchPlayers">搜索</button></view>
  <view wx:if="{{tab === 'players'}}" class="player-filters">
    <view wx:if="{{rankFilter || identityFilter}}" class="filter-heading"><text>已选筛选</text><button class="filter-clear" bindtap="clearPlayerFilters">清除筛选</button></view>
    <view class="filter-pickers">
      <picker class="filter-picker" mode="selector" range="{{rankOptions}}" range-key="label" value="{{rankIndex}}" bindchange="onRankFilter"><view class="filter-control {{rankFilter ? 'active' : ''}}"><view><text>{{rankOptions[rankIndex].label}}</text><text class="filter-arrow">⌄</text></view></view></picker>
      <picker class="filter-picker" mode="selector" range="{{identityOptions}}" range-key="label" value="{{identityIndex}}" bindchange="onIdentityFilter"><view class="filter-control {{identityFilter ? 'active' : ''}}"><view><text>{{identityOptions[identityIndex].label}}</text><text class="filter-arrow">⌄</text></view></view></picker>
    </view>
    <text wx:if="{{rankFilter || identityFilter}}" class="filter-summary">{{rankOptions[rankIndex].label}} · {{identityOptions[identityIndex].label}}{{query ? ' · 搜索「' + query + '」' : ''}}</text>
  </view>
  <view wx:if="{{loading && tab === 'posts'}}" class="state">正在加载招募大厅…</view>
  <block wx:elif="{{tab === 'players'}}">
    <text class="directory-caption">未报名、已入队的选手也会展示。新老生身份以认证结果为准。</text>
    <view wx:if="{{accountFailed}}" class="state compact" bindtap="load">队伍信息加载失败，重试后可邀请选手</view>
    <view wx:if="{{playersLoading}}" class="state">正在查找符合条件的选手…</view>
    <view wx:elif="{{playersFailed}}" class="state"><text>{{playersError}}</text><button class="secondary filter-retry" bindtap="loadPlayers">重新加载选手</button></view>
    <view wx:elif="{{players.length === 0}}" class="state">{{query || rankFilter || identityFilter ? '没有找到符合条件的选手，试试调整筛选或关键词' : '暂时没有可展示的选手'}}</view>
    <block wx:else>
      <view wx:for="{{players}}" wx:key="id" class="post">
        <view class="post-head"><view class="emblem"><image wx:if="{{item.avatarFull}}" src="{{item.avatarFull}}" mode="aspectFill"/><text wx:else>{{item.initial}}</text></view><view class="team-copy"><text class="team-name">{{item.displayName}}</text><text class="muted">游戏 ID：{{item.game_id || '未设置'}}</text></view></view>
        <view class="player-labels"><text class="identity-label {{item.identity === 'new_student' ? 'new-student' : ''}}">{{item.identityText}}</text><text>{{item.displayRank}}</text><text>{{item.individual_rating}} 水平分</text></view>
        <text wx:if="{{item.user_description}}" class="post-content {{expandedPlayerId === item.id ? '' : 'description-clamped'}}">{{item.user_description}}</text><text wx:if="{{item.descriptionLong}}" class="description-toggle" bindtap="toggleDescription" data-kind="player" data-id="{{item.id}}">{{expandedPlayerId === item.id ? '收起介绍' : '展开介绍'}}</text>

        <view class="post-foot"><text class="muted">{{item.has_team ? (item.team_name || '已入队') : '未加入队伍'}}</text><button wx:if="{{mine && !accountFailed && !item.has_team}}" class="apply" bindtap="invite" data-id="{{item.id}}" disabled="{{!!inviting}}" loading="{{inviting === item.id}}">邀请入队</button><button wx:else class="apply" bindtap="contactPlayer" data-id="{{item.id}}">{{token ? '联系选手' : '登录联系'}}</button><text wx:if="{{mine && !accountFailed && !item.has_team}}" class="contact-link" bindtap="contactPlayer" data-id="{{item.id}}">先聊聊 ›</text></view>
      </view>
      <view wx:if="{{playersMore}}" class="state compact" bindtap="loadMorePlayers">{{playersLoadingMore ? '正在加载…' : '查看更多选手'}}</view>
    </block>
  </block>
  <block wx:else>
    <view wx:if="{{accountFailed}}" class="manage"><text>你的队伍信息加载失败，重试后即可操作。</text><button class="secondary" bindtap="load">重新加载</button></view>
    <view wx:elif="{{mine}}" class="manage">
      <view class="section-top"><text class="section-title">{{mine.team_name}}</text><text class="status">{{mine.is_active ? '正在招募' : '未发布招募'}}</text></view>
      <text class="muted">{{mine.can_publish ? '写下所需位置、段位和在线时段，让合适的队友找到你。阵容齐了，记得关闭招募。' : '队伍审核通过后即可发布，无需先报名赛事。'}}</text>
      <block wx:if="{{editing}}"><textarea class="editor" value="{{draft}}" bindinput="onDraft" maxlength="500" placeholder="例如：缺一名步枪手，B 段左右，平日晚上可训练。欢迎先组队磨合！" placeholder-class="placeholder"/><text class="counter">{{draft.length}} / 500</text><view class="actions"><button class="secondary" bindtap="cancelEdit" disabled="{{saving}}">取消</button><button class="primary" bindtap="save" loading="{{saving}}" disabled="{{saving}}">发布招募</button></view></block>
      <view wx:elif="{{mine.can_publish}}" class="actions"><button wx:if="{{mine.is_active}}" class="secondary" bindtap="closePost" disabled="{{saving}}">关闭招募</button><button class="primary" bindtap="edit">{{mine.is_active ? '编辑招募' : '发布招募'}}</button></view>
    </view>
    <view wx:else class="join-banner" bindtap="goTeam"><view><text class="section-title">{{myTeam ? '查看我的队伍' : '想组建自己的队伍？'}}</text><text class="muted">{{myTeam ? '招募由队长发布和管理' : '创建队伍，审核通过后发布招募'}}</text></view><text class="arrow">›</text></view>
    <view class="feed-heading"><text class="section-title">队伍招募</text><text class="muted">寻找并肩作战的人</text></view>
    <view wx:if="{{failed}}" class="state" bindtap="load">招募加载失败 · 点击重试</view>
    <view wx:elif="{{posts.length === 0}}" class="state">暂时没有招募，成为第一个发起者吧。</view>
    <block wx:else>
      <view wx:for="{{posts}}" wx:key="team_id" class="post">
        <view class="post-head"><view class="emblem"><image wx:if="{{item.logoFull}}" src="{{item.logoFull}}" mode="aspectFill"/><text wx:else>{{item.initial}}</text></view><view class="team-copy"><text class="team-name">{{item.team_name}}</text><text class="muted">{{item.member_count}} 名队员 · 水平分 {{item.rating || 0}}</text></view><text class="tag">招募中</text></view>
        <text class="post-content {{expandedPostId === item.team_id ? '' : 'description-clamped'}}" selectable>{{item.content}}</text><text wx:if="{{item.descriptionLong}}" class="description-toggle" bindtap="toggleDescription" data-kind="post" data-id="{{item.team_id}}">{{expandedPostId === item.team_id ? '收起招募' : '展开招募'}}</text>

        <view class="post-foot"><text class="timestamp">更新于 {{item.timeText}}</text><button wx:if="{{!myTeam}}" class="apply" bindtap="apply" data-id="{{item.team_id}}" disabled="{{accountFailed || !!applying || item.applied}}" loading="{{applying === item.team_id}}">{{item.applied ? '申请已提交' : token ? '申请入队' : '登录申请'}}</button><button wx:elif="{{myTeam.id === item.team_id}}" class="secondary" bindtap="goTeam">我的队伍</button><button wx:else class="apply" bindtap="contactTeam" data-id="{{item.team_id}}">联系队长</button><text wx:if="{{!myTeam && token}}" class="contact-link" bindtap="contactTeam" data-id="{{item.team_id}}">先聊聊 ›</text></view>
      </view>
      <view wx:if="{{more}}" class="state compact" bindtap="loadMore">{{loadingMore ? '正在加载…' : '查看更多招募'}}</view>
    </block>
  </block>
</view>
<subscribe-notice></subscribe-notice>
