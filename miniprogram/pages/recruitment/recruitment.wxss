.recruitment-page { padding: 24rpx; }
.player-filters { margin-bottom: 24rpx; padding: 24rpx; background: #fff; border: 1rpx solid #dfe9ee; border-radius: 22rpx; }
.filter-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 54rpx; color: #17384f; font-size: 27rpx; font-weight: 700; }
.filter-clear { background: transparent; color: #087f8c; font-weight: 500; font-size: 24rpx; padding: 12rpx 0 12rpx 16rpx; }
.filter-pickers { display: flex; gap: 16rpx; margin-top: 16rpx; }
.filter-picker { flex: 1; min-width: 0; }
.filter-control { min-height: 110rpx; padding: 16rpx 18rpx; border: 1rpx solid #cadce3; border-radius: 16rpx; color: #23495f; background: #f7fafb; box-sizing: border-box; }
.filter-control.active { border-color: #69b5b9; background: #ebf8f6; color: #076d76; }
.filter-label { display: block; font-size: 22rpx; color: #607c8d; margin-bottom: 7rpx; }
.filter-control > view { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; font-size: 25rpx; font-weight: 650; line-height: 1.5; }
.filter-control > view > text:first-child { min-width: 0; word-break: break-all; }
.filter-arrow { flex-shrink: 0; color: #087f8c; font-size: 28rpx; }
.filter-summary { display: block; margin-top: 18rpx; font-size: 24rpx; line-height: 1.7; color: #507186; word-break: break-all; }
.filter-retry { margin: 24rpx auto 0; width: 300rpx; max-width: 100%; min-height: 88rpx; }
.hero { padding: 36rpx; border-radius: 28rpx; background: linear-gradient(125deg,#102e43,#096d78); color: #fff; overflow: hidden; }
.eyebrow { display: block; font-size: 20rpx; letter-spacing: 4rpx; color: #91e6df; font-weight: 700; }
.headline { display: block; margin: 16rpx 0; font-size: 58rpx; font-weight: 800; letter-spacing: 2rpx; }
.hero-copy { display: block; color: #d3e6ed; font-size: 27rpx; line-height: 1.8; }.hero-copy text { display: block; }
.hero-rule { display: flex; align-items: center; gap: 18rpx; margin-top: 34rpx; color: #90bec8; font-size: 18rpx; letter-spacing: 2rpx; }.hero-rule view { height: 1rpx; flex: 1; background: #5c9da8; }
.manage,.join-banner,.post { margin-top: 24rpx; background: #fff; padding: 28rpx; border: 1rpx solid #dfe9ee; border-radius: 24rpx; }
.section-top,.join-banner,.feed-heading { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.section-title { font-weight: 700; font-size: 30rpx; color: #14334b; overflow-wrap: anywhere; }.muted { display: block; color: #62798c; font-size: 24rpx; line-height: 1.7; }.manage>.muted { margin-top: 12rpx; }
.status,.tag { flex-shrink: 0; font-size: 22rpx; color: #087f8c; background: #e8f6f4; padding: 6rpx 14rpx; border-radius: 8rpx; }.arrow { font-size: 44rpx; color: #087f8c; }
.actions { display: flex; gap: 16rpx; margin-top: 24rpx; }.actions button { flex: 1; }
button { margin: 0; padding: 18rpx 22rpx; font-size: 26rpx; line-height: 1.4; border-radius: 14rpx; }button::after { border: none; }
.primary,.apply { background: #087f8c; color: #fff; }.secondary { background: #edf5f6; color: #256374; }.manage>.secondary { margin-top: 16rpx; }
.editor { box-sizing: border-box; width: 100%; height: 280rpx; padding: 22rpx; margin-top: 24rpx; background: #f6f9fb; border: 1rpx solid #cadbe3; border-radius: 16rpx; font-size: 28rpx; line-height: 1.7; color: #18364e; }.placeholder { color: #7a8f9e; }.counter { display: block; margin-top: 8rpx; text-align: right; color: #6d8495; font-size: 22rpx; }
.feed-heading { margin: 36rpx 4rpx 0; }.post-head { display: flex; align-items: center; gap: 18rpx; }.emblem { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 80rpx; height: 80rpx; border-radius: 18rpx; background: #eaf1f5; color: #26536b; font-size: 36rpx; font-weight: 800; }.emblem image { width: 100%; height: 100%; border-radius: 18rpx; }.team-copy { flex: 1; min-width: 0; }.team-name { display: block; font-size: 30rpx; font-weight: 700; color: #15354d; overflow-wrap: anywhere; }
.post-content { display: block; white-space: pre-wrap; overflow-wrap: anywhere; margin: 26rpx 0; color: #304f65; font-size: 28rpx; line-height: 1.85; }.post-foot { display: flex; align-items: center; flex-wrap: wrap; gap: 16rpx; border-top: 1rpx solid #edf2f5; padding-top: 20rpx; }.timestamp { flex: 1; color: #778d9d; font-size: 20rpx; }.apply { flex-shrink: 0; font-size: 24rpx; }.state { padding: 64rpx 20rpx; color: #62798c; text-align: center; font-size: 26rpx; }.compact { padding: 30rpx; }

.directory-tabs { display: flex; gap: 12rpx; margin: 24rpx 0; background: #e4edf1; border-radius: 18rpx; padding: 8rpx; }.directory-tab { flex: 1; text-align: center; padding: 18rpx; border-radius: 14rpx; color: #4b697e; font-weight: 700; }.directory-tab.selected { background: #087f8c; color: white; }.player-search { display: flex; align-items: center; gap: 16rpx; margin: 24rpx 0; }.player-search input { flex: 1; min-width: 0; background: white; height: 78rpx; padding: 0 20rpx; border: 1rpx solid #cedee5; border-radius: 14rpx; color: #18364e; font-size: 26rpx; }.directory-caption { display: block; font-size: 24rpx; line-height: 1.7; color: #607c8d; }.player-labels { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 24rpx 0; }.player-labels text { background: #edf3f6; color: #456376; padding: 6rpx 14rpx; border-radius: 10rpx; font-size: 23rpx; }.player-labels .identity-label { background: #e8f2fc; color: #28587e; font-weight: 700; }.player-labels .new-student { color: #087366; background: #dcf5ec; }.post-foot { justify-content: space-between; }
