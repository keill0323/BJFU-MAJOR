<event-return />
<view class="page match-page">
  <view wx:if="{{!match}}" class="empty">{{loadFailed ? '赛事加载失败，请下拉重试' : '正在加载赛事…'}}</view>

  <block wx:else>
    <!-- 赛事 Hero -->
    <view class="hero {{match.status === 'in_progress' || match.status === 'finished' ? 'hero-compact' : ''}}">
      <view class="hero-orbit hero-orbit-one"></view>
      <view class="hero-orbit hero-orbit-two"></view>
      <view class="hero-top">
        <text class="hero-badge">BJFU / TOURNAMENT</text>
        <view class="hero-status st-{{match.status}}">
          <view class="hero-status-dot"></view>
          <text>{{match.statusText}}</text>
        </view>
      </view>
      <view class="hero-main">
        <view class="hero-copy">
          <text class="hero-type">{{match.match_type === 'freshman' ? '新生赛' : '校园赛事'}} · CS2</text>
          <text class="hero-title">{{match.name}}</text>
        </view>
        <view class="hero-emblem"><image src="/images/icons/trophy.svg" class="hero-trophy"/><text>MAJOR</text></view>
      </view>
      <text class="hero-desc">{{match.description || '集结队伍，在赛场见。'}}</text>
      <view class="hero-stats">
        <view class="hero-stat">
          <text class="hero-stat-num">{{teams.length}}<text class="hero-stat-den"> / {{match.max_teams || '不限'}}</text></text>
          <text class="hero-stat-label">参赛队伍</text>
        </view>
        <view class="hero-stat">
          <text class="hero-stat-num">{{match.team_size || '不限'}}</text>
          <text class="hero-stat-label">每队人数</text>
        </view>
        <view class="hero-stat">
          <text class="hero-stat-num">{{completedRoundCount}}<text class="hero-stat-den"> / {{roundCount}}</text></text>
          <text class="hero-stat-label">已完成对阵</text>
        </view>
      </view>
    </view>

    <!-- 报名区 -->
    <view wx:if="{{match.status === 'draft' || match.status === 'registering' || (myReg && (myReg.status === 'pending' || myReg.status === 'rejected'))}}" class="card register-card reg-{{myReg ? myReg.status : ''}}">
      <view class="register-heading"><text class="register-title">参赛报名</text><text class="register-caption">{{registerEndText ? '截止 ' + registerEndText : '集结你的校园战队'}}</text></view>
      <view wx:if="{{match.status === 'registering' && canRegisterTeam && !rosterLocked}}" class="btn-primary" bindtap="handleRegister">队伍报名</view>
      <view wx:elif="{{registered}}" class="register-done">
        <image class="register-icon" src="{{myReg.status === 'pending' ? '/images/icons/mail.svg' : myReg.status === 'rejected' ? '/images/icons/x-circle.svg' : '/images/icons/check-circle.svg'}}"/>
        <text>{{myReg.status === 'pending' ? '报名待审核' : myReg.status === 'rejected' ? '报名未通过' : '已报名'}}{{myReg.team_id ? ' · 随队伍' : ' · 个人'}}</text>
      </view>
      <view wx:elif="{{match.status === 'registering' && myTeam && rosterLocked}}" class="register-disabled">参赛名单已锁定，不再接受新队伍报名</view>
      <view wx:elif="{{match.status === 'registering' && myTeam && !isCaptain}}" class="register-disabled">你是队员，请队长发起队伍报名</view>
      <view wx:elif="{{match.status === 'registering'}}" class="btn-primary" bindtap="handleRegister">个人报名</view>
      <text wx:else class="register-disabled">{{match.status === 'draft' ? '赛事未开始' : match.status === 'in_progress' ? '赛事进行中' : match.status === 'finished' ? '赛事已结束' : match.status}}</text>
      <text wx:if="{{rosterLocked && (!myTeam || registered)}}" class="roster-note">参赛名单已锁定，不再接受新队伍报名</text>
    </view>

    <subscribe-notice wx:if="{{!myTeam && (match.status === 'registering' || registered)}}"></subscribe-notice>
    <view wx:if="{{myMatchSummary && mainTab === 'teams'}}" class="my-match-notice" data-tab="mine" data-jump="true" bindtap="switchTab" role="button" aria-label="查看本队对阵">
      <view class="match-notice-icon"><image src="/images/icons/swords.svg" /></view>
      <view class="match-notice-copy"><text class="match-notice-title">{{myMatchSummary.notice_title}}</text><text class="match-notice-meta">{{myMatchSummary.team_name}} · {{myMatchSummary.group_text}}</text></view>
      <text class="match-notice-link">查看 ›</text>
    </view>
    <view class="tabs event-main-tabs" id="match-content">
      <view class="tab {{mainTab === 'teams' ? 'active' : ''}}" data-tab="teams" bindtap="switchTab">赛事排名</view>
      <view class="tab {{mainTab === 'matches' ? 'active' : ''}}" data-tab="matches" bindtap="switchTab">比赛对阵</view>
      <view class="tab {{mainTab === 'stats' ? 'active' : ''}}" data-tab="stats" bindtap="switchTab">选手数据</view>
      <view class="tab {{mainTab === 'info' ? 'active' : ''}}" data-tab="info" bindtap="switchTab">赛事信息</view>
    </view>
    <!-- ===== 队伍 tab：统一赛事排名 ===== -->
    <view wx:if="{{mainTab === 'teams'}}" class="card standings-card">
      <text class="section-title">赛事排名</text>
      <text class="section-caption">按阶段与名次展示，同名次并列。点击队伍查看分阶段战绩。</text>
      <view wx:if="{{rankingTeams.length === 0}}" class="empty">暂无队伍</view>
      <view wx:for="{{rankingTeams}}" wx:key="team_id" class="standing-row" bindtap="showTeam" data-id="{{item.team_id}}">
        <view class="standing-main">
          <text class="standing-rank {{item.rank_weight < 2 ? 'standing-medal' : ''}}">{{item.rank_badge}}</text>
          <view class="standing-copy">
            <text class="team-name">{{item.team_name}}</text>
            <text class="standing-group">{{item.group_text}}</text>
            <view class="standing-tags">
              <text class="tag {{item.rank_weight < 2 ? 'tag-orange' : item.rank_weight >= 8 ? 'tag-gray' : 'tag-blue'}}">{{item.stage_text}}</text>
              <text wx:if="{{item.progress_text}}" class="standing-progress">{{item.progress_text}}</text>
            </view>
          </view>
          <image class="standing-arrow" src="/images/icons/chevron-right.svg"/>
        </view>
      </view>
    </view>

    <view wx:if="{{mainTab === 'matches'}}" class="card schedule-card matchup-card">
      <view class="matchup-filter-heading"><text class="section-title">比赛对阵</text><text class="group-overview-count">{{matchupCount}} 场</text></view>
      <view class="matchup-filters">
        <view class="matchup-filter-row">
          <picker class="matchup-filter-field matchup-stage-select" mode="selector" range="{{matchupStages}}" range-key="label" value="{{matchupStageIndex}}" bindchange="changeMatchupStagePicker">
            <view class="matchup-select-control"><view class="matchup-select-copy"><text class="matchup-field-label">比赛阶段</text><text class="matchup-field-value">{{matchupStages[matchupStageIndex].label}}</text></view><text class="matchup-select-arrow">⌄</text></view>
          </picker>
          <picker class="matchup-filter-field matchup-date-select" mode="selector" range="{{matchupDates}}" range-key="label" value="{{matchupDateIndex}}" bindchange="changeMatchupDate">
            <view class="matchup-select-control"><view class="matchup-select-copy"><text class="matchup-field-label">比赛日期</text><text class="matchup-field-value">{{matchupDates[matchupDateIndex].label}}</text></view><text class="matchup-select-arrow">⌄</text></view>
          </picker>
        </view>
        <picker wx:if="{{matchupGroups.length}}" class="matchup-group-select" mode="selector" range="{{matchupGroupChoices}}" range-key="label" value="{{matchupGroupIndex}}" bindchange="changeMatchupGroupPicker">
          <view class="matchup-select-control"><view class="matchup-select-copy"><text class="matchup-field-label">{{matchupStage === 'legend' ? '传奇分区' : '挑战者小组'}}</text><text class="matchup-field-value">{{matchupGroupChoices[matchupGroupIndex].label}}</text></view><text class="matchup-select-arrow">⌄</text></view>
        </picker>
        <view class="matchup-filter-footer">
          <text class="matchup-rule-note">{{matchupStage === 'challenger' ? '挑战者小组赛 · 双循环 BO1' : matchupStage === 'playoff' ? '附加赛 · 单循环 BO1' : matchupStage === 'legend' ? '传奇组 · 单循环 BO1' : matchupStage === 'knockout' ? '淘汰赛 · BO3' : '比赛时间由管理员统一安排'}}</text>
          <label wx:if="{{myMatchSummary}}" class="matchup-mine-toggle {{onlyMyTeam ? 'active' : ''}}"><switch class="matchup-mine-switch" type="checkbox" checked="{{onlyMyTeam}}" color="#087f8c" bindchange="toggleMyTeam"></switch><text>只看本队</text></label>
        </view>
      </view>
      <text wx:if="{{onlyMyTeam && myMatchSummary}}" class="matchup-own-caption">{{myMatchSummary.team_name}} · 本队在左，对手在右</text>
      <view wx:if="{{canShowBracket}}" class="schedule-view-switch"><text>{{showBracket ? '六强淘汰赛晋级路径' : '按开赛日期查看完整对阵'}}</text><button class="schedule-view-button" bindtap="toggleMatchupBracket">{{showBracket ? '返回赛程列表' : '查看晋级图'}}</button></view>
        <block wx:if="{{showBracket}}">
          <view class="bracket-legend"><view class="bracket-live-dot"></view><text>六强晋级图</text><text class="bracket-scroll-hint">左右滑动查看完整晋级路径 →</text></view>
          <scroll-view scroll-x class="bracket-scroll" scroll-into-view="{{focusedRoundId ? 'round-' + focusedRoundId : ''}}">
            <view class="bracket-board">
              <view wx:for="{{knockoutBracketColumns}}" wx:key="key" wx:for-item="column" class="bracket-column bracket-column-{{column.key}}">
                <view class="bracket-column-heading"><text>{{column.title}}</text><text class="bracket-column-format">{{column.format}}</text></view>
                <view class="bracket-nodes">
                  <view wx:for="{{column.nodes}}" wx:key="key" wx:for-item="node" class="bracket-slot">
                    <view wx:if="{{node.is_placeholder}}" class="bracket-node bracket-placeholder">
                      <view class="bracket-node-heading"><text>{{node.label}}</text><text class="bracket-node-state">尚未生成</text></view>
                      <view class="bracket-team"><view class="bracket-team-mark">{{node.team1_initial}}</view><text class="bracket-team-name">{{node.team1_name}}</text><text class="bracket-team-score">—</text></view>
                      <view class="bracket-team"><view class="bracket-team-mark">{{node.team2_initial}}</view><text class="bracket-team-name">{{node.team2_name}}</text><text class="bracket-team-score">—</text></view>
                      <text class="bracket-node-note">等待前序赛程完成后编排</text>
                    </view>
                    <view wx:else id="round-{{node.round.id}}" class="bracket-node {{focusedRoundId === node.round.id ? 'round-focused' : ''}} {{node.round.is_mine ? 'bracket-mine' : ''}}" data-id="{{node.round.id}}" bindtap="showBo3">
                      <view class="bracket-node-heading"><text>{{node.label}}</text><text class="bracket-node-state {{node.round.status}}">{{node.status_text}}</text></view>
                      <view class="bracket-team {{node.round.status === 'finished' && node.round.winner_id === node.round.team1_id ? 'bracket-team-win' : ''}}"><view class="bracket-team-mark">{{node.team1_initial}}</view><text class="bracket-team-name">{{node.team1_name}}</text><text class="bracket-team-score">{{node.round.status === 'pending' || node.round.team1_score == null ? '—' : node.round.team1_score}}</text></view>
                      <view class="bracket-team {{node.round.status === 'finished' && node.round.winner_id === node.round.team2_id ? 'bracket-team-win' : ''}}"><view class="bracket-team-mark">{{node.team2_initial}}</view><text class="bracket-team-name">{{node.team2_name}}</text><text class="bracket-team-score">{{node.round.status === 'pending' || node.round.team2_score == null ? '—' : node.round.team2_score}}</text></view>
                      <view class="bracket-node-footer"><text class="bracket-node-time">{{node.round.schedule_text}}</text><text class="bracket-detail">小局 ›</text></view>
                      <view wx:if="{{node.round.can_chat}}" class="bracket-actions">
                        <button class="round-menu-button" data-id="{{node.round.id}}" catchtap="openRoundActions">比赛操作 ···</button>
                      </view>
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </scroll-view>
        </block>
      <block wx:if="{{!showBracket}}">
        <view wx:if="{{matchupCount === 0}}" class="empty">{{matchupEmptyText}}</view>
        <view wx:for="{{matchupTimelineSections}}" wx:key="key" wx:for-item="section" class="group-match-table schedule-day-section">
          <view class="round-group-heading schedule-day-heading"><view class="schedule-day-copy"><text class="group-title">{{section.title}}</text><text class="schedule-day-caption">{{section.caption}}</text></view><text class="group-round-count">{{section.rounds.length}} 场</text></view>
          <view wx:for="{{section.rounds}}" wx:key="id" wx:for-item="r" id="round-{{r.id}}" class="round-row schedule-match-card {{r.group_name === '淘汰赛' ? 'ko-row' : ''}} {{focusedRoundId === r.id ? 'round-focused' : ''}} {{r.status === 'finished' ? 'round-finished' : ''}} {{r.is_mine ? 'round-mine' : ''}}" bindtap="openMatchupDetail" data-id="{{r.id}}">
            <view class="round-heading schedule-match-heading"><view class="round-heading-state"><text wx:if="{{r.is_mine}}" class="my-team-badge">本队</text><text class="round-state {{r.status}}">{{r.status === 'finished' ? '已结束' : r.status === 'in_progress' ? '进行中' : '待比赛'}}</text></view><text class="schedule-stage-text">{{r.stage_label}} · {{r.group_name === '淘汰赛' ? 'BO3' : 'BO1'}}</text></view>
            <view class="schedule-match-main">
              <view class="schedule-time"><text class="schedule-clock">{{r.timeline_clock}}</text><text class="schedule-clock-caption">{{r.timeline_clock_caption}}</text></view>
              <view class="versus matchup-duel">
                <view class="vteam matchup-team {{r.display_winner1 ? 'vteam-win' : ''}}"><view class="team-mark">{{r.display_team1_initial}}</view><text class="vteam-name">{{r.display_team1_name}}</text></view>
                <view class="schedule-duel-score"><view class="schedule-scoreline"><text class="vteam-score {{r.display_winner1 ? 'score-win' : ''}}">{{r.status === 'pending' || r.display_score1 == null ? '—' : r.display_score1}}</text><text class="schedule-score-divider">:</text><text class="vteam-score {{r.display_winner2 ? 'score-win' : ''}}">{{r.status === 'pending' || r.display_score2 == null ? '—' : r.display_score2}}</text></view><text class="schedule-score-caption">{{r.group_name === '淘汰赛' ? '大比分' : '地图比分'}}</text></view>
                <view class="vteam matchup-team {{r.display_winner2 ? 'vteam-win' : ''}}"><view class="team-mark">{{r.display_team2_initial}}</view><text class="vteam-name">{{r.display_team2_name}}</text></view>
              </view>
            </view>
            <view class="matchup-result-line schedule-card-footer"><text class="round-format">{{r.group_match_text || '赛事第 ' + r.round_number + ' 场'}}{{r.group_round_label ? ' · ' + r.group_round_label : ''}}</text><text wx:if="{{onlyMyTeam && r.status === 'finished'}}" class="my-result {{r.result_text === '胜' ? 'win' : r.result_text === '负' ? 'loss' : ''}}">本队{{r.result_text}}</text><button wx:if="{{r.can_chat}}" class="round-menu-button" data-id="{{r.id}}" catchtap="openRoundActions">{{r.group_name === '淘汰赛' ? '比赛操作 ···' : '联系队长 ›'}}</button><text wx:else class="bo3-more">{{r.group_name === '淘汰赛' ? '小局详情 ›' : '比赛详情 ›'}}</text></view>
            <text wx:if="{{onlyMyTeam && r.bo3_text}}" class="record-maps matchup-maps">小局（本队在前）：{{r.bo3_text}}</text>
          </view>
        </view>
      </block>
      <text class="matchup-admin-note">如需调整比赛时间，请联系赛事管理员。</text>
    </view>
    <view wx:if="{{mainTab === 'stats'}}" class="event-player-stats"><player-stats match-id="{{match.id}}" /></view>
    <view wx:if="{{mainTab === 'info'}}" class="card event-info-card">
      <text class="section-title">赛事信息</text>
      <text class="event-info-description">{{match.description || '赛事介绍待补充'}}</text>
      <view class="event-info-line"><text>赛事类型</text><text>{{match.match_type === 'freshman' ? '新生赛' : '校园赛事'}} · CS2</text></view>
      <view class="event-info-line"><text>参赛规模</text><text>{{teams.length}} / {{match.max_teams || '不限'}} 队 · 每队 {{match.team_size || '不限'}} 人</text></view>
      <view class="event-info-line"><text>报名截止</text><text>{{registerEndText || '未设置'}}</text></view>
      <view class="event-format-list"><view><text>挑战者小组赛</text><text>双循环 BO1</text></view><view wx:if="{{hasPlayoffStage}}"><text>附加赛</text><text>单循环 BO1</text></view><view><text>传奇组</text><text>单循环 BO1</text></view><view><text>淘汰赛</text><text>BO3</text></view></view>
      <text class="section-caption">比赛时间由管理员统一安排。队伍战绩可在赛事排名中点击查看。</text>
      <button class="event-rules-link" bindtap="goRules">查看完整赛事规则 <text>›</text></button>
    </view>
    <!-- 按实际参赛名单与历史对阵列出分组，不用阶段排名猜测组别 -->
    <view wx:if="{{mainTab === 'info' && groupOverview.length}}" id="group-overview" class="card group-overview-card">
      <view class="group-overview-heading"><text class="section-title">分组一览</text><text class="group-overview-count">{{groupCount ? groupCount + ' 个挑战者小组 · ' : ''}}{{teams.length}} 支队伍</text></view>
      <text class="section-caption">完整参赛分组与历史组员。点击队伍查看战绩，或进入该组对阵。</text>
      <view wx:for="{{groupOverview}}" wx:key="key" wx:for-item="group" class="group-overview-section {{group.is_mine ? 'my-group-section' : ''}}">
        <view class="group-overview-title"><text>{{group.label}}</text><text class="group-member-count">{{group.team_count}} 队<text wx:if="{{group.is_mine}}"> · 本队所在</text></text></view>
        <view wx:for="{{group.teams}}" wx:key="team_id" wx:for-item="team" class="group-member {{team.is_mine ? 'my-group-member' : ''}}" data-id="{{team.team_id}}" bindtap="showTeam"><view class="group-member-dot"></view><text class="group-member-name">{{team.team_name}}</text><text wx:if="{{team.is_mine}}" class="my-team-badge">我的队伍</text></view>
        <text wx:if="{{group.hint && !group.round_count}}" class="group-overview-hint">{{group.hint}}</text>
        <view class="group-overview-footer"><text wx:if="{{group.round_count}}" class="group-progress">已完成 {{group.finished_count}} / {{group.round_count}} 场</text><button wx:if="{{group.can_view}}" class="group-round-link" data-tab="{{group.tab}}" data-group="{{group.group_name}}" bindtap="openGroupRounds">查看{{group.label}}对阵 ›</button></view>
      </view>
    </view>

  <!-- 队伍分阶段战绩 -->
  <view wx:if="{{showHistory && historyTeam}}" class="mask" bindtap="closeHistory">
    <view class="team-history-panel" catchtap="noop">
      <view class="detail-header">
        <view class="standing-copy"><text class="section-title">{{historyTeam.team_name}}</text><text class="team-meta">分阶段对局 · 比分以本队为先</text></view>
        <image class="detail-close" src="/images/icons/x.svg" bindtap="closeHistory"/>
      </view>
      <scroll-view scroll-y class="team-history-scroll">
        <view wx:if="{{historySections.length === 0}}" class="empty">暂无对阵，生成赛程后可查看各阶段战绩</view>
        <view wx:for="{{historySections}}" wx:key="key" wx:for-item="section" class="record-section">
          <view class="record-heading"><text class="record-title">{{section.title}}</text><text class="record-stats">{{section.record_text}}</text></view>
          <text wx:if="{{section.extra_text}}" class="team-meta">{{section.extra_text}}</text>
          <view wx:for="{{section.rounds}}" wx:key="id" wx:for-item="game" class="record-game">
            <view class="record-match"><text class="record-opponent">vs {{game.opponent}}</text><text class="record-result {{game.result_class}}">{{game.outcome}}</text></view>
            <view class="record-score"><text>{{game.score_text}}</text><text class="team-meta">{{game.format_text}} · 第 {{game.round_number}} 场</text></view>
            <text wx:if="{{game.maps_text}}" class="record-maps">{{game.maps_text}}</text>
          </view>
        </view>

      </scroll-view>
    </view>
  </view>

    <!-- BO3 小局详情弹层 -->
    <view wx:if="{{showBo3 && bo3Detail}}" class="mask" bindtap="closeBo3">
      <view class="bo3-panel" catchtap="noop">
        <view class="detail-header">
          <text class="section-title">{{bo3Detail.team1_name}} vs {{bo3Detail.team2_name}}</text>
          <image class="detail-close" src="/images/icons/x.svg" bindtap="closeBo3"/>
        </view>
        <view class="bo3-big">
          <text class="bo3-big-score">{{bo3Detail.status === 'pending' ? 'VS' : (bo3Detail.score1 == null ? '—' : bo3Detail.score1) + ' : ' + (bo3Detail.score2 == null ? '—' : bo3Detail.score2)}}</text>
          <text class="bo3-big-label">{{bo3Detail.ko_label}}</text>
        </view>
        <view wx:if="{{bo3Detail.games.length === 0}}" class="empty">{{bo3Detail.format_text === 'BO1' ? '本场采用 BO1，比分以上方展示为准' : '暂无小局比分'}}</view>
        <view wx:for="{{bo3Detail.games}}" wx:key="index" class="bo3-game">
          <text class="bo3-game-title">第{{index + 1}}局</text>
          <text class="bo3-game-score">{{item.t1}} : {{item.t2}}</text>
          <text class="tag {{item.t1 > item.t2 ? 'tag-green' : item.t2 > item.t1 ? 'tag-blue' : 'tag-gray'}}">{{item.t1 > item.t2 ? bo3Detail.team1_name : item.t2 > item.t1 ? bo3Detail.team2_name : '平局'}}</text>
        </view>
      </view>
    </view>

  </block>
</view>
