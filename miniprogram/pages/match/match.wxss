.page { padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.page > .card, .page > block > .card { margin: 24rpx; }
.card { margin: 24rpx; padding: 28rpx; border-radius: 28rpx; box-shadow: none; }

/* A restrained arena identity, drawn with CSS rather than a large image. */
.hero { position: relative; margin: 24rpx; padding: 30rpx; border-radius: 32rpx; background: linear-gradient(125deg, #102a43 5%, #143e50 68%, #087f8c 140%); color: #fff; overflow: hidden; }
.hero-orbit { position: absolute; width: 390rpx; height: 390rpx; border: 1rpx solid rgba(90, 226, 218, .17); border-radius: 80rpx; transform: rotate(35deg); pointer-events: none; }
.hero-orbit-one { right: -140rpx; top: -155rpx; }
.hero-orbit-two { right: -185rpx; top: -110rpx; }
.hero-top { position: relative; display: flex; justify-content: space-between; align-items: center; gap: 16rpx; margin-bottom: 32rpx; }
.hero-badge { font-size: 19rpx; font-weight: 700; letter-spacing: 3rpx; color: #a5d5df; }
.hero-status { display: flex; align-items: center; gap: 9rpx; font-size: 22rpx; color: #fff; flex-shrink: 0; }
.hero-status-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #aec1ce; }
.hero-status.st-registering .hero-status-dot, .hero-status.st-in_progress .hero-status-dot { background: #5bdfca; }
.hero-status.st-draft .hero-status-dot { background: #e6bd75; }
.hero-main { position: relative; display: flex; align-items: center; gap: 18rpx; }
.hero-copy { flex: 1; min-width: 0; }
.hero-type { display: block; color: #87dacf; font-size: 22rpx; margin-bottom: 10rpx; }
.hero-title { display: block; font-size: 42rpx; font-weight: 800; line-height: 1.35; word-break: break-all; }
.hero-emblem { width: 108rpx; height: 126rpx; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1rpx solid rgba(142, 217, 219, .35); border-radius: 22rpx 22rpx 44rpx 44rpx; background: rgba(255,255,255,.06); }
.hero-trophy { width: 52rpx; height: 52rpx; opacity: .95; filter: brightness(0) invert(1); }
.hero-emblem text { color: #c1e5e6; font-size: 17rpx; font-weight: 700; letter-spacing: 3rpx; margin-top: 9rpx; }
.hero-desc { position: relative; display: block; font-size: 24rpx; line-height: 1.7; color: #bdcfdc; margin: 20rpx 0 26rpx; word-break: break-all; }
.hero-stats { position: relative; display: flex; border-top: 1rpx solid rgba(204, 233, 239, .17); padding-top: 26rpx; }
.hero-stat { flex: 1; min-width: 0; padding: 0 14rpx; border-right: 1rpx solid rgba(204, 233, 239, .17); }
.hero-stat:first-child { padding-left: 0; }
.hero-stat:last-child { border-right: 0; }
.hero-stat-num { display: block; font-size: 38rpx; line-height: 1.2; font-weight: 750; color: #fff; }
.hero-stat-den { font-size: 21rpx; font-weight: 400; color: #bdcfdc; }
.hero-stat-label { display: block; margin-top: 10rpx; font-size: 21rpx; color: #bdcfdc; }
.hero-compact { padding: 24rpx 28rpx; }
.hero-compact .hero-top { margin-bottom: 16rpx; }
.hero-compact .hero-emblem, .hero-compact .hero-desc { display: none; }
.hero-compact .hero-title { font-size: 35rpx; }
.hero-compact .hero-type { font-size: 20rpx; margin-bottom: 6rpx; }
.hero-compact .hero-stats { margin-top: 16rpx; padding-top: 16rpx; }
.hero-compact .hero-stat-num { font-size: 30rpx; }
.hero-compact .hero-stat-label { font-size: 19rpx; margin-top: 6rpx; }

/* Registration is its own clearly labelled action, separate from the schedule. */
.register-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; flex-wrap: wrap; margin-bottom: 22rpx; }
.register-title { color: #102a43; font-size: 28rpx; font-weight: 700; }
.register-caption { color: #6d8193; font-size: 21rpx; }
.register-card .btn-primary { font-size: 28rpx; padding: 22rpx 20rpx; text-align: center; }
.register-done { display: flex; align-items: center; justify-content: center; gap: 12rpx; color: #087f8c; background: #eaf7f4; border-radius: 18rpx; padding: 22rpx 16rpx; font-size: 27rpx; font-weight: 600; }
.register-icon { width: 32rpx; height: 32rpx; }
.register-disabled { display: block; padding: 20rpx 14rpx; border-radius: 18rpx; background: #f3f7fa; text-align: center; color: #6d8193; font-size: 25rpx; line-height: 1.6; }
.roster-note { display: block; margin-top: 16rpx; color: #6d8193; font-size: 22rpx; line-height: 1.6; text-align: center; }
.waiting-card { border-color: #ede2c9; }
.register-compact { padding: 18rpx 24rpx; }
.register-compact .register-heading { display: none; }
.register-compact .register-done, .register-compact .register-disabled { background: transparent; padding: 0; font-size: 23rpx; }
.register-compact .register-icon { width: 27rpx; height: 27rpx; }
.register-compact .roster-note { margin-top: 8rpx; font-size: 19rpx; }

.content-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 16rpx; margin: 32rpx 28rpx 16rpx; }
.content-title { display: block; font-size: 36rpx; font-weight: 750; color: #102a43; }
.content-note { font-size: 21rpx; color: #6d8193; margin-bottom: 5rpx; }
.tabs { display: flex; position: sticky; top: 0; z-index: 50; background: #fff; border: 1rpx solid #e2ebf0; border-radius: 22rpx; padding: 8rpx; margin: 16rpx 24rpx 22rpx; box-shadow: 0 6rpx 18rpx rgba(16,42,67,.04); }
.tab { flex: 1; min-width: 0; display: flex; align-items: center; justify-content: center; min-height: 80rpx; font-size: 26rpx; color: #526d82; border-radius: 16rpx; white-space: nowrap; }
.personal-tab { flex: 1.3; }
.tab.active { color: #fff; font-weight: 600; background: #087f8c; }
.schedule-hint { margin: 0 30rpx 20rpx; color: #6d8193; font-size: 22rpx; line-height: 1.65; }
.section-title { display: block; color: #102a43; font-size: 30rpx; font-weight: 700; line-height: 1.5; margin-bottom: 20rpx; }
.section-caption { display: block; margin: -8rpx 0 24rpx; color: #6d8193; font-size: 22rpx; line-height: 1.6; }
.stage-tabs { display: flex; gap: 12rpx; flex-wrap: wrap; margin: 8rpx 0 24rpx; }
.stage-tab { display: flex; align-items: center; justify-content: center; min-height: 76rpx; padding: 0 26rpx; font-size: 25rpx; color: #526d82; background: #f3f7fa; border-radius: 14rpx; }
.stage-tab.active { background: #e5f5f3; color: #087f8c; font-weight: 700; }
.stage-content { min-width: 0; }
.format-badge { display: inline-block; font-size: 22rpx; line-height: 1.5; font-weight: 600; padding: 8rpx 14rpx; color: #087782; background: #e7f5f2; border-radius: 10rpx; }

/* One team list; detailed records are opened on demand. */
.standing-row { padding: 26rpx 0; border-bottom: 1rpx solid #e2ebf0; }
.standing-row:last-child { border-bottom: 0; }
.standing-row:active { background: #f3f7fa; }
.standing-main { display: flex; align-items: center; gap: 18rpx; }
.standing-rank { width: 64rpx; height: 64rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; background: #eaf4f5; color: #087f8c; font-size: 22rpx; font-weight: 700; }
.standing-medal { background: #fbf2df; color: #946821; }
.standing-copy { flex: 1; min-width: 0; }
.standing-copy .team-name { display: block; }
.standing-group { display: block; font-size: 22rpx; line-height: 1.6; color: #6d8193; margin-top: 6rpx; word-break: break-all; }
.standing-tags { display: flex; align-items: center; gap: 10rpx; flex-wrap: wrap; margin-top: 12rpx; }
.standing-progress { font-size: 21rpx; color: #6d8193; }
.standing-arrow { width: 28rpx; height: 28rpx; flex-shrink: 0; }
.ranking-approve { display: inline-block; margin: 18rpx 0 0 82rpx; }
.team-history-panel { width: 100%; box-sizing: border-box; background: #fff; border-radius: 30rpx 30rpx 0 0; padding: 30rpx 28rpx calc(24rpx + env(safe-area-inset-bottom)); }
.team-history-panel .detail-header { align-items: flex-start; gap: 18rpx; margin-bottom: 24rpx; }
.team-history-panel .section-title { margin-bottom: 8rpx; word-break: break-all; }
.team-history-scroll { height: 62vh; }
.record-section { margin-bottom: 28rpx; }
.record-heading { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12rpx; padding: 18rpx 0; }
.record-title { font-size: 26rpx; font-weight: 700; color: #102a43; }
.record-stats { font-size: 24rpx; font-weight: 600; color: #087f8c; }
.record-game { padding: 20rpx; background: #f3f7fa; border-radius: 16rpx; margin-bottom: 12rpx; }
.record-match { display: flex; justify-content: space-between; align-items: flex-start; gap: 12rpx; }
.record-opponent { flex: 1; min-width: 0; font-size: 25rpx; color: #102a43; word-break: break-all; }
.record-result { flex-shrink: 0; font-size: 23rpx; color: #6d8193; }
.record-result.win { color: #087f8c; }
.record-result.loss { color: #b35b5b; }
.record-score { display: flex; align-items: baseline; gap: 14rpx; flex-wrap: wrap; font-size: 29rpx; font-weight: 650; padding-top: 12rpx; }
.record-maps { display: block; font-size: 22rpx; line-height: 1.7; color: #6d8193; margin-top: 10rpx; word-break: break-all; }
@media (max-width: 350px) {
  .standing-copy .team-name { font-size: 14px; }
  .standing-group, .standing-progress, .record-maps { font-size: 11px; }
  .record-title, .record-opponent { font-size: 13px; }
  .record-stats, .record-result, .team-history-panel .team-meta { font-size: 12px; }
}

/* Team names get their own line so long names and status badges stay legible. */
.team-row { display: flex; flex-direction: column; gap: 14rpx; padding: 24rpx 0; border-bottom: 1rpx solid #e2ebf0; }
.team-row:last-child { border-bottom: 0; }
.team-name { min-width: 0; font-size: 27rpx; font-weight: 600; color: #102a43; line-height: 1.5; word-break: break-all; }
.detail-tags { display: flex; gap: 8rpx; flex-wrap: wrap; align-items: center; }
.detail-tags .tag { font-size: 20rpx; }
.rank-left { display: flex; align-items: center; gap: 18rpx; min-width: 0; }
.rank-no { width: 46rpx; height: 46rpx; border-radius: 13rpx; background: #f3f7fa; color: #6d8193; font-size: 24rpx; font-weight: 750; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.rank-no.rank-top { color: #946821; background: #fbf2df; }
.chip-wrap { display: flex; flex-direction: column; gap: 12rpx; }
.team-chip { display: flex; gap: 10rpx; align-items: center; flex-wrap: wrap; background: #f3f7fa; border-radius: 18rpx; padding: 20rpx; font-size: 24rpx; }
.chip-name { width: 100%; color: #102a43; font-size: 26rpx; font-weight: 600; line-height: 1.5; word-break: break-all; }

/* Each group reads as one match table, with names facing the central score. */
.group-match-table { border: 1rpx solid #dbe5ec; border-radius: 14rpx; overflow: hidden; margin-top: 24rpx; }
.round-row { display: flex; flex-direction: column; background: #fff; border: 0; border-bottom: 1rpx solid #e2ebf0; border-radius: 0; margin: 0; }
.round-row:last-child { border-bottom: 0; }
.round-finished { background: #f7fafb; }
.round-heading { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10rpx; padding: 16rpx 18rpx 0; }
.round-state { font-size: 22rpx; color: #526d82; }
.round-state.finished { color: #087f8c; }
.round-format { font-size: 21rpx; color: #62798c; line-height: 1.6; }
.versus { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; padding: 20rpx 18rpx; min-width: 0; }
.vteam { flex: 1; display: flex; align-items: center; justify-content: center; gap: 10rpx; min-width: 0; }
.vteam-name, .my-team-name { display: block; flex: 1; min-width: 0; font-size: 25rpx; font-weight: 650; color: #102a43; line-height: 1.6; max-width: 100%; word-break: break-all; }
.side-home { justify-content: flex-start; }
.side-away { justify-content: flex-end; }
.side-home .vteam-name, .side-home .my-team-name { text-align: right; }
.side-away .vteam-name { text-align: left; }
.team-mark { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 42rpx; height: 42rpx; border-radius: 10rpx; background: #e7edf3; color: #36536b; font-size: 20rpx; font-weight: 800; }
.vteam-win .team-mark { color: #087f8c; background: #dbefea; }
.duel-score { display: flex; flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0; width: 102rpx; min-height: 82rpx; padding: 10rpx 4rpx; box-sizing: border-box; border-radius: 10rpx; background: #eef3f7; gap: 5rpx; }
.duel-scoreline { display: flex; align-items: baseline; justify-content: center; gap: 6rpx; }
.vteam-score { display: block; font-size: 30rpx; line-height: 1.2; font-weight: 800; color: #304d64; }
.score-divider { color: #8c9ba8; font-size: 24rpx; font-weight: 500; }
.duel-vs { font-size: 26rpx; letter-spacing: 2rpx; color: #62798c; font-weight: 800; }
.duel-format { color: #8193a3; font-size: 17rpx; line-height: 1.3; font-weight: 650; letter-spacing: 1rpx; }
.score-win { color: #087f8c; }
.vteam-win .vteam-name { color: #087f8c; }
.vs-text { font-size: 20rpx; letter-spacing: 2rpx; color: #8b9dac; flex-shrink: 0; }
.round-side { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10rpx; padding: 0 18rpx 16rpx; background: transparent; }
.round-side > .tag { font-size: 20rpx; padding: 4rpx 10rpx; }
.schedule-status { font-size: 22rpx; color: #62798c; line-height: 1.6; word-break: break-all; }
.schedule-status.pending { color: #946821; }
.schedule-status.confirmed { color: #087f8c; }
.big-score { display: flex; flex-direction: column; align-items: center; flex-shrink: 0; max-width: 210rpx; gap: 8rpx; }
.big-score-text { font-size: 46rpx; font-weight: 800; color: #102a43; white-space: nowrap; }
.big-score-text.score-win { color: #087f8c; }
.big-score-text.score-tbd { color: #6d8193; }
.big-score-label { font-size: 18rpx; color: #6d8193; text-align: center; line-height: 1.5; }
.bo3-more { font-size: 21rpx; color: #087f8c; }
.ko-row:active { background: #edf7f7; }
.group-title { display: block; font-size: 27rpx; font-weight: 700; color: #102a43; margin: 24rpx 0 16rpx; }
.round-group-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; margin: 0; padding: 18rpx; background: #18364e; }
.round-group-heading .group-title { margin: 0; min-width: 0; color: #fff; font-size: 25rpx; word-break: break-all; }
.group-round-count { flex-shrink: 0; font-size: 21rpx; color: #b8cbd8; }
.ko-title { color: #946821; }
.ko-section { margin-bottom: 24rpx; }

/* Panels remain native, scrollable, and safe above the home indicator. */
.mask { position: fixed; inset: 0; z-index: 100; display: flex; align-items: flex-end; justify-content: center; background: rgba(10,28,43,.48); }
.bo3-panel { width: 100%; max-height: 82vh; box-sizing: border-box; overflow-y: auto; background: #fff; border-radius: 32rpx 32rpx 0 0; padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom)); }
.detail-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; margin-bottom: 18rpx; }
.detail-header .section-title { flex: 1; min-width: 0; word-break: break-all; margin-bottom: 0; }
.detail-close { width: 34rpx; height: 34rpx; padding: 12rpx; flex-shrink: 0; border-radius: 50%; background: #f3f7fa; }
.bo3-big { display: flex; flex-direction: column; align-items: center; gap: 10rpx; padding: 30rpx 0; margin-bottom: 24rpx; border-radius: 22rpx; background: #f3f7fa; }
.bo3-big-score { font-size: 70rpx; font-weight: 800; color: #102a43; }
.bo3-big-label { font-size: 23rpx; color: #6d8193; }
.bo3-game { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12rpx; padding: 24rpx 0; border-bottom: 1rpx solid #e2ebf0; }
.bo3-game-title { color: #6d8193; font-size: 24rpx; }
.bo3-game-score { color: #102a43; font-size: 32rpx; font-weight: 700; }
.bo3-game .tag { max-width: 250rpx; word-break: break-all; white-space: normal; }
.team-meta { display: block; margin: 10rpx 0; font-size: 24rpx; line-height: 1.7; color: #6d8193; word-break: break-all; }
.win-row { display: flex; align-items: center; gap: 16rpx; margin: 20rpx 0; }
.win-label { flex-shrink: 0; width: 90rpx; font-size: 25rpx; color: #526d82; }
.win-row picker { flex: 1; }
.win-picker { background: #f3f7fa; border: 1rpx solid #e2ebf0; border-radius: 16rpx; padding: 22rpx; font-size: 27rpx; color: #102a43; }
.score-btns { display: flex; gap: 16rpx; margin-top: 28rpx; }
.score-btns .btn-outline, .score-btns .btn-primary { flex: 1; padding: 22rpx 12rpx; font-size: 26rpx; text-align: center; }
.empty { padding: 64rpx 24rpx; font-size: 25rpx; color: #6d8193; }
.reg-pending .register-done { color: #946821; background: #fcf5e7; }
.reg-rejected .register-done { color: #b44848; background: #fff0ef; }
.round-state.in_progress { color: #087f8c; }
.round-actions, .my-round-actions, .bracket-actions { display: flex; justify-content: flex-end; }
.round-menu-button { margin: 0; display: flex; align-items: center; justify-content: center; padding: 12rpx 20rpx; min-height: 84rpx; border-radius: 12rpx; font-size: 24rpx; line-height: 1.5; color: #087782; background: #edf6f4; border: 0; }
.round-menu-button:active { background: #dcefeb; }
.round-menu-button::after { border: none; }
/* One quiet reminder opens the full personal schedule. */
.my-match-notice { display: flex; align-items: center; gap: 18rpx; padding: 24rpx; margin: 24rpx; border: 1rpx solid #c9e3dc; border-radius: 20rpx; background: #edf8f4; }
.my-match-notice:active { background: #e0f2eb; }
.match-notice-icon { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 64rpx; height: 64rpx; border-radius: 16rpx; background: #d8eee5; }
.match-notice-icon image { width: 34rpx; height: 34rpx; }
.match-notice-copy { flex: 1; min-width: 0; }
.match-notice-title { display: block; color: #086b61; font-size: 27rpx; font-weight: 650; line-height: 1.6; word-break: break-all; }
.match-notice-meta { display: block; color: #5c7975; font-size: 22rpx; line-height: 1.6; margin-top: 4rpx; word-break: break-all; }
.match-notice-link { flex-shrink: 0; font-size: 23rpx; color: #087782; }
.my-round { border: 0; border-bottom: 1rpx solid #dfe8ee; border-radius: 0; padding: 0; margin: 0; background: #fff; }
.my-round:last-child { margin-bottom: 0; }
.my-round-finished { background: #f7fafb; }
.my-round-heading { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; padding: 16rpx 18rpx 0; }
.my-round-stage-wrap { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 8rpx; }
.my-round-stage { flex: 1; min-width: 0; font-size: 23rpx; font-weight: 650; color: #087782; word-break: break-all; }
.my-round-opponent { display: block; flex: 1; min-width: 0; color: #102a43; font-size: 25rpx; line-height: 1.6; font-weight: 650; text-align: left; word-break: break-all; }
.my-round-score { color: #102a43; font-size: 28rpx; font-weight: 800; white-space: nowrap; }
.my-result { display: block; padding: 0 18rpx 8rpx; text-align: right; color: #6d8193; font-size: 22rpx; }
.my-result.win { color: #087f8c; }
.my-result.loss { color: #b44848; }
.my-round-schedule { display: flex; flex-direction: column; gap: 6rpx; padding: 0 18rpx 16rpx; font-size: 22rpx; line-height: 1.6; color: #526d82; }
.my-round-window { font-size: 21rpx; color: #6d8193; }
.my-round-actions { padding: 0 18rpx 18rpx; }

/* Keep group membership separate from the event placement table. */
.group-overview-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; flex-wrap: wrap; margin-bottom: 20rpx; }
.group-overview-heading .section-title { margin: 0; }
.group-overview-count { color: #6d8193; font-size: 21rpx; }
.group-overview-section { padding: 24rpx; margin-top: 18rpx; background: #f3f7fa; border: 1rpx solid #e2ebf0; border-radius: 20rpx; }
.my-group-section { border-color: #b9ddd6; background: #edf8f6; }
.group-overview-title { display: flex; justify-content: space-between; align-items: flex-start; gap: 16rpx; color: #102a43; font-size: 27rpx; font-weight: 700; line-height: 1.5; margin-bottom: 16rpx; }
.group-overview-title > text:first-child { flex: 1; min-width: 0; word-break: break-all; }
.group-member-count { flex-shrink: 0; font-size: 21rpx; font-weight: 400; color: #6d8193; padding-top: 4rpx; }
.group-member { display: flex; align-items: center; gap: 12rpx; padding: 20rpx 0; border-bottom: 1rpx solid #e2ebf0; }
.group-member:last-child { border-bottom: 0; }
.group-member-name { flex: 1; min-width: 0; font-size: 28rpx; line-height: 1.6; color: #304d64; word-break: break-all; }
.group-member-dot { width: 8rpx; height: 8rpx; flex-shrink: 0; border-radius: 50%; background: #a7bdcb; }
.my-group-member .group-member-name { color: #087782; font-weight: 650; }
.my-group-member .group-member-dot { background: #087f8c; }
.my-team-badge { flex-shrink: 0; color: #087782; background: #dcefeb; border-radius: 8rpx; padding: 5rpx 10rpx; font-size: 19rpx; font-weight: 600; line-height: 1.5; }
.group-overview-hint { display: block; font-size: 22rpx; line-height: 1.7; color: #6d8193; margin-top: 16rpx; }
