.page {
  padding-bottom: 60rpx;
}

/* ===== 赛事 Hero ===== */
.hero {
  position: relative;
  margin: 20rpx;
  padding: 36rpx 32rpx 32rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(165deg, #ffffff 0%, #f1f4f8 100%);
  border: 1rpx solid var(--color-border);
  overflow: hidden;
}

.hero-glow {
  position: absolute;
  top: -140rpx;
  right: -100rpx;
  width: 420rpx;
  height: 420rpx;
  background: radial-gradient(circle, rgba(8, 145, 178, 0.22), transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.hero-top {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
}

.hero-badge {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--color-primary);
  background: rgba(8, 145, 178, 0.14);
  border: 1rpx solid rgba(8, 145, 178, 0.3);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}

.hero-status {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: var(--color-gray-600);
}

.hero-status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--color-gray-400);
}

.hero-status.st-registering .hero-status-dot { background: #34d399; }
.hero-status.st-in_progress .hero-status-dot { background: var(--color-primary); }
.hero-status.st-finished .hero-status-dot { background: var(--color-gray-300); }
.hero-status.st-draft .hero-status-dot { background: #fbbf24; }

.hero-title {
  position: relative;
  display: block;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.3;
  color: var(--color-gray-900);
  margin-bottom: 14rpx;
}

.hero-desc {
  position: relative;
  display: block;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--color-gray-600);
  margin-bottom: 26rpx;
}

.hero-stats {
  position: relative;
  display: flex;
  gap: 18rpx;
}

.hero-stat {
  flex: 1;
  background: rgba(15, 23, 42, 0.05);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 18rpx 8rpx;
  text-align: center;
}

.hero-stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-primary);
  line-height: 1.2;
}

.hero-stat-den {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-gray-500);
}

.hero-stat-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-gray-500);
  margin-top: 8rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
  color: var(--color-gray-800);
}

/* ===== 报名区 ===== */
.register-card {
  text-align: center;
}

.register-done {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: var(--color-success);
  font-size: 30rpx;
  font-weight: bold;
}

.register-icon {
  width: 36rpx;
  height: 36rpx;
}

.register-disabled {
  color: var(--color-gray-500);
  font-size: 26rpx;
}

/* ===== 阶段 tab ===== */
.tabs {
  display: flex;
  position: sticky;
  top: 0;
  z-index: 50;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  margin: 20rpx;
  overflow: hidden;
  border: 1rpx solid var(--color-border);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: var(--color-gray-600);
  transition: color 0.2s ease;
}

.tab.active {
  color: #ffffff;
  font-weight: 700;
  background: linear-gradient(135deg, #0891b2, #0e7490);
}

/* ===== 子阶段 tab（swiper 切换） ===== */
.stage-tabs {
  display: flex;
  gap: 14rpx;
  margin-bottom: 12rpx;
}

.stage-tab {
  padding: 8rpx 28rpx;
  font-size: 24rpx;
  color: var(--color-gray-600);
  background: var(--color-gray-100);
  border-radius: 30rpx;
}

.stage-tab.active {
  background: linear-gradient(135deg, #0891b2, #0e7490);
  color: #ffffff;
  font-weight: 600;
}

.stage-swiper {
  height: 600rpx;
}

.stage-scroll {
  height: 100%;
}

.teams-swiper {
  height: 620rpx;
}

.teams-scroll {
  height: 100%;
}

/* ===== 队伍行（状态/排名） ===== */
.team-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--color-row);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 14rpx 20rpx;
  margin-bottom: 10rpx;
}

.team-name {
  font-size: 26rpx;
  color: var(--color-gray-800);
  flex-shrink: 0;
}

.detail-tags {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

/* 排名 */
.rank-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
}

.rank-no {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(15, 23, 42, 0.10);
  color: var(--color-gray-600);
  font-size: 26rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.rank-no.rank-top {
  background: rgba(8, 145, 178, 0.22);
  color: #34d399;
}

/* ===== 队伍 chips ===== */
.chip-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.team-chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: var(--color-gray-100);
  border: 1rpx solid var(--color-border);
  border-radius: 30rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
}

.chip-name {
  font-weight: bold;
  color: var(--color-gray-800);
}

/* ===== 对阵 ===== */
.round-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, rgba(15, 23, 42, 0.04), rgba(15, 23, 42, 0.01));
  background-color: var(--color-row);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 18rpx 22rpx;
  margin-bottom: 14rpx;
  gap: 16rpx;
}

/* 记分牌：队名在两侧，比分靠中间对齐（左队名靠外/比分靠中，右队名反向） */
.versus {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-width: 0;
}

.vteam {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 10rpx;
  border-radius: var(--radius-md);
  background: rgba(15, 23, 42, 0.04);
  border: 1rpx solid transparent;
  min-width: 0;
}

/* 记分牌对齐：左队名靠外/比分靠中，右队反向，形成 "队伍A 12 : 9 队伍B" */
.vteam:first-child {
  justify-content: flex-end;
}
.vteam:last-child {
  flex-direction: row-reverse;
  justify-content: flex-start;
}

.vteam-win {
  background: rgba(8, 145, 178, 0.10);
  border: 1rpx solid rgba(8, 145, 178, 0.25);
}

.vteam-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-gray-800);
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vteam-score {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-gray-500);
}

.score-win {
  color: #0891b2;
}

.vs-text {
  font-size: 22rpx;
  color: var(--color-gray-500);
  flex-shrink: 0;
}

/* BO3 大比分 */
.big-score {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
}

.big-score-text {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--color-gray-500);
}

.big-score-text.score-win {
  color: #0891b2;
}

.big-score-text.score-tbd {
  color: var(--color-gray-400);
}

.big-score-label {
  font-size: 20rpx;
  color: var(--color-gray-500);
}

.ko-row:active {
  background: var(--color-gray-100);
}

/* 淘汰赛 BO3 对阵保持队名居中，不套用普通记分牌对齐 */
.ko-row .vteam {
  justify-content: center;
}
.ko-row .vteam:last-child {
  flex-direction: row;
  justify-content: center;
}

.bo3-more {
  font-size: 22rpx;
  color: var(--color-primary);
  flex-shrink: 0;
}

/* 组标题 */
.group-title {
  display: block;
  font-size: 24rpx;
  font-weight: bold;
  color: var(--color-primary);
  margin: 14rpx 0 10rpx;
  padding-left: 12rpx;
  border-left: 6rpx solid var(--color-primary);
}

.ko-title {
  color: #fb7185;
  border-left-color: #fb7185;
}

.ko-section {
  margin-bottom: 8rpx;
}

/* ===== BO3 小局弹层 ===== */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bo3-panel {
  width: 82%;
  max-height: 80vh;
  overflow-y: auto;
  background: var(--color-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 30rpx;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.detail-close {
  width: 40rpx;
  height: 40rpx;
  padding: 10rpx;
}

.bo3-big {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
  margin-bottom: 20rpx;
}

.bo3-big-score {
  font-size: 64rpx;
  font-weight: 800;
  color: var(--color-gray-900);
}

.bo3-big-label {
  font-size: 24rpx;
  color: var(--color-gray-500);
}

.bo3-game {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--color-row);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 18rpx 24rpx;
  margin-bottom: 12rpx;
}

.bo3-game-title {
  font-size: 26rpx;
  color: var(--color-gray-500);
}

.bo3-game-score {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-gray-800);
}

/* ===== 时间协商 ===== */
.round-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  flex-shrink: 0;
}

.schedule-status {
  font-size: 20rpx;
  color: var(--color-gray-500);
  max-width: 220rpx;
  text-align: right;
  word-break: break-all;
}

.schedule-status.unconfirmed { color: var(--color-gray-500); }
.schedule-status.pending { color: var(--color-warning); }
.schedule-status.confirmed { color: var(--color-primary); }
.schedule-status.clickable { text-decoration: underline; }

.team-meta {
  font-size: 24rpx;
  color: var(--color-gray-500);
  display: block;
  margin: 8rpx 0;
}

.schedule-panel {
  width: 82%;
  max-height: 80vh;
  overflow-y: auto;
  background: var(--color-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 30rpx;
}

.win-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 16rpx 0;
}

.win-label {
  width: 140rpx;
  font-size: 26rpx;
  color: var(--color-gray-600);
  flex-shrink: 0;
}

.win-picker {
  flex: 1;
  background: var(--color-gray-100);
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: var(--color-gray-800);
}

.score-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.score-btns .btn-outline,
.score-btns .btn-primary {
  flex: 1;
  padding: 16rpx 0;
  font-size: 28rpx;
  text-align: center;
}
