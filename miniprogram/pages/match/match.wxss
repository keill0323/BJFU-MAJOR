.bracket-node-state.finished, .bracket-node-state.in_progress { color: #087f8c; }
.bracket-team { display: flex; align-items: center; gap: 10rpx; min-height: 68rpx; padding: 10rpx 14rpx; box-sizing: border-box; border-bottom: 1rpx solid #edf2f5; }
.bracket-team-mark { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 30rpx; height: 30rpx; color: #62798c; background: #edf2f5; border-radius: 7rpx; font-size: 16rpx; font-weight: 700; }
.bracket-team-name { flex: 1; min-width: 0; font-size: 23rpx; line-height: 1.5; color: #304d64; font-weight: 600; word-break: break-all; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.bracket-team-score { flex-shrink: 0; font-size: 30rpx; line-height: 1.2; color: #62798c; font-weight: 800; }
.bracket-team-win { background: #e7f5f0; }
.bracket-team-win .bracket-team-name, .bracket-team-win .bracket-team-score { color: #087782; }
.bracket-team-win .bracket-team-mark { background: #d1e8df; color: #087782; }
.bracket-node-footer { display: flex; justify-content: space-between; align-items: flex-start; gap: 8rpx; padding: 12rpx 14rpx; }
.bracket-node-time { flex: 1; min-width: 0; font-size: 18rpx; line-height: 1.6; color: #8193a3; }
.bracket-detail { flex-shrink: 0; font-size: 18rpx; color: #087782; }
.bracket-mine { border-color: #76b7a6; }
.bracket-actions { padding: 0 12rpx 12rpx; }
.bracket-actions button { padding: 12rpx 14rpx; font-size: 21rpx; }
.bracket-placeholder { border-style: dashed; border-color: #c7d3dc; background: #f7f9fb; }
.bracket-placeholder .bracket-team-name, .bracket-placeholder .bracket-team-score { color: #8193a3; font-weight: 500; }
.bracket-node-note { display: block; padding: 14rpx; font-size: 18rpx; color: #8193a3; }
.bracket-column-quarter .bracket-node::after { content: ''; position: absolute; right: -49rpx; top: 50%; width: 48rpx; border-top: 2rpx solid #bacbd8; }
.bracket-column-semi .bracket-node::after { content: ''; position: absolute; right: -25rpx; top: 50%; width: 24rpx; border-top: 2rpx solid #bacbd8; }
.bracket-column-semi .bracket-nodes::after { content: ''; position: absolute; right: -25rpx; top: 25%; height: 50%; border-right: 2rpx solid #bacbd8; pointer-events: none; }
.bracket-column-final .bracket-node::before { content: ''; position: absolute; left: -25rpx; top: 50%; width: 24rpx; border-top: 2rpx solid #bacbd8; }
