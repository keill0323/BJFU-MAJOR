.bracket-nodes { flex: 1; position: relative; display: flex; flex-direction: column; }
.bracket-slot { flex: 1; min-height: 0; display: flex; align-items: center; }
.bracket-node { position: relative; flex-shrink: 0; box-sizing: border-box; min-height: 282rpx; border: 1rpx solid #cbd9e3; border-radius: 12rpx; background: #fff; white-space: normal; }
