/* Six-team cross-zone bracket: two quarters, two semis, one final. */
.bracket-legend { display: flex; align-items: center; gap: 10rpx; flex-wrap: wrap; font-size: 23rpx; color: #304d64; margin-bottom: 20rpx; }
