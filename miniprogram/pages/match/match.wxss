.bracket-board { display: flex; width: 1120rpx; height: 1000rpx; box-sizing: border-box; padding: 22rpx; gap: 48rpx; }
.bracket-column { flex-shrink: 0; width: 326rpx; min-width: 0; display: flex; flex-direction: column; }
.bracket-column-heading { display: flex; align-items: center; justify-content: space-between; height: 64rpx; color: #18364e; font-size: 26rpx; font-weight: 750; border-bottom: 2rpx solid #cad8e2; }
