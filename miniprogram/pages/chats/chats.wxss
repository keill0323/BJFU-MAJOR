page{background:#f5f6f2;color:#20372b}.chat-list-page{padding:28rpx 30rpx 80rpx}.chat-heading{display:flex;justify-content:space-between;align-items:center;padding:24rpx 0}.eyebrow{display:block;font-size:19rpx;letter-spacing:3rpx;color:#6d8474}.title{display:block;font-size:48rpx;font-weight:750;margin-top:12rpx}.heading-symbol{font-size:68rpx;color:#477958}.retention-note{display:block;font-size:23rpx;color:#718276;line-height:1.8;margin-bottom:30rpx}.search{display:flex;align-items:center;padding:12rpx 14rpx 12rpx 24rpx;background:white;border:1rpx solid #dce4dc;border-radius:20rpx}.search input{flex:1;min-width:0;font-size:28rpx;height:72rpx}.search button{margin:0;background:#1e5737;color:white;font-size:25rpx;line-height:64rpx;border-radius:14rpx;padding:0 24rpx}.quick-links{display:flex;justify-content:space-between;padding:28rpx 4rpx;font-size:25rpx;color:#2e7048}.conversation{display:flex;gap:22rpx;padding:30rpx 20rpx;border-bottom:1rpx solid #e1e7e0}.conversation.pinned{background:#eaf0e8;border-radius:20rpx}.avatar{width:90rpx;height:90rpx;flex-shrink:0;background:#dcebdd;border-radius:26rpx;display:flex;align-items:center;justify-content:center;color:#356b44;font-size:35rpx;font-weight:700;overflow:hidden}.avatar image{width:100%;height:100%}.conversation-copy{flex:1;min-width:0}.line{display:flex;align-items:center;gap:12rpx;justify-content:space-between;margin:7rpx 0}.name{font-size:29rpx;font-weight:650;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.time{font-size:20rpx;color:#89958a;flex-shrink:0}.preview{font-size:25rpx;color:#718074;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1}.badge{background:#b1493b;color:white;border-radius:30rpx;min-width:30rpx;padding:3rpx 9rpx;text-align:center;font-size:21rpx}.badge.quiet{background:#839085}.state{display:block;padding:30rpx;text-align:center;color:#7d8b7f;font-size:25rpx}.error{padding:24rpx;background:#fff0de;color:#9a6629;border-radius:18rpx}.empty{padding:90rpx 20rpx;text-align:center;color:#889386;font-size:26rpx}.empty-title{display:block;font-size:34rpx;font-weight:600;color:#526d55;margin-bottom:22rpx}.people-panel{padding:24rpx;background:white;border-radius:22rpx}.panel-head,.person{display:flex;justify-content:space-between;gap:20rpx;padding:20rpx 0;font-size:27rpx}.panel-head{color:#52805b}.person{border-top:1rpx solid #edf0ea}.muted{font-size:22rpx;color:#87958a}.primary{background:#205e3a;color:white;margin:20rpx}
.person-name{flex:1;min-width:0;overflow-wrap:anywhere;word-break:break-all}.person .muted{flex-shrink:0}
