.page { padding-bottom: calc(36rpx + env(safe-area-inset-bottom)); color: #102a43; }
.intro-row { margin: 24rpx 24rpx 20rpx; display: flex; align-items: flex-end; justify-content: space-between; gap: 12rpx; }
.eyebrow { display: block; font-size: 22rpx; letter-spacing: 3rpx; font-weight: 700; color: #087f8c; margin-bottom: 10rpx; }
.page-heading { display: block; font-size: 38rpx; font-weight: 750; letter-spacing: -1rpx; }
.completion-label { flex-shrink: 0; color: #637b8e; font-size: 22rpx; padding-bottom: 4rpx; }
.rank-hero { margin: 0 24rpx 28rpx; padding: 22rpx 24rpx; background: #102f42; border-radius: 24rpx; color: #fff; position: relative; overflow: hidden; }
.rank-hero-main { position: relative; display: flex; align-items: center; gap: 16rpx; }
.rank-emblem { display: block; flex-shrink: 0; width: 64rpx; height: 76rpx; }
.rank-hero-info { min-width: 0; flex: 1; }
.hero-kicker { display: block; font-size: 22rpx; color: #acc6d0; margin-bottom: 10rpx; }
.hero-rank { display: block; font-size: 30rpx; line-height: 1.3; font-weight: 750; word-break: break-all; }
.rating-line { display: flex; align-items: flex-end; gap: 8rpx; flex-direction: column; flex-shrink: 0; }
.rating-number { font-size: 30rpx; font-weight: 750; color: #8eeee3; line-height: 1; }
.rating-label { color: #acc6d0; font-size: 22rpx; }
.verify-card { margin: 20rpx 24rpx; padding: 24rpx; border-radius: 24rpx; }
.section-head, .section-heading { display: flex; align-items: center; }
.section-head { justify-content: space-between; gap: 12rpx; margin-bottom: 22rpx; }
.section-heading { gap: 16rpx; }
.step-number { font-size: 22rpx; font-weight: 750; color: #087f8c; background: #eaf6f5; border-radius: 10rpx; padding: 9rpx; }
.section-title { font-size: 30rpx; font-weight: 750; }
.status-chip { font-size: 22rpx; padding: 7rpx 14rpx; border-radius: 10rpx; flex-shrink: 0; }
.status-ok { color: #167c61; background: #eaf7f0; }
.status-pending { color: #906c2a; background: #fbf4e6; }
.status-rejected { color: #b34343; background: #fbeeee; }
.section-copy { display: block; color: #4c657a; font-size: 26rpx; line-height: 1.7; }
.school-pass { display: flex; align-items: center; gap: 18rpx; padding: 16rpx 18rpx; background: #f0f8f6; border-radius: 20rpx; }
.pass-symbol { flex-shrink: 0; width: 56rpx; height: 64rpx; background: #d6eee4; border-radius: 14rpx 14rpx 24rpx 24rpx; display: flex; align-items: center; justify-content: center; }
.pass-symbol image { width: 34rpx; height: 34rpx; }
.school-pass-info { flex: 1; min-width: 0; }
.school-pass-title { display: block; font-size: 27rpx; color: #176a58; font-weight: 650; }
.school-pass-copy { display: block; font-size: 22rpx; color: #637b8e; line-height: 1.7; margin-top: 6rpx; word-break: break-all; }
.privacy-note { margin: 14rpx 0 22rpx; color: #906c2a; font-size: 22rpx; line-height: 1.7; }
.reject-note { display: block; background: #fbeeee; color: #b34343; font-size: 24rpx; line-height: 1.7; border-radius: 16rpx; padding: 18rpx; margin-bottom: 18rpx; }
.upload-zone { margin-top: 22rpx; padding: 26rpx; border: 2rpx dashed #b4d9da; border-radius: 20rpx; background: #f3faf9; display: flex; flex-direction: column; align-items: center; }
.upload-plus { color: #087f8c; font-size: 48rpx; font-weight: 300; line-height: 1; }
.upload-label { color: #087f8c; font-size: 26rpx; font-weight: 650; margin-top: 12rpx; }
.upload-caption { color: #728794; font-size: 22rpx; margin-top: 8rpx; }
.upload-preview { display: flex; align-items: center; gap: 22rpx; padding: 20rpx; margin-top: 20rpx; background: #f5f8fa; border-radius: 20rpx; }
.verify-thumb { width: 112rpx; height: 138rpx; background: #e2ebf0; border-radius: 12rpx; flex-shrink: 0; }
.rank-thumb { height: 112rpx; }
.preview-info { flex: 1; min-width: 0; }
.preview-title { display: block; font-size: 25rpx; font-weight: 650; }
.preview-copy { display: block; font-size: 22rpx; color: #637b8e; margin-top: 8rpx; line-height: 1.5; }
.small-btn { display: inline-block; margin-top: 14rpx; font-size: 22rpx; padding: 8rpx 18rpx; }
.platform-notes { display: flex; margin-top: 24rpx; gap: 16rpx; }
.platform-note { flex: 1; min-width: 0; background: #f3f7fa; border: 1rpx solid #e2ebf0; border-radius: 18rpx; padding: 20rpx 18rpx; }
.platform-name { display: block; color: #087f8c; font-weight: 700; font-size: 26rpx; }
.platform-copy { display: block; color: #637b8e; font-size: 22rpx; margin-top: 8rpx; line-height: 1.6; }
.text-action { margin-top: 12rpx; color: #087f8c; font-size: 22rpx; font-weight: 600; }
.text-action text { margin-left: 8rpx; }
.rank-submit { margin-top: 24rpx; }
.footer-note { display: block; margin-top: 18rpx; color: #728794; font-size: 22rpx; line-height: 1.75; }
.support-row { display: flex; align-items: center; justify-content: center; padding: 16rpx 24rpx; color: #637b8e; font-size: 22rpx; gap: 8rpx; }
.support-row image { width: 24rpx; height: 24rpx; }
.guest-card, .state-card { margin: 32rpx 24rpx; padding: 48rpx 36rpx; text-align: center; }
.guest-mark { width: 96rpx; height: 104rpx; display: flex; align-items: center; justify-content: center; border-radius: 22rpx 22rpx 40rpx 40rpx; background: #e0f2ef; color: #087f8c; font-size: 36rpx; font-weight: 700; margin: 0 auto 28rpx; }
.guest-title { display: block; font-size: 34rpx; font-weight: 700; line-height: 1.5; }
.guest-copy { display: block; margin: 18rpx 0 32rpx; font-size: 25rpx; color: #637b8e; line-height: 1.8; }
.is-busy { opacity: .65; }

.intro-hint { display: block; color: #62798c; font-size: 24rpx; margin-top: 6rpx; line-height: 1.6; }
.operation-feedback, .rank-review { margin: 0 0 22rpx; padding: 22rpx; border: 1rpx solid #cfe4e5; border-left: 5rpx solid #087f8c; border-radius: 16rpx; background: #f0f8f8; color: #244f63; }
#verify-student .operation-feedback { margin-top: 22rpx; margin-bottom: 0; }
.feedback-heading { display: flex; align-items: center; gap: 12rpx; }
.feedback-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #087f8c; flex-shrink: 0; }
.feedback-title { display: block; min-width: 0; font-size: 26rpx; font-weight: 650; line-height: 1.5; word-break: break-all; }
.feedback-message { display: block; margin-top: 10rpx; font-size: 24rpx; line-height: 1.7; overflow-wrap: anywhere; word-break: break-word; }
.feedback-pending, .feedback-unknown { background: #fff9ed; border-color: #eadfc4; border-left-color: #a5782d; color: #755a28; }
.feedback-pending .feedback-dot, .feedback-unknown .feedback-dot { background: #a5782d; }
.feedback-success { background: #f0f8f3; border-color: #cee4d8; border-left-color: #247d60; color: #21624f; }
.feedback-success .feedback-dot { background: #247d60; }
.feedback-error { background: #fff3f1; border-color: #edcfca; border-left-color: #b74e43; color: #8f433b; }
.feedback-error .feedback-dot { background: #b74e43; }
.feedback-progress { display: flex; align-items: center; gap: 16rpx; margin-top: 18rpx; }
.feedback-progress-track { flex: 1; min-width: 0; height: 10rpx; border-radius: 10rpx; background: #d6e9e9; overflow: hidden; }
.feedback-progress-fill { height: 100%; border-radius: 10rpx; background: #087f8c; transition: width .16s ease; }
.feedback-progress-value { flex-shrink: 0; color: #326273; font-size: 22rpx; font-variant-numeric: tabular-nums; }
.feedback-actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.feedback-actions button, .rank-status-error button { display: inline-flex; align-items: center; justify-content: center; margin: 0; padding: 0 20rpx; min-height: 58rpx; line-height: 1.5; font-size: 23rpx; font-weight: 600; border: 1rpx solid #b7d5d7; border-radius: 12rpx; color: #08717d; background: #fff; }
.feedback-actions button::after, .rank-status-error button::after, button.rank-submit::after { border: 0; }
.feedback-actions button[disabled], .rank-status-error button[disabled] { color: #70838b; background: #f3f5f5; border-color: #d6dfe1; }
.review-values { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 18rpx; }
.review-value { flex: 1; min-width: 160rpx; }
.review-value-label { display: block; font-size: 22rpx; line-height: 1.5; opacity: .85; }
.review-value-text { display: block; margin-top: 5rpx; font-size: 29rpx; font-weight: 700; line-height: 1.4; word-break: break-all; }
.review-note { display: block; margin-top: 12rpx; font-size: 23rpx; line-height: 1.6; }
.rank-status-error { margin-bottom: 20rpx; padding: 18rpx; border-radius: 14rpx; background: #fff6e8; color: #8a632c; font-size: 23rpx; line-height: 1.7; }
.rank-status-error text { display: block; overflow-wrap: anywhere; }
.rank-status-error button { margin-top: 12rpx; }
.rank-status-loading { display: block; margin-bottom: 18rpx; color: #637b8e; font-size: 23rpx; line-height: 1.6; }
button.rank-submit { display: flex; align-items: center; justify-content: center; gap: 10rpx; width: 100%; min-height: 82rpx; box-sizing: border-box; padding: 18rpx 22rpx; font-size: 27rpx; font-weight: 650; line-height: 1.5; border-radius: 16rpx; }
button.rank-submit[disabled] { color: #526d80; background: #e3ecef; opacity: 1; }
@media (max-width: 350px) { .platform-notes { flex-direction: column; gap: 10rpx; }.platform-note { padding: 16rpx; }.intro-row { align-items: center; }.completion-label { font-size: 22rpx; }.rank-hero-main { gap: 12rpx; } }
