page { background:#f3f7fa; color:#18364e; overflow:hidden; }
.assistant-shell { display:flex; flex-direction:column; width:100%; min-width:0; overflow:hidden; box-sizing:border-box; }
nav-drawer { flex-shrink:0; }
.assistant-workspace { flex:1; min-height:0; min-width:0; display:flex; flex-direction:column; }
.assistant-heading { display:flex; align-items:center; justify-content:space-between; padding:16rpx 28rpx; gap:20rpx; flex-shrink:0; }
.assistant-title { flex:1; min-width:0; font-size:30rpx; font-weight:700; line-height:1.4; }
button { font-size:24rpx; line-height:1.5; margin:0; padding:12rpx 18rpx; border-radius:14rpx; background:#edf7f7; color:#087f8c; box-sizing:border-box; }button::after { border:none; }button[disabled] { color:#8297a5; background:#eaf0f3; }
.new-conversation { flex:0 0 auto; width:auto; min-width:102rpx; height:56rpx; line-height:54rpx; padding:0 14rpx; background:#fff; border:1rpx solid #dce7ed; font-size:23rpx; }
.context-tags { display:flex; flex-wrap:wrap; gap:8rpx; padding:0 28rpx 10rpx; flex-shrink:0; }.context-tags > view { display:flex; align-items:center; gap:12rpx; padding:6rpx 12rpx; background:#deefed; border-radius:10rpx; color:#24616a; font-size:22rpx; max-width:100%; box-sizing:border-box; }.context-tags text:first-child { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.assistant-history { flex:1; height:0; min-height:0; width:100%; box-sizing:border-box; }
.assistant-state { margin:16rpx 28rpx; padding:18rpx 20rpx; border-radius:14rpx; background:#edf2f5; color:#62798c; font-size:24rpx; line-height:1.7; }.assistant-state button { display:inline-block; width:auto; margin-top:12rpx; font-size:23rpx; padding:8rpx 16rpx; }
.assistant-welcome { padding:36rpx 28rpx 24rpx; }.welcome-title { display:block; font-size:36rpx; font-weight:750; }.welcome-note { display:block; margin-top:12rpx; font-size:25rpx; color:#62798c; line-height:1.7; }
.suggestions { margin-top:28rpx; }.suggestions button { width:100%; display:flex; align-items:center; justify-content:space-between; gap:16rpx; background:#fff; border:1rpx solid #e2ebf0; color:#304d64; padding:22rpx; margin:12rpx 0; text-align:left; font-size:25rpx; }.suggestions text { flex-shrink:0; color:#087f8c; }.privacy-note { display:block; color:#7b8e9b; font-size:22rpx; line-height:1.7; margin-top:24rpx; }
.assistant-message { padding:18rpx 28rpx; }.message-speaker { display:block; color:#62798c; font-size:22rpx; margin-bottom:10rpx; }.message-content { display:block; white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-all; font-size:27rpx; line-height:1.85; }.assistant-message.user .message-content { padding:20rpx 22rpx; background:#e1efed; color:#1c4855; border-radius:20rpx; }.assistant-message.user .message-speaker { text-align:right; }
.result-card { background:#fff; border:1rpx solid #dce7ed; border-radius:22rpx; padding:22rpx; margin-top:18rpx; }.result-title { display:block; font-size:29rpx; font-weight:700; color:#18364e; }.result-summary { display:block; font-size:24rpx; line-height:1.8; color:#62798c; margin-top:8rpx; white-space:pre-wrap; word-break:break-all; }.result-row { border-top:1rpx solid #e8eff3; padding-top:18rpx; margin-top:18rpx; }.result-row-heading { display:flex; align-items:flex-start; gap:12rpx; justify-content:space-between; }.result-row-title { flex:1; min-width:0; font-size:27rpx; color:#304d64; font-weight:650; overflow-wrap:anywhere; word-break:break-all; }.result-badge { flex-shrink:0; max-width:45%; border-radius:8rpx; padding:4rpx 10rpx; background:#edf7f7; color:#087580; font-size:22rpx; white-space:pre-wrap; }.result-subtitle,.result-detail { display:block; margin-top:8rpx; font-size:24rpx; line-height:1.8; color:#62798c; white-space:pre-wrap; word-break:break-all; }.result-detail { color:#435f73; }.result-actions { display:flex; flex-wrap:wrap; gap:12rpx; justify-content:flex-end; margin-top:14rpx; }.result-actions button { width:auto; font-size:23rpx; padding:10rpx 14rpx; }
.confirmation-note,.confirmation-hint { display:block; font-size:23rpx; line-height:1.8; margin-top:18rpx; color:#7d663b; }.confirmation-hint { color:#a75a3d; }.assistant-primary { background:#087f8c; color:#fff; }.confirm-registration { margin-top:18rpx; padding:18rpx; font-size:27rpx; }.assistant-working { padding:20rpx 28rpx; font-size:25rpx; color:#62798c; }.assistant-error { margin:18rpx 28rpx; padding:20rpx; background:#fff3df; color:#8a612b; border-radius:16rpx; font-size:24rpx; line-height:1.8; }.assistant-error button { width:auto; margin-top:14rpx; background:#fff; color:#8a612b; }.history-end { height:18rpx; }
.assistant-composer { background:#fff; border-top:1rpx solid #dce7ed; padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); flex-shrink:0; }.composer-row { display:flex; align-items:flex-end; gap:12rpx; min-width:0; }.composer-row textarea { flex:1; width:0; min-width:0; min-height:72rpx; max-height:180rpx; padding:14rpx 18rpx; box-sizing:border-box; background:#f3f7fa; border-radius:16rpx; font-size:26rpx; line-height:1.6; }.send-button { flex:0 0 104rpx; width:104rpx; min-width:104rpx; height:72rpx; line-height:72rpx; padding:0; margin:0; color:#fff; background:#087f8c; font-size:25rpx; box-sizing:border-box; }
.result-actions .query-selected { background:#deefed; color:#24616a; border:1rpx solid #aad1c9; }.query-context-note { display:block; margin:0 2rpx 12rpx; color:#62798c; font-size:22rpx; line-height:1.5; }
@media (max-width:350px) { .assistant-heading,.assistant-message { padding-left:22rpx; padding-right:22rpx; }.assistant-title { font-size:28rpx; }.assistant-welcome { padding-left:22rpx; padding-right:22rpx; }.send-button { flex-basis:100rpx; width:100rpx; min-width:100rpx; } }
