.page {
  padding: 0 0 48rpx;
}

/* ===== 搜索框（沿用 index 页胶囊式） ===== */
.search-bar {
  display: flex;
  align-items: center;
  margin: 20rpx 40rpx 24rpx;
  background: #ffffff;
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
  padding: 6rpx 8rpx 6rpx 22rpx;
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.04);
}
.search-ic { width: 32rpx; height: 32rpx; margin-right: 10rpx; }
.search-input {
  flex: 1;
  background: transparent;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: var(--color-gray-800);
}
.search-clear {
  padding: 8rpx 12rpx;
  display: flex;
  align-items: center;
}
.search-clear-ic { width: 28rpx; height: 28rpx; opacity: 0.45; }

/* ===== 统计概览 ===== */
.stat-bar {
  display: flex;
  gap: 16rpx;
  margin: 0 40rpx 28rpx;
}
.stat {
  flex: 1;
  background: #ffffff;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
}
.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-primary);
  line-height: 1.2;
}
.stat-num.stat-dim { color: var(--color-gray-400); }
.stat-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-gray-500);
  margin-top: 6rpx;
}

/* ===== 队伍卡片 ===== */
.team-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  margin: 0 40rpx 20rpx;
  padding: 24rpx;
  box-shadow: var(--shadow-card);
  transition: transform 0.16s ease, box-shadow 0.16s ease;
}
.team-card:active {
  transform: scale(0.985);
  box-shadow: 0 4rpx 18rpx rgba(8, 145, 178, 0.12);
}

/* 队伍徽章（首字 + 分级角标） */
.tc-avatar {
  position: relative;
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 22rpx;
}
.tc-initial {
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.18);
}
.tc-logo {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
}
.tc-tier {
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 2rpx solid var(--color-border);
  color: #475569;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 28rpx;
  text-align: center;
  box-shadow: 0 2rpx 6rpx rgba(15, 23, 42, 0.10);
}

/* 分级配色 */
.tc-avatar.t-s { background: linear-gradient(135deg, #f59e0b, #f97316); }
.tc-avatar.t-a { background: linear-gradient(135deg, #0891b2, #0e7490); }
.tc-avatar.t-b { background: linear-gradient(135deg, #16a34a, #15803d); }
.tc-avatar.t-c { background: linear-gradient(135deg, #6366f1, #4f46e5); }
.tc-avatar.t-d { background: linear-gradient(135deg, #94a3b8, #64748b); }
.tc-avatar.t-x { background: linear-gradient(135deg, #cbd5e1, #94a3b8); }

/* 卡片右侧信息 */
.tc-body { flex: 1; min-width: 0; }
.tc-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}
.tc-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-gray-900);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tc-meta {
  display: block;
  font-size: 24rpx;
  color: var(--color-gray-500);
  margin-bottom: 14rpx;
}
.tc-foot {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.tc-count {
  font-size: 22rpx;
  color: var(--color-gray-500);
}
.tc-rating {
  font-size: 22rpx;
  color: var(--color-gray-400);
}
.tc-apply {
  margin-left: auto;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-primary);
  background: var(--color-primary-light);
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
  flex-shrink: 0;
}
.tc-apply:active { background: rgba(8, 145, 178, 0.2); }
.tc-arrow {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.3;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* 空状态 */
.empty { padding: 140rpx 40rpx; }
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.empty-ic { width: 100rpx; height: 100rpx; opacity: 0.5; }
.empty-title { font-size: 30rpx; color: var(--color-gray-500); font-weight: 600; }
.empty-sub { font-size: 24rpx; color: var(--color-gray-400); }

/* ===== 详情弹层（roster 面板） ===== */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.detail-panel {
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  width: 100%;
  max-height: 84vh;
  padding: 32rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.dp-header {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}
.dp-avatar {
  position: relative;
  width: 108rpx;
  height: 108rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}
.dp-avatar.t-s { background: linear-gradient(135deg, #f59e0b, #f97316); }
.dp-avatar.t-a { background: linear-gradient(135deg, #0891b2, #0e7490); }
.dp-avatar.t-b { background: linear-gradient(135deg, #16a34a, #15803d); }
.dp-avatar.t-c { background: linear-gradient(135deg, #6366f1, #4f46e5); }
.dp-avatar.t-d { background: linear-gradient(135deg, #94a3b8, #64748b); }
.dp-avatar.t-x { background: linear-gradient(135deg, #cbd5e1, #94a3b8); }
.dp-initial {
  font-size: 52rpx;
  font-weight: 800;
  color: #ffffff;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.18);
}
.dp-logo {
  width: 100%;
  height: 100%;
  border-radius: 28rpx;
}
.dp-title { flex: 1; min-width: 0; }
.dp-name {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-gray-900);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.dp-caption {
  display: block;
  font-size: 26rpx;
  color: var(--color-gray-500);
  margin-top: 6rpx;
}
.dp-close {
  width: 40rpx;
  height: 40rpx;
  padding: 10rpx;
  opacity: 0.5;
  flex-shrink: 0;
}

/* 数据统计 */
.dp-stats {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.dp-stat {
  flex: 1;
  background: var(--color-row);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 20rpx;
  text-align: center;
}
.dp-stat-num {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--color-primary);
  line-height: 1.2;
}
.dp-stat-label {
  display: block;
  font-size: 22rpx;
  color: var(--color-gray-500);
  margin-top: 6rpx;
}

.dp-desc {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--color-gray-600);
  background: var(--color-row);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.dp-section {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-gray-800);
  margin-bottom: 12rpx;
}

/* 成员行 */
.member-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}
.member-row:last-child { border-bottom: none; }
.member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--color-gray-100);
  flex-shrink: 0;
  margin-right: 18rpx;
}
.member-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}
.member-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.member-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-gray-800);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.member-meta {
  font-size: 22rpx;
  color: var(--color-gray-500);
}

.dp-apply {
  margin-top: 28rpx;
}
