page { background: #f3f7fa; color: #102a43; }
.teams-directory { padding: 30rpx 30rpx 48rpx; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.page-heading, .overview-strip, .search-bar, .list-heading, .card-top, .card-metrics, .card-bottom, .detail-identity, .sheet-heading, .roster-heading, .member-row, .member-name-line { display: flex; align-items: center; }
.page-heading { justify-content: space-between; gap: 16rpx; }
.eyebrow, .micro-label { display: block; color: #6e8798; letter-spacing: 3rpx; font-size: 19rpx; font-weight: 600; line-height: 1.5; }
.page-title { display: block; font-size: 44rpx; line-height: 1.35; font-weight: 700; margin-top: 6rpx; letter-spacing: -1rpx; }
.text-link { color: #087f8c; font-size: 23rpx; padding: 18rpx 0 18rpx 12rpx; flex-shrink: 0; }
.text-link text { font-size: 32rpx; margin-left: 10rpx; }
.page-caption { display: block; font-size: 24rpx; color: #8a9fae; margin: 16rpx 0 28rpx; line-height: 1.6; }
.overview-strip { background: #fff; border: 1rpx solid #e2ebf0; border-radius: 26rpx; padding: 24rpx 28rpx; margin-bottom: 24rpx; gap: 28rpx; }
.overview-main { display: flex; align-items: baseline; gap: 11rpx; }
.overview-value { font-size: 44rpx; color: #087f8c; font-weight: 700; line-height: 1.1; }
.overview-unit { color: #8b9fab; font-size: 21rpx; }
.overview-divider { background: #e5edf2; width: 1rpx; height: 46rpx; }
.overview-secondary { display: flex; flex-direction: column; gap: 5rpx; }
.overview-label { font-size: 20rpx; color: #8b9fab; }
.overview-score { font-size: 29rpx; font-weight: 600; color: #486c82; }
.overview-icon { width: 45rpx; height: 45rpx; margin-left: auto; opacity: .27; }
.search-bar { background: #fff; border: 1rpx solid #e2ebf0; border-radius: 22rpx; padding: 0 20rpx; height: 86rpx; gap: 14rpx; box-sizing: border-box; }
.search-icon { width: 30rpx; height: 30rpx; opacity: .5; flex-shrink: 0; }
.search-input { flex: 1; min-width: 0; font-size: 25rpx; height: 84rpx; color: #102a43; }
.search-placeholder { color: #9caebb; }
.search-clear { width: 48rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; }
.search-clear image { width: 26rpx; height: 26rpx; opacity: .45; }
.list-heading { justify-content: space-between; margin: 30rpx 3rpx 20rpx; color: #3b5f78; font-size: 26rpx; font-weight: 600; }
.result-count { margin-left: 12rpx; color: #8fa7b7; font-size: 22rpx; font-weight: 400; }
.sort-caption { color: #92a7b5; font-size: 21rpx; font-weight: 400; }
.team-card { background: #fff; border: 1rpx solid #e2ebf0; border-radius: 28rpx; margin-bottom: 22rpx; padding: 26rpx 28rpx 0; overflow: hidden; }
.team-card:active { border-color: #a7d8d7; }
.card-top { gap: 21rpx; }
.team-emblem { width: 84rpx; height: 84rpx; border-radius: 23rpx; flex-shrink: 0; background: #eff6f8; color: #63899b; display: flex; align-items: center; justify-content: center; overflow: hidden; font-size: 36rpx; font-weight: 700; }
.team-emblem image { width: 100%; height: 100%; }
.tier-s { background: #faf5e9; color: #b88837; }
.tier-a, .tier-b { background: #eaf7f4; color: #087f8c; }
.card-identity { flex: 1; min-width: 0; }
.team-name { display: block; font-size: 32rpx; font-weight: 700; line-height: 1.4; word-break: break-all; }
.captain-meta { display: block; color: #8ba0ae; font-size: 21rpx; margin-top: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.card-chevron { width: 28rpx; height: 28rpx; opacity: .28; flex-shrink: 0; }
.team-description { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 22rpx; color: #91a4b2; margin-top: 18rpx; line-height: 1.6; word-break: break-all; }
.card-metrics { margin: 26rpx 0 24rpx; gap: 23rpx; }
.rating-block { display: flex; align-items: baseline; gap: 10rpx; }
.rating-number { color: #087f8c; font-size: 37rpx; font-weight: 700; line-height: 1.1; }
.rating-label { color: #91a5b3; font-size: 20rpx; }
.rating-tier { display: flex; align-items: baseline; gap: 8rpx; font-size: 25rpx; font-weight: 600; padding-left: 23rpx; border-left: 1rpx solid #e2ebf0; color: #668ba1; }
.rating-tier text { font-size: 19rpx; font-weight: 400; color: #93a7b5; }
.tier-text-s { color: #b88837; }
.tier-text-a, .tier-text-b { color: #087f8c; }
.member-block { margin-left: auto; display: flex; align-items: baseline; gap: 7rpx; flex-shrink: 0; }
.member-number { font-size: 26rpx; font-weight: 600; color: #5d8095; }
.card-bottom { margin: 0 -28rpx; padding: 16rpx 28rpx; background: #fcfdfe; border-top: 1rpx solid #edf2f5; justify-content: space-between; gap: 16rpx; }
.status-pill { display: inline-flex; align-items: center; font-size: 21rpx; color: #a28852; }
.status-approved { color: #6a9a8b; }
.status-rejected { color: #b47672; }
.status-dot { width: 7rpx; height: 7rpx; margin-right: 8rpx; border-radius: 50%; background: currentColor; }
.apply-button { background: #eaf7f5; color: #087f8c; font-size: 23rpx; font-weight: 600; padding: 12rpx 18rpx; border-radius: 12rpx; flex-shrink: 0; }
.apply-button text { margin-left: 14rpx; font-size: 26rpx; }
.apply-button:active { background: #d7f0ed; }
.list-note { display: block; text-align: center; color: #9aacb9; font-size: 19rpx; line-height: 1.7; margin-top: 30rpx; }
.empty-card { padding: 65rpx 30rpx; border: 1rpx solid #e2ebf0; background: #fff; border-radius: 28rpx; text-align: center; }
.empty-symbol { width: 92rpx; height: 92rpx; border-radius: 26rpx; background: #eef7f7; margin: 0 auto 25rpx; display: flex; align-items: center; justify-content: center; }
.empty-symbol image { width: 42rpx; height: 42rpx; opacity: .5; }
.empty-title { display: block; font-size: 29rpx; font-weight: 600; line-height: 1.5; }
.empty-copy { display: block; color: #90a4b2; font-size: 23rpx; margin-top: 13rpx; line-height: 1.7; }
.empty-action { display: inline-block; margin-top: 29rpx; padding: 16rpx 32rpx; border: 1rpx solid #d4ece9; border-radius: 15rpx; background: #eef8f6; color: #087f8c; font-size: 24rpx; }
.sheet-mask { position: fixed; inset: 0; z-index: 1100; background: rgba(16, 42, 67, .34); display: flex; align-items: flex-end; }
.detail-sheet { width: 100%; padding: 16rpx 30rpx 0; padding-bottom: env(safe-area-inset-bottom); box-sizing: border-box; border-radius: 32rpx 32rpx 0 0; background: #fff; }
.sheet-handle { width: 68rpx; height: 7rpx; border-radius: 10rpx; background: #dce6ec; margin: 0 auto 19rpx; }
.sheet-heading { justify-content: space-between; margin-bottom: 20rpx; }
.close-control { width: 62rpx; height: 62rpx; border-radius: 50%; background: #f3f7fa; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.close-control image { width: 29rpx; height: 29rpx; opacity: .5; }
.detail-scroll { height: 60vh; }
.detail-identity { gap: 24rpx; padding: 6rpx 0 26rpx; }
.detail-emblem { width: 112rpx; height: 112rpx; border-radius: 28rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden; font-size: 48rpx; font-weight: 700; background: #edf6f8; color: #5b879c; }
.detail-emblem.tier-s { background: #faf5e9; color: #b88837; }
.detail-emblem.tier-a, .detail-emblem.tier-b { background: #eaf7f4; color: #087f8c; }
.detail-emblem image { width: 100%; height: 100%; }
.detail-copy { min-width: 0; flex: 1; }
.detail-name { display: block; font-size: 38rpx; font-weight: 700; word-break: break-all; line-height: 1.35; }
.detail-copy .status-pill { margin-top: 15rpx; }
.detail-metrics { display: flex; border: 1rpx solid #e6eef2; background: #f7fafb; border-radius: 22rpx; padding: 25rpx 10rpx; }
.detail-metrics > view { flex: 1; text-align: center; border-left: 1rpx solid #e0eaef; min-width: 0; }
.detail-metrics > view:first-child { border-left: none; }
.detail-stat-value { display: block; font-size: 37rpx; font-weight: 700; line-height: 1.2; }
.accent { color: #087f8c; }
.detail-stat-label { display: block; color: #8ea2b0; font-size: 21rpx; margin-top: 10rpx; }
.rating-explainer { display: block; color: #97aab7; font-size: 19rpx; margin: 14rpx 5rpx 0; }
.detail-description { display: block; margin-top: 24rpx; color: #7892a5; font-size: 24rpx; line-height: 1.8; word-break: break-all; }
.roster-heading { justify-content: space-between; margin: 32rpx 0 8rpx; }
.roster-title { font-size: 29rpx; font-weight: 700; }
.roster-caption { font-size: 18rpx; color: #9eb1bf; letter-spacing: 2rpx; }
.member-row { padding: 23rpx 0; gap: 18rpx; border-bottom: 1rpx solid #edf2f5; }
.member-avatar { width: 68rpx; height: 68rpx; border-radius: 20rpx; background: #edf5f8; color: #6d91a3; display: flex; align-items: center; justify-content: center; font-size: 28rpx; flex-shrink: 0; overflow: hidden; }
.member-avatar image { width: 100%; height: 100%; }
.member-copy { min-width: 0; flex: 1; }
.member-name-line { gap: 10rpx; flex-wrap: wrap; }
.member-name { color: #2d526b; font-size: 27rpx; font-weight: 600; line-height: 1.4; word-break: break-all; }
.captain-label { color: #a0814b; border: 1rpx solid #eadcc3; font-size: 17rpx; padding: 1rpx 7rpx; border-radius: 5rpx; }
.member-game { display: block; color: #96a9b7; font-size: 21rpx; margin-top: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.member-rating { text-align: right; flex-shrink: 0; max-width: 150rpx; }
.member-rank { display: block; color: #087f8c; font-size: 25rpx; font-weight: 600; word-break: break-all; }
.member-score { display: block; color: #93a9b7; font-size: 19rpx; margin-top: 7rpx; }
.roster-empty { padding: 40rpx 0; text-align: center; color: #91a7b6; font-size: 24rpx; }
.detail-footer { padding: 24rpx 0 20rpx; border-top: 1rpx solid #e7eef2; }
.detail-apply { background: #087f8c; color: #fff; font-size: 28rpx; font-weight: 600; text-align: center; padding: 22rpx 24rpx; border-radius: 18rpx; }
.detail-footer > text { display: block; text-align: center; font-size: 20rpx; color: #9caebb; margin-top: 15rpx; }
@media (max-width: 350px) { .teams-directory { padding-left: 22rpx; padding-right: 22rpx; } .page-title { font-size: 39rpx; } .team-card { padding-left: 24rpx; padding-right: 24rpx; } .card-bottom { padding-left: 24rpx; padding-right: 24rpx; margin-left: -24rpx; margin-right: -24rpx; } .card-metrics { gap: 16rpx; } .rating-tier { padding-left: 16rpx; } .rating-tier text { display: none; } .overview-strip { gap: 22rpx; } }
