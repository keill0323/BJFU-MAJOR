page{background:#f5f6f2;color:#243c2d}.chat-shell{display:flex;flex-direction:column;overflow:hidden}.room-head{padding:10rpx 30rpx 20rpx;border-bottom:1rpx solid #dce4d9;background:#f5f6f2}.room-title{display:flex;justify-content:space-between;align-items:center;font-size:34rpx;font-weight:700}.room-menu{font-size:44rpx;min-width:70rpx;text-align:right}.room-meta{display:block;font-size:21rpx;color:#6b856e;margin-top:6rpx}.room-rule{display:block;font-size:21rpx;color:#8c927d;margin-top:8rpx}.thread{flex:1;height:0;min-height:0;width:100%}.message{display:flex;flex-direction:column;align-items:flex-start;padding:18rpx 30rpx}.message.mine{align-items:flex-end}.message-time{align-self:center;color:#98a195;font-size:20rpx;margin-bottom:18rpx}.bubble{max-width:82%;padding:22rpx 26rpx;box-sizing:border-box;background:white;border:1rpx solid #e2e7dd;border-radius:6rpx 22rpx 22rpx 22rpx;font-size:29rpx;line-height:1.65;white-space:pre-wrap;word-break:break-all;color:#24382a}.mine .bubble{background:#dcefdc;border-color:#c9e2c7;border-radius:22rpx 6rpx 22rpx 22rpx}.bubble.failed{border-color:#cb8b7e}.message-status{font-size:21rpx;color:#859580;margin-top:10rpx}.message-status.retry{color:#ad4a38;padding:12rpx 0}.removed{align-self:center;font-size:23rpx;color:#939a8e;padding:5rpx}.thread-end{height:24rpx}.composer{display:flex;align-items:flex-end;gap:18rpx;padding:20rpx 24rpx;background:#eff2ec;border-top:1rpx solid #dbe3d6}.composer textarea{flex:1;min-width:0;max-height:200rpx;min-height:45rpx;font-size:28rpx;line-height:1.55;background:white;border-radius:16rpx;padding:17rpx 20rpx}.send{margin:0;padding:0 26rpx;font-size:27rpx;line-height:76rpx;background:#245c38;color:white;border-radius:16rpx}.send[disabled]{background:#d8e0d3;color:#94a08e}.chat-error{padding:16rpx 26rpx;background:#fff1dc;color:#95622c;font-size:24rpx}.chat-state{padding:90rpx 30rpx;text-align:center;font-size:28rpx;color:#8a9986}.chat-state text{display:block;font-size:23rpx;margin-top:18rpx}.history-more{text-align:center;color:#507752;font-size:24rpx;padding:25rpx}.new-message,.card-offer{padding:18rpx 28rpx;font-size:24rpx;text-align:center;color:#32633a;background:#e3eddf}.card-kicker{display:block;font-size:19rpx;color:#6a8868;letter-spacing:2rpx}.card-title{display:block;font-size:30rpx;font-weight:700;margin-top:12rpx}.card-sub{display:block;font-size:25rpx;margin-top:10rpx}.card-link{display:block;font-size:24rpx;margin-top:22rpx;color:#3b7447}
 .room-name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.room-menu{flex-shrink:0}
