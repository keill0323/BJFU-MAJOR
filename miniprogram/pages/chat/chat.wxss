page{background:#f3f7fa;color:#18364e}.chat-shell{display:flex;flex-direction:column;overflow:hidden}.room-head{padding:10rpx 30rpx 20rpx;border-bottom:1rpx solid #d8e6ed;background:#f3f7fa}.room-title{display:flex;justify-content:space-between;align-items:center;font-size:34rpx;font-weight:700}.room-menu{font-size:44rpx;min-width:70rpx;text-align:right}.room-meta{display:block;font-size:21rpx;color:#526d80;margin-top:6rpx}.room-rule{display:block;font-size:21rpx;color:#526d80;margin-top:8rpx}.thread{flex:1;height:0;min-height:0;width:100%}.message{display:flex;flex-direction:column;align-items:flex-start;padding:18rpx 30rpx}.message.mine{align-items:flex-end}.message-time{align-self:center;color:#6b8193;font-size:20rpx;margin-bottom:18rpx}.bubble{max-width:82%;padding:22rpx 26rpx;box-sizing:border-box;background:white;border:1rpx solid #dce7ee;border-radius:6rpx 22rpx 22rpx 22rpx;font-size:29rpx;line-height:1.65;white-space:pre-wrap;word-break:break-all;color:#18364e}.mine .bubble{background:#dcf2ee;border-color:#badfd9;border-radius:22rpx 6rpx 22rpx 22rpx}.bubble.failed{border-color:#cb8b7e}.message-status{font-size:21rpx;color:#647c8d;margin-top:10rpx}.message-status.retry{color:#ad4a38;padding:12rpx 0}.removed{align-self:center;font-size:23rpx;color:#6b8193;padding:5rpx}.thread-end{height:24rpx}.composer{display:flex;align-items:flex-end;gap:18rpx;padding:20rpx 24rpx;background:#edf4f7;border-top:1rpx solid #d6e3ea}.composer textarea{flex:1;min-width:0;max-height:200rpx;min-height:45rpx;font-size:28rpx;line-height:1.55;background:white;border-radius:16rpx;padding:17rpx 20rpx}.send{margin:0;padding:0 26rpx;font-size:27rpx;line-height:76rpx;background:#087f8c;color:white;border-radius:16rpx}.send[disabled]{background:#dce7ec;color:#718a9a}.chat-error{padding:16rpx 26rpx;background:#fff1dc;color:#95622c;font-size:24rpx}.chat-state{padding:90rpx 30rpx;text-align:center;font-size:28rpx;color:#637d8e}.chat-state text{display:block;font-size:23rpx;margin-top:18rpx}.history-more{text-align:center;color:#087580;font-size:24rpx;padding:25rpx}.new-message,.card-offer{padding:18rpx 28rpx;font-size:24rpx;text-align:center;color:#087580;background:#e4f3f1}.card-kicker{display:block;font-size:19rpx;color:#526d80;letter-spacing:2rpx}.card-title{display:block;font-size:30rpx;font-weight:700;margin-top:12rpx}.card-sub{display:block;font-size:25rpx;margin-top:10rpx}.card-link{display:block;font-size:24rpx;margin-top:22rpx;color:#087580}
 .room-name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.room-menu{flex-shrink:0}

.room-rules { display:block; padding:12rpx 0 4rpx; font-size:24rpx; line-height:1.6; color:#526d80; }
.room-meta, .room-rule { font-size:24rpx; line-height:1.6; }
.room-rule { color:#087580; padding:8rpx 0; }
.message { padding-top:10rpx; padding-bottom:10rpx; }
.message-time { font-size:23rpx; margin-top:12rpx; }
.message-status { font-size:24rpx; }
.card-kicker { font-size:23rpx; letter-spacing:1rpx; }
