.page {
  padding: 0 0 40rpx;
}

/* 空状态 */
.empty {
  padding: 140rpx 40rpx;
}
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.empty-ic {
  width: 96rpx;
  height: 96rpx;
  opacity: 0.5;
}
.empty-title {
  font-size: 30rpx;
  color: var(--color-gray-500);
  font-weight: 600;
}
.empty-sub {
  font-size: 24rpx;
  color: var(--color-gray-400);
}

/* 分组标题 */
.group-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.group-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-gray-800);
}
.group-count {
  font-size: 24rpx;
  color: var(--color-gray-400);
}

/* 消息行 */
.msg-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}
.msg-row:last-child {
  border-bottom: none;
}
.msg-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.msg-icon.invite { background: rgba(8, 145, 178, 0.12); }
.msg-icon.rank { background: rgba(245, 158, 11, 0.14); }
.msg-ic { width: 40rpx; height: 40rpx; }
.msg-main {
  flex: 1;
  min-width: 0;
}
.msg-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-gray-800);
}
.msg-sub {
  display: block;
  font-size: 22rpx;
  color: var(--color-gray-500);
  margin-top: 6rpx;
}
.msg-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}
.msg-btn {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}
.msg-btn.accept {
  background: var(--color-primary);
  color: #ffffff;
}
.msg-btn.reject {
  background: rgba(100, 116, 139, 0.12);
  color: var(--color-gray-600);
}
.msg-status {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}
.msg-status.ok { background: rgba(22, 163, 74, 0.12); color: #15803d; }
.msg-status.reject { background: rgba(220, 38, 38, 0.12); color: #b91c1c; }
.msg-status.pending { background: rgba(217, 119, 6, 0.12); color: #b45309; }

/* 冰白消息中心 */
.page { padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }.page-heading { font-size: 38rpx; }
.page > .card { margin: 24rpx 28rpx; border-radius: 28rpx; padding: 28rpx; }
.group-title { margin-bottom: 12rpx; }.group-count { background: #edf3f6; border-radius: 10rpx; padding: 4rpx 14rpx; color: #4c657a; }
.msg-row { flex-wrap: wrap; gap: 16rpx; padding: 28rpx 0; align-items: flex-start; }.msg-icon { width: 64rpx; height: 64rpx; border-radius: 18rpx; }.msg-ic { width: 34rpx; height: 34rpx; }
.msg-main { min-width: 240rpx; }.msg-title { line-height: 1.5; word-break: break-all; }.msg-sub { font-size: 23rpx; line-height: 1.7; word-break: break-all; }
.msg-actions { width: 100%; justify-content: flex-end; }.msg-btn { border-radius: 12rpx; min-width: 88rpx; text-align: center; padding: 14rpx 20rpx; }
.msg-status { margin-left: auto; }.empty-ic { opacity: .65; width: 76rpx; height: 76rpx; }.empty-title { color: #304d64; }.empty-sub { color: #62798c; }
.guest-card { text-align: center; }.guest-card .empty-sub { display: block; margin: 16rpx 0 28rpx; font-size: 24rpx; }.retry-card { display: flex; justify-content: space-between; font-size: 24rpx; color: #62798c; }.retry-card view { color: #087f8c; }
