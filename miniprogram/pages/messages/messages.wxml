<view class="page">
  <nav-drawer title="消息" show-admin-notice="{{true}}"></nav-drawer>
  <view class="page-intro"><text class="page-heading">消息通知</text><text class="page-caption">入队邀请、管理员通知与赛程进展</text></view><view wx:if="{{token}}" class="message-filters"><view class="message-filter {{messageFilter === 'pending' ? 'active' : ''}}" bindtap="switchFilter" data-filter="pending">待处理 {{pendingCount || ''}}</view><view class="message-filter {{messageFilter === 'unread' ? 'active' : ''}}" bindtap="switchFilter" data-filter="unread">未读 {{adminUnread + unreadSchedules || ''}}</view><view class="message-filter {{messageFilter === 'all' ? 'active' : ''}}" bindtap="switchFilter" data-filter="all">全部</view></view>

  <view wx:if="{{!token}}" class="card guest-card"><text class="empty-title">登录后，接收你的参赛消息</text><text class="empty-sub">队伍邀请和审核进展会与你的账号同步</text><view class="btn-primary" bindtap="goLogin">前往登录</view></view>
  <view wx:elif="{{loading}}" class="empty">正在加载消息…</view>
  <view wx:elif="{{loadError}}" class="card retry-card"><text>部分消息暂时未能加载</text><view bindtap="loadMessages">点击重试</view></view>

  <block wx:if="{{token && !loading}}">
    <view wx:if="{{visibleApplications.length || focusedSection === 'applications'}}" class="card" id="notice-applications">
      <view class="group-title"><text class="group-name">入队申请</text><text class="group-count">{{visibleApplications.length}} 条待处理</text></view>
      <text wx:if="{{!visibleApplications.length}}" class="msg-sub">暂无待处理的入队申请。</text><view wx:for="{{visibleApplications}}" wx:key="id" class="application-notice">
        <text class="msg-title">{{item.nickname || '选手'}} 申请加入 {{item.team_name}}</text><view class="applicant-profile"><image wx:if="{{item.avatarFull}}" class="applicant-avatar" src="{{item.avatarFull}}" mode="aspectFill"/><view class="applicant-copy"><text class="applicant-game">游戏 ID：{{item.game_id || '未设置'}}</text><view class="applicant-tags"><text>{{item.displayRank || '段位待认证'}}</text><text>{{item.individual_rating || 0}} 水平分</text><text>{{!item.is_verified ? '学籍待认证' : item.identity === 'new_student' ? '新生 · 已认证' : item.identity === 'senior' ? '老生 · 已认证' : '已认证 · 身份待确认'}}</text></view></view></view><text wx:if="{{item.user_description}}" class="applicant-description">个人介绍：{{item.user_description}}</text>
        <text wx:if="{{item.message}}" class="msg-sub application-message">入队自我介绍：{{item.message}}</text>
        <view class="application-actions"><button class="msg-btn reject" bindtap="handleApplication" data-id="{{item.id}}" data-action="reject">拒绝</button><button class="msg-btn accept" bindtap="handleApplication" data-id="{{item.id}}" data-action="approve">同意入队</button></view>
      </view>
    </view>
    <!-- 入队邀请 -->
    <view wx:if="{{visibleInvitations.length || focusedSection === 'invitations'}}" class="card" id="notice-invitations">
      <view class="group-title">
        <text class="group-name">入队邀请</text>
        <text class="group-count">{{visibleInvitations.length}}</text>
      </view>
      <text wx:if="{{!visibleInvitations.length}}" class="msg-sub">暂无待处理的入队邀请。</text><view wx:for="{{visibleInvitations}}" wx:key="id" class="msg-row">
        <view class="msg-icon invite">
          <image class="msg-ic" src="/images/icons/mail.svg"/>
        </view>
        <view class="msg-main">
          <text class="msg-title">{{item.team_name || '某队伍'}} 邀请你入队</text>
          <text class="msg-sub">队长: {{item.captain_name || '未知'}}{{item.message ? ' · ' + item.message : ''}}</text>
        </view>
        <view class="msg-actions">
          <view class="msg-btn reject" bindtap="rejectInv" data-id="{{item.id}}">忽略</view>
          <view class="msg-btn accept" bindtap="acceptInv" data-id="{{item.id}}">同意</view>
        </view>
      </view>
    </view>

  </block>

  <view wx:if="{{token && messageFilter !== 'pending' && (visibleAdminNotices.length || adminLoading || adminError || adminHasMore || focusedSection === 'admin')}}" class="card admin-inbox-card" id="notice-admin">
    <view class="group-title"><text class="group-name">管理员通知</text><text class="group-count unread-count">{{adminUnread}} 条未读</text></view>
    <text wx:if="{{adminLoading}}" class="msg-sub">正在加载通知…</text>
    <text wx:if="{{!adminLoading && !adminError && !visibleAdminNotices.length}}" class="msg-sub">{{messageFilter === 'unread' ? '当前已加载的通知均已读。' : '暂无管理员通知。'}}</text>
    <view wx:if="{{adminError}}" class="notice-error" bindtap="loadAdminNotices">{{adminError}} · 点击重试</view>
    <view wx:for="{{visibleAdminNotices}}" wx:key="id" class="schedule-notice {{item.is_read ? '' : 'notice-unread'}}" bindtap="openAdminNotice" data-id="{{item.id}}"><view class="notice-heading"><text class="msg-title">{{item.title}}</text><text wx:if="{{!item.is_read}}" class="unread-dot"></text></view><view class="notice-footer"><text>{{item.createdText}}</text><text class="notice-link">{{readingAdminId === item.id ? '正在打开…' : item.is_read ? '查看内容 ›' : '未读 · 查看内容 ›'}}</text></view></view>
    <view wx:if="{{adminHasMore && !adminError}}" class="notice-more" bindtap="loadMoreAdminNotices">{{adminLoadingMore ? '正在加载…' : '查看更多管理员通知'}}</view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{token && !loading && !loadError && !adminLoading && !adminError && visibleCount === 0 && (messageFilter === 'pending' || (!adminHasMore && !hasMoreNotices))}}" class="empty">
    <view class="empty-box">
      <image class="empty-ic" src="/images/icons/mail.svg"/>
      <text class="empty-title">{{messageFilter === 'pending' ? '暂无待处理事项' : messageFilter === 'unread' ? '暂无未读通知' : '暂无消息'}}</text>
      <text class="empty-sub">赛程通知、入队邀请、段位申请会出现在这里</text>
    </view>
  </view>

  <block wx:if="{{token && !loading}}">
    <view wx:if="{{messageFilter !== 'pending' && (visibleScheduleNotices.length || noticeError || hasMoreNotices || focusedSection === 'schedules')}}" class="card schedule-card" id="notice-schedules">
      <view class="group-title"><text class="group-name">赛程通知</text><text class="group-count {{unreadSchedules ? 'unread-count' : ''}}">{{unreadSchedules}} 条未读</text></view>
      <text class="msg-sub">点击通知查看最新对阵与管理员安排的时间；通知中的时间为当时记录。</text>
      <view wx:if="{{noticeError}}" class="notice-error" bindtap="loadMessages">{{noticeError}} · 点击重试</view>
      <text wx:if="{{!visibleScheduleNotices.length && !noticeError}}" class="msg-sub">{{messageFilter === 'unread' ? '当前已加载的赛程通知均已读。' : '暂无赛程通知。'}}</text><view wx:for="{{visibleScheduleNotices}}" wx:key="id" class="schedule-notice {{item.is_read ? '' : 'notice-unread'}}" data-id="{{item.id}}" bindtap="openScheduleNotice">
        <view class="notice-heading"><text class="msg-title">{{item.title}}</text><text wx:if="{{!item.is_read}}" class="unread-dot"></text></view>
        <text class="msg-sub">{{item.match_name}}</text>
        <text class="notice-versus">{{item.team1_name}} vs {{item.team2_name}}</text>
        <text class="notice-time">涉及比赛时间：{{item.timeText}}（北京时间）</text>
        <view class="notice-footer"><text>{{item.createdText}}</text><text class="notice-link">{{openingNotice === item.id ? '正在打开…' : item.round_available ? '查看对阵 ›' : '历史通知'}}</text></view>
      </view>
      <view wx:if="{{hasMoreNotices && !noticeError}}" class="notice-more" bindtap="loadMoreNotices">{{loadingMore ? '正在加载…' : '查看更多赛程通知'}}</view>
    </view>
    <!-- 段位申请 -->
    <view wx:if="{{visibleRanks.length}}" class="card">
      <view class="group-title">
        <text class="group-name">段位申请</text>
        <text class="group-count">{{rankApplications.length}}</text>
      </view>
      <view wx:for="{{visibleRanks}}" wx:key="id" class="msg-row">
        <view class="msg-icon rank">
          <image class="msg-ic" src="/images/icons/trophy.svg"/>
        </view>
        <view class="msg-main">
          <text class="msg-title">申请段位: {{item.ai_rank || '-'}}</text>
          <text class="msg-sub">{{item.reject_reason ? '驳回原因: ' + item.reject_reason : '提交的段位更新申请'}}</text>
        </view>
        <view class="msg-status {{item.statusCls}}">{{item.statusText}}</view>
      </view>
    </view>
  </block>
</view>

<subscribe-notice></subscribe-notice>
