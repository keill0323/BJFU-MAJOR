/**
 * 全局样式与设计令牌（Design Tokens）— 白 + 天蓝青（浅色模式）
 * 参考 shadcn / Tailwind 色彩系统：中性打底 + 单一青色强调 + 独立语义色
 */

/* ===== 设计令牌 ===== */
page {
  /* 品牌色（天蓝青，用于强调/交互） */
  --color-primary: #0891b2;
  --color-primary-dark: #0e7490;
  --color-primary-light: rgba(8, 145, 178, 0.10);

  /* 表面层 */
  --color-ink: #f5f8fb;
  --color-ink-2: #ffffff;
  --color-ink-3: #f1f4f8;

  /* 语义色 */
  --color-success: #16a34a;
  --color-warning: #d97706;
  --color-danger: #dc2626;
  --color-info: #0891b2;

  /* 中性色阶（浅色模式：浅→深） */
  --color-gray-50: #f8fafc;
  --color-gray-100: #f1f5f9;
  --color-gray-200: #e2e8f0;
  --color-gray-300: #cbd5e1;
  --color-gray-400: #94a3b8;
  --color-gray-500: #64748b;
  --color-gray-600: #475569;
  --color-gray-700: #334155;
  --color-gray-800: #0f172a;
  --color-gray-900: #0b1220;

  /* 背景 / 卡片 / 行 */
  --color-bg: #f5f8fb;
  --color-card: #ffffff;
  --color-row: #f1f4f8;
  --color-border: rgba(15, 23, 42, 0.08);

  /* 字号刻度（rpx） */
  --font-xs: 22rpx;
  --font-sm: 24rpx;
  --font-base: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 36rpx;
  --font-2xl: 44rpx;

  /* 间距刻度（8 的倍数） */
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-6: 48rpx;

  /* 圆角 */
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-full: 999rpx;

  /* 阴影（浅色柔和投影） */
  --shadow-card: 0 4rpx 20rpx rgba(15, 23, 42, 0.06);

  /* 全局基础 */
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', sans-serif;
  font-size: var(--font-base);
  color: var(--color-gray-800);
  background: linear-gradient(180deg, #f8fafc 0%, #f5f8fb 45%, #eef2f7 100%);
}

/* ===== 按钮（天蓝青主按钮，按压缩放+光晕） ===== */
.btn-primary {
  background: linear-gradient(135deg, #0891b2, #0e7490);
  color: #ffffff;
  border-radius: var(--radius-md);
  padding: 20rpx;
  text-align: center;
  font-size: var(--font-lg);
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(8, 145, 178, 0.25);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.btn-primary:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 18rpx rgba(8, 145, 178, 0.35);
}

.btn-danger {
  background: rgba(220, 38, 38, 0.08);
  color: #b91c1c;
  border: 1rpx solid rgba(220, 38, 38, 0.25);
  border-radius: var(--radius-md);
  padding: 16rpx 30rpx;
  text-align: center;
  font-size: var(--font-base);
  transition: transform 0.15s ease, background 0.15s ease;
}
.btn-danger:active {
  background: rgba(220, 38, 38, 0.16);
  transform: scale(0.97);
}

.btn-outline {
  border: 2rpx solid var(--color-primary);
  color: var(--color-primary);
  border-radius: var(--radius-md);
  padding: 16rpx 30rpx;
  text-align: center;
  font-size: var(--font-base);
  background: transparent;
  transition: transform 0.15s ease, background 0.15s ease;
}
.btn-outline:active {
  background: var(--color-primary-light);
  transform: scale(0.97);
}

/* ===== 卡片（白色卡片 + 轻投影 + 描边） ===== */
.card {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  margin: 20rpx;
  padding: 24rpx;
  box-shadow: var(--shadow-card);
  border: 1rpx solid var(--color-border);
}

/* ===== 标签（浅底深字） ===== */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-xs);
}
.tag-green  { background: rgba(22, 163, 74, 0.12); color: #15803d; }
.tag-blue   { background: rgba(8, 145, 178, 0.12); color: #0e7490; }
.tag-orange { background: rgba(217, 119, 6, 0.12); color: #b45309; }
.tag-red    { background: rgba(220, 38, 38, 0.12); color: #b91c1c; }
.tag-gray   { background: rgba(100, 116, 139, 0.12); color: #475569; }

/* ===== 输入框 ===== */
.input {
  background: var(--color-gray-100);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 16rpx 20rpx;
  font-size: var(--font-base);
  color: var(--color-gray-800);
}

/* ===== 空状态 ===== */
.empty {
  text-align: center;
  padding: 100rpx 0;
  color: var(--color-gray-400);
}
