/* 北林 MAJOR · 共用设计变量 */
page {
  --color-primary: #087f8c; --color-primary-dark: #076874; --color-primary-light: #e7f5f5;
  --color-accent: #09b4b0; --color-navy: #102a43; --color-gold: #b88837;
  --color-ink: #f3f7fa; --color-ink-2: #fff; --color-ink-3: #edf3f6;
  --color-success: #18825e; --color-warning: #a76519; --color-danger: #c34545; --color-info: #087f8c;
  --color-gray-50: #f7fafb; --color-gray-100: #edf3f6; --color-gray-200: #e2ebf0;
  --color-gray-300: #c5d4de; --color-gray-400: #8193a3; --color-gray-500: #62798c;
  --color-gray-600: #4c657a; --color-gray-700: #304d64; --color-gray-800: #18364e; --color-gray-900: #102a43;
  --color-bg: #f3f7fa; --color-card: #fff; --color-row: #edf3f6; --color-border: #e2ebf0;
  --font-xs: 22rpx; --font-sm: 24rpx; --font-base: 28rpx; --font-lg: 32rpx; --font-xl: 36rpx; --font-2xl: 44rpx;
  --space-1: 8rpx; --space-2: 16rpx; --space-3: 24rpx; --space-4: 32rpx; --space-6: 48rpx;
  --radius-sm: 10rpx; --radius-md: 20rpx; --radius-lg: 28rpx; --radius-full: 999rpx;
  --shadow-card: 0 6rpx 20rpx rgba(16,42,67,.035);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: var(--font-base); line-height: 1.5; color: var(--color-gray-800); background: var(--color-bg);
}
.btn-primary, .btn-outline, .btn-danger { box-sizing: border-box; line-height: 1.5; font-weight: 600; border-radius: var(--radius-md); text-align: center; }
.btn-primary { background: #087f8c; color: #fff; padding: 22rpx 28rpx; font-size: 30rpx; box-shadow: 0 6rpx 16rpx rgba(8,127,140,.12); }
.btn-primary:active { background: #076874; }
.btn-outline { border: 1rpx solid #badbdf; background: #f5fbfb; color: #087f8c; padding: 18rpx 28rpx; font-size: 28rpx; }
.btn-outline:active { background: #e7f5f5; }
.btn-danger { border: 1rpx solid #f0d9d9; background: #fff5f4; color: #b43e3e; padding: 18rpx 28rpx; font-size: 28rpx; }
.btn-danger:active { background: #fce8e7; }
.btn-primary::after, .btn-outline::after, .btn-danger::after { border: none; }
.card { background: var(--color-card); border: 1rpx solid var(--color-border); border-radius: var(--radius-lg); margin: 24rpx; padding: 28rpx; box-shadow: var(--shadow-card); }
.tag { display: inline-block; padding: 5rpx 14rpx; border-radius: 10rpx; font-size: 22rpx; line-height: 1.5; }
.tag-green { background: #e8f5ed; color: #18734f; }.tag-blue { background: #e7f5f5; color: #087782; }.tag-orange { background: #fbf1e4; color: #985b15; }.tag-red { background: #fceceb; color: #b43e3e; }.tag-gray { background: #edf2f5; color: #536c80; }
.input { background: #f7fafb; border: 1rpx solid var(--color-border); border-radius: 18rpx; padding: 20rpx; font-size: 28rpx; color: #18364e; }
.empty { padding: 96rpx 24rpx; text-align: center; color: #62798c; }
.page-intro { padding: 36rpx 32rpx 12rpx; }.page-eyebrow { display: block; color: #087f8c; font-size: 20rpx; font-weight: 700; letter-spacing: 3rpx; }.page-heading { display: block; margin-top: 8rpx; color: #102a43; font-size: 42rpx; font-weight: 800; }.page-caption { display: block; margin-top: 10rpx; color: #62798c; font-size: 25rpx; line-height: 1.7; }
