.chat-entry{display:flex;align-items:center;gap:16rpx;margin:16rpx 0 12rpx;padding:18rpx 22rpx;background:#e7f5f5;border:1rpx solid #c1dedf;border-radius:20rpx}.chat-symbol{width:54rpx;height:54rpx;border-radius:14rpx;background:#d4eded;display:flex;align-items:center;justify-content:center}.chat-symbol image{width:40rpx;height:40rpx}.chat-entry-copy{flex:1;min-width:0}.chat-entry-title{display:block;font-size:28rpx;font-weight:700;color:#102a43}.chat-entry-sub{display:block;margin-top:2rpx;font-size:23rpx;color:#4c657a}.chat-entry-badge{background:#b23f35;color:white;border-radius:30rpx;min-width:38rpx;padding:4rpx 10rpx;text-align:center;font-size:23rpx}.chat-entry-arrow{font-size:36rpx;color:#087f8c}
