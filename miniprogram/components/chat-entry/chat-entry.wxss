.chat-entry{display:flex;align-items:center;gap:22rpx;margin:24rpx 0;padding:26rpx 28rpx;background:#eaf4ed;border:1rpx solid #cadfd0;border-radius:24rpx}.chat-symbol{width:76rpx;height:76rpx;border-radius:22rpx;background:#d6e8dc;display:flex;align-items:center;justify-content:center}.chat-symbol image{width:40rpx;height:40rpx}.chat-entry-copy{flex:1;min-width:0}.chat-entry-title{display:block;font-size:32rpx;font-weight:700;color:#183f2a}.chat-entry-sub{display:block;margin-top:7rpx;font-size:23rpx;color:#607868}.chat-entry-badge{background:#b23f35;color:white;border-radius:30rpx;min-width:38rpx;padding:4rpx 10rpx;text-align:center;font-size:23rpx}.chat-entry-arrow{font-size:36rpx;color:#24663c}
