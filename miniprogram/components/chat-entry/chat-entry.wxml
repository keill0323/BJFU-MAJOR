<view class="chat-entry" bindtap="open" aria-role="button" aria-label="打开赛事沟通">
  <view class="chat-symbol"><image src="/images/brand/mail.svg" mode="aspectFit"/></view>
  <view class="chat-entry-copy"><text class="chat-entry-title">赛事沟通</text><text class="chat-entry-sub">报名咨询 · 队伍联络 · 赛程确认</text></view>
  <text wx:if="{{unread > 0}}" class="chat-entry-badge">{{unread > 99 ? '99+' : unread}}</text><text class="chat-entry-arrow">↗</text>
</view>
