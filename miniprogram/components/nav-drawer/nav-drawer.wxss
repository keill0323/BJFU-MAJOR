.topbar { background: #f3f7fa; }
.topbar-inner { box-sizing: border-box; display: flex; align-items: center; padding-left: 22rpx; }
.menu-button { position: relative; width: 64rpx; height: 72rpx; display: flex; flex-direction: column; justify-content: center; flex-shrink: 0; gap: 10rpx; margin-right: 14rpx; }
.menu-button view { width: 32rpx; height: 3rpx; background: #102a43; border-radius: 4rpx; margin-left: 10rpx; }.menu-button view:nth-child(2) { width: 22rpx; }
.menu-dot { position: absolute; right: 6rpx; top: 10rpx; width: 13rpx; height: 13rpx; border-radius: 50%; background: #c33d38; border: 3rpx solid #f3f7fa; }
.admin-notice { margin: 20rpx 28rpx 0; padding: 24rpx; background: #fff8ed; border: 1rpx solid #eed9b7; border-radius: 18rpx; }
.admin-notice-copy { flex: 1; min-width: 0; }.admin-notice-heading { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; font-size: 25rpx; font-weight: 700; color: #49371d; }
.admin-count { padding: 3rpx 10rpx; border-radius: 8rpx; color: #a1352d; background: #fce6df; font-size: 21rpx; font-weight: 600; }
.admin-notice-sub { display: block; margin-top: 12rpx; font-size: 25rpx; line-height: 1.6; color: #705839; word-break: break-all; }
.admin-notice-action { display: flex; align-items: center; min-height: 80rpx; font-size: 25rpx; color: #087782; font-weight: 600; }
.admin-notice-actions { display: flex; justify-content: space-between; gap: 16rpx; }
.admin-task-list { margin-top: 14rpx; }
.admin-task { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 84rpx; border-top: 1rpx solid #e8d9c4; }
.admin-task-title { flex: 1; font-size: 28rpx; font-weight: 600; color: #49371d; }
.admin-task-action { flex-shrink: 0; font-size: 25rpx; color: #087782; }
.admin-notice-unavailable { background: #eef4f8; border-color: #d6e2eb; }
.admin-notice-unavailable .admin-notice-heading, .admin-notice-unavailable .admin-notice-sub { color: #4c657a; }
.drawer-todo-badge { margin-left: auto; padding: 3rpx 12rpx; background: #b53732; color: #fff; font-size: 21rpx; border-radius: 20rpx; }
.drawer-status-unknown { background: #e8eff4; color: #526b7e; }
.topbar-copy { min-width: 0; }.topbar-title { display: block; color: #102a43; font-size: 30rpx; line-height: 1.3; font-weight: 750; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }.topbar-subtitle { display: block; font-size: 16rpx; letter-spacing: 1rpx; color: #62798c; margin-top: 4rpx; }
.topbar-return { display: flex; align-items: center; flex-shrink: 0; gap: 6rpx; height: 36px; margin: 0 18rpx 0 0; padding: 0 4rpx; border: 0; border-radius: 10rpx; background: transparent; color: #087f8c; font-size: 13px; line-height: 1; font-weight: 600; }
.topbar-return::after { border: 0; }.topbar-return-arrow { font-size: 24px; line-height: 1; font-weight: 400; }.topbar-return-pressed { background: #e7f2f4; }
.topbar-secondary .topbar-copy { flex: 1; padding-left: 18rpx; border-left: 1rpx solid #d6e2e9; }.topbar-secondary .topbar-title { font-size: 28rpx; }
.topbar-secondary .menu-button { width: 52rpx; height: 40px; margin: 0 0 0 8rpx; }.topbar-secondary .menu-button view { margin-left: 10rpx; }
.drawer-mask { position: fixed; inset: 0; background: rgba(12,31,48,.4); z-index: 999; }
.drawer { position: fixed; top: 0; bottom: 0; left: 0; width: 78%; max-width: 640rpx; background: #fff; z-index: 1000; display: flex; flex-direction: column; transform: translateX(-105%); transition: transform .22s ease; }
.drawer-open { transform: translateX(0); box-shadow: 12rpx 0 50rpx rgba(16,42,67,.12); }
.drawer-head { padding: 40rpx 36rpx 32rpx; background: #102f45; color: #fff; }
.drawer-brand { display: flex; justify-content: space-between; align-items: center; font-size: 20rpx; letter-spacing: 3rpx; color: #a4d6d8; margin-bottom: 24rpx; }.drawer-close { font-size: 42rpx; line-height: 1; padding: 8rpx 0 8rpx 24rpx; color: #c5e0e6; }
.drawer-avatar { display: block; width: 96rpx; height: 96rpx; border-radius: 24rpx; background: #235768; margin-bottom: 20rpx; border: 1rpx solid #50838c; }.drawer-placeholder { display: flex; align-items: center; justify-content: center; }.drawer-placeholder image { width: 64rpx; height: 64rpx; }
.drawer-name { display: block; font-size: 32rpx; font-weight: 700; word-break: break-all; }.drawer-sub { display: block; font-size: 22rpx; color: #a9c9d4; margin-top: 10rpx; }
.drawer-body { flex: 1; min-height: 0; height: 0; }.drawer-section { padding: 30rpx 36rpx 14rpx; font-size: 20rpx; color: #8193a3; letter-spacing: 2rpx; }
.drawer-item { display: flex; align-items: center; margin: 0 20rpx 4rpx; padding: 22rpx 18rpx; border-radius: 16rpx; color: #304d64; font-size: 28rpx; }.drawer-item image { width: 34rpx; height: 34rpx; margin-right: 22rpx; flex-shrink: 0; }.drawer-item.selected { background: #e7f5f5; color: #087f8c; font-weight: 650; }.drawer-item:active { background: #f0f6f8; }.drawer-arrow { margin-left: auto; color: #8193a3; }.account-action { justify-content: space-between; border-top: 1rpx solid #e2ebf0; border-radius: 0; margin-top: 16rpx; color: #087f8c; }.danger { color: #b43e3e; }.drawer-footer { display: block; padding: 20rpx 36rpx calc(36rpx + env(safe-area-inset-bottom)); font-size: 20rpx; color: #8193a3; letter-spacing: 4rpx; }
