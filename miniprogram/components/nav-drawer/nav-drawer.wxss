/* 顶部栏（自定义导航） */
.topbar {
  background: #ffffff;
  border-bottom: 1rpx solid var(--color-border);
}
.topbar-inner {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
}
.avatar-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}
.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
.topbar-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-gray-900);
}
.topbar-capsule {
  width: 64rpx;
  flex-shrink: 0;
}

/* 遮罩 */
.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 999;
}

/* 抽屉 */
.drawer {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  width: 72%;
  background: #ffffff;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  transform: translateX(-100%);
  transition: transform 0.25s ease;
  box-shadow: 4rpx 0 40rpx rgba(15, 23, 42, 0.12);
}
.drawer.drawer-open {
  transform: translateX(0);
}
.drawer-head {
  padding: 40rpx 32rpx 28rpx;
  background: linear-gradient(135deg, #e6f4f6, #ffffff);
  border-bottom: 1rpx solid var(--color-border);
}
.drawer-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-bottom: 16rpx;
}
.drawer-name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-gray-900);
}
.drawer-sub {
  display: block;
  font-size: 24rpx;
  color: var(--color-gray-500);
  margin-top: 8rpx;
}
.drawer-body {
  flex: 1;
}
.drawer-section {
  padding: 24rpx 32rpx 12rpx;
  font-size: 22rpx;
  color: var(--color-gray-400);
  font-weight: 600;
  letter-spacing: 2rpx;
}
.drawer-item {
  padding: 26rpx 32rpx;
  font-size: 30rpx;
  color: var(--color-gray-800);
  border-bottom: 1rpx solid #f1f5f9;
}
.drawer-item:active {
  background: #f8fafc;
}
.drawer-item.danger {
  color: var(--color-danger);
}
